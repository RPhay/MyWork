{
  "name": "mywork",
  "version": "1.0.0",
  "description": "A personal work management application with task tracking, goals, and priorities",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node scripts/initDatabase.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "keywords": [
    "work",
    "management",
    "tasks",
    "goals",
    "priorities"
  ],
  "author": "Ryan Phay",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.0",
    "express-session": "^1.17.0",
    "csurf": "^1.11.0",
    "express-rate-limit": "^7.1.0",
    "ejs": "^3.1.9",
    "mysql2": "^3.6.0",
    "mssql": "^9.1.0",
    "csv-writer": "^1.6.0",
    "exceljs": "^4.3.0",
    "pdfkit": "^0.13.0",
    "dotenv": "^16.3.0",
    "helmet": "^7.1.0",
    "express-validator": "^7.0.0",
    "uuid": "^9.0.1",
    "date-fns": "^2.30.0",
    "morgan": "^1.10.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "jest": "^29.0.0",
    "supertest": "^6.3.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
