<% if (typeof flash !== 'undefined' && flash) { %>
  <% if (flash.error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= flash.error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (flash.success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= flash.success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (flash.info) { %>
    <div class="alert alert-info alert-dismissible fade show" role="alert">
      <%= flash.info %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
<% } %>

<%# Shown when nobody has chosen a profile yet - a fresh install, or after the
    chosen one was deleted. Static backdrop: at this point the app is already
    showing SOMEBODY'S data (getActiveContextId falls back), so dismissing it
    without choosing would leave that unnoticed, which is the one thing the
    profile picker exists to prevent. %>
<div class="modal fade" id="userPickerModal" tabindex="-1" aria-labelledby="userPickerTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="userPickerTitle"><i class="bi bi-person-circle me-2"></i>Who's using MyWork?</h5>
      </div>
      <div class="modal-body">
        <p class="text-muted small mb-3">Choose a profile to see its contexts and records. You can switch any time from the navbar.</p>
        <div class="list-group" id="userPickerList"></div>
      </div>
    </div>
  </div>
</div>
