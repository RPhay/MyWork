<div class="row">
  <div class="col-md-12">
    <h4>Data Sources</h4>
    <p class="text-muted">Configure and manage your data sources for importing data</p>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-12 text-end">
    <button class="btn btn-primary" id="addSourceBtn" data-bs-toggle="modal" data-bs-target="#sourceTypeModal">
      + Add Data Source
    </button>
  </div>
</div>

<div class="row">
  <div class="col-md-12">
    <div class="table-responsive">
      <table class="table table-hover">
        <thead class="table-light">
          <tr>
            <th>Name</th>
            <th>Provider</th>
            <th>Auth Type</th>
            <th>Status</th>
            <th>Enabled</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="sourcesTableBody">
          <tr>
            <td colspan="6" class="text-center text-muted">No data sources configured</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Step 1: Provider Type Selection Modal -->
<div class="modal fade" id="sourceTypeModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Choose Data Source Provider</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="text-muted mb-4">Select which service you'd like to connect:</p>

        <div class="row gap-3">
          <div class="col-md-6">
            <button class="btn btn-outline-primary w-100 h-100 py-4" onclick="selectSourceType('teams')" style="text-align: left;">
              <div style="font-weight: 600; margin-bottom: 8px;">
                <i class="bi bi-microsoft-teams"></i> Microsoft Teams
              </div>
              <small class="text-muted">Import team messages, members, channels</small>
            </button>
          </div>
          <div class="col-md-6">
            <button class="btn btn-outline-primary w-100 h-100 py-4" onclick="selectSourceType('outlook')" style="text-align: left;">
              <div style="font-weight: 600; margin-bottom: 8px;">
                <i class="bi bi-envelope"></i> Microsoft Outlook
              </div>
              <small class="text-muted">Import emails and calendar events</small>
            </button>
          </div>
        </div>

        <div class="row gap-3 mt-3">
          <div class="col-md-6">
            <button class="btn btn-outline-primary w-100 h-100 py-4" onclick="selectSourceType('azure-devops')" style="text-align: left;">
              <div style="font-weight: 600; margin-bottom: 8px;">
                <i class="bi bi-diagram-3"></i> Azure DevOps
              </div>
              <small class="text-muted">Import work items, PRs, commits</small>
            </button>
          </div>
          <div class="col-md-6">
            <button class="btn btn-outline-primary w-100 h-100 py-4" onclick="selectSourceType('github-enterprise')" style="text-align: left;">
              <div style="font-weight: 600; margin-bottom: 8px;">
                <i class="bi bi-github"></i> GitHub Enterprise
              </div>
              <small class="text-muted">Import repos, issues, PRs</small>
            </button>
          </div>
        </div>

        <div class="row gap-3 mt-3">
          <div class="col-md-6">
            <button class="btn btn-outline-primary w-100 h-100 py-4" onclick="selectSourceType('servicenow')" style="text-align: left;">
              <div style="font-weight: 600; margin-bottom: 8px;">
                <i class="bi bi-ticket"></i> ServiceNow
              </div>
              <small class="text-muted">Import incidents, tickets, changes</small>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Step 2: Auth Method Selection Modal -->
<div class="modal fade" id="sourceAuthModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="authModalTitle">How would you like to authenticate?</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="text-muted mb-4">Choose your authentication method:</p>

        <button type="button" class="btn btn-outline-success w-100 mb-3 py-3" onclick="selectAuthMethod('sso')" style="text-align: left;">
          <div style="font-weight: 600;">
            <i class="bi bi-shield-check"></i> Single Sign-On (SSO)
          </div>
          <small class="text-muted">Use your organization account (recommended)</small>
        </button>

        <button type="button" class="btn btn-outline-secondary w-100 py-3" onclick="selectAuthMethod('credentials')" style="text-align: left;">
          <div style="font-weight: 600;">
            <i class="bi bi-key"></i> Credentials
          </div>
          <small class="text-muted">Enter username/password or API token</small>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Step 3: Configuration Form Modal -->
<div class="modal fade" id="sourceConfigModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Configure Data Source</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="sourceForm">
          <input type="hidden" id="sourceId" name="sourceId">
          <input type="hidden" id="sourceType" name="type">
          <input type="hidden" id="authMethod" name="authMethod">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="mb-3">
            <label for="sourceName" class="form-label">Source Name *</label>
            <input type="text" class="form-control" id="sourceName" name="name" placeholder="e.g., 'My Teams', 'Work Outlook'" required>
            <small class="text-muted">A friendly name for this data source</small>
          </div>

          <div id="sourceConfigFields">
            <!-- Dynamic configuration fields will be added here -->
          </div>

          <div class="mb-3 form-check">
            <input type="checkbox" class="form-check-input" id="sourceEnabled" name="enabled" checked>
            <label class="form-check-label" for="sourceEnabled">
              Enabled
            </label>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="testSourceBtn">Test Connection</button>
        <button type="button" class="btn btn-success" id="saveSourceBtn">Save Source</button>
      </div>
    </div>
  </div>
</div>

<script src="/js/sources.js"></script>

<style>
.btn-outline-primary:hover {
  background-color: #f0f6ff;
  border-color: #0d6efd;
}

.btn-outline-success:hover {
  background-color: #f0fff4;
  border-color: #198754;
}

.btn-outline-secondary:hover {
  background-color: #f5f5f5;
  border-color: #6c757d;
}

@media (prefers-color-scheme: dark) {
  .btn-outline-primary:hover {
    background-color: #1a3a52;
  }
  .btn-outline-success:hover {
    background-color: #1a3a2a;
  }
  .btn-outline-secondary:hover {
    background-color: #3a3a3a;
  }
}
</style>

