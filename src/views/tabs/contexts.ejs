<div class="row">
  <div class="col-md-12">
    <h4>Contexts</h4>
    <p class="text-muted">Define top-level contexts (e.g. Work, Life, Hobbies, Family) for scoping the app to one at a time.</p>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-12 text-end">
    <button class="btn btn-primary" id="addContextBtn" data-bs-toggle="modal" data-bs-target="#contextModal">
      + Add Context
    </button>
  </div>
</div>

<div class="row">
  <div class="col-md-12">
    <div class="table-responsive">
      <table class="table table-hover">
        <thead class="table-light">
          <tr>
            <th>Name</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="contextsTableBody">
          <tr>
            <td colspan="2" class="text-center text-muted">No contexts configured</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Context Modal -->
<div class="modal fade" id="contextModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Context Form</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="contextForm">
          <input type="hidden" id="contextId" name="contextId">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="mb-3">
            <label for="contextName" class="form-label">Name *</label>
            <input type="text" class="form-control" id="contextName" name="name" required>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="saveContextBtn">Save Context</button>
      </div>
    </div>
  </div>
</div>

<script src="/js/contexts.js"></script>
