<div class="row mb-3">
  <div class="col-md-12">
    <h4>Contexts</h4>
    <p class="text-muted">Define top-level contexts (e.g. Work, Life, Hobbies) and configure each one's database, data sources, backup, and which tabs it shows.</p>
  </div>
</div>

<div class="row">
  <!-- Left: context list -->
  <div class="col-md-4 contexts-left-pane">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h6 class="mb-0">Contexts</h6>
      <button class="btn btn-sm btn-primary" id="addContextBtn" data-bs-toggle="modal" data-bs-target="#contextModal">
        + Add
      </button>
    </div>
    <p class="text-muted small">Click a context to configure it on the right. Drag to reorder.</p>
    <div id="contextsList"></div>
  </div>

  <!-- Right: tabbed panel for whichever context is selected -->
  <div class="col-md-8">
    <div id="contextPanelEmpty" class="text-center text-muted mt-5">
      <p>Select a context on the left to configure it.</p>
    </div>

    <div id="contextPanel" class="d-none">
      <h5 id="contextPanelTitle" class="mb-3"></h5>

      <ul class="nav nav-tabs mb-3" id="contextSubTabs">
        <li class="nav-item" data-subtab="tabs" draggable="true">
          <button class="nav-link active" data-subtab="tabs" type="button">Tabs</button>
        </li>
        <li class="nav-item" data-subtab="database" draggable="true">
          <button class="nav-link" data-subtab="database" type="button">Database</button>
        </li>
        <li class="nav-item" data-subtab="sources" draggable="true">
          <button class="nav-link" data-subtab="sources" type="button">Data Sources</button>
        </li>
        <li class="nav-item" data-subtab="backup" draggable="true">
          <button class="nav-link" data-subtab="backup" type="button">Backup &amp; Restore</button>
        </li>
      </ul>

      <!-- Tabs sub-panel: which main-app tabs show for this context -->
      <div class="context-subtab-pane" data-subtab-pane="tabs">
        <p class="text-muted small">Dailies always shows first and can't be hidden. Reorder the rest by dragging them directly on the main tab bar - this just controls which ones show for this context.</p>
        <div id="contextTabsList"></div>
      </div>

      <!-- Database sub-panel: this context's own DB connection(s) -->
      <div class="context-subtab-pane d-none" data-subtab-pane="database">
        <p class="text-muted small">
          This context's own database connection. Contexts can point at different databases entirely -
          switching to this context in the navbar switches the live connection to whatever's saved as its
          MySQL/MariaDB profile below.
        </p>

        <div class="btn-group mb-3" role="group" aria-label="Database type">
          <input type="radio" class="btn-check" name="contextDbType" id="contextDbTypeMysql" value="mysql" autocomplete="off" checked>
          <label class="btn btn-outline-secondary btn-sm" for="contextDbTypeMysql">MySQL / MariaDB</label>

          <input type="radio" class="btn-check" name="contextDbType" id="contextDbTypeMssql" value="mssql" autocomplete="off">
          <label class="btn btn-outline-secondary btn-sm" for="contextDbTypeMssql">MSSQL</label>
        </div>

        <div id="contextMssqlNotice" class="alert alert-warning py-2 px-3 small d-none">
          <i class="bi bi-exclamation-triangle"></i>
          MSSQL isn't yet a supported live backend - not ready for prime time. You can save, test, and
          create the schema here, but this context will keep querying through its MySQL/MariaDB profile
          regardless of this toggle.
        </div>

        <form id="contextDbForm">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div data-db-fields="mysql">
            <div class="row g-2">
              <div class="col-md-8">
                <label for="contextDbHostMysql" class="form-label">Host *</label>
                <input type="text" class="form-control" id="contextDbHostMysql" placeholder="localhost">
              </div>
              <div class="col-md-4">
                <label for="contextDbPortMysql" class="form-label">Port</label>
                <input type="number" class="form-control" id="contextDbPortMysql" placeholder="3306">
              </div>
            </div>
            <div class="mb-2 mt-2">
              <label for="contextDbNameMysql" class="form-label">Database Name</label>
              <input type="text" class="form-control" id="contextDbNameMysql">
            </div>
            <div class="mb-2">
              <label for="contextDbUserMysql" class="form-label">User *</label>
              <input type="text" class="form-control" id="contextDbUserMysql">
            </div>
            <div class="mb-2">
              <label for="contextDbPasswordMysql" class="form-label">Password</label>
              <input type="password" class="form-control" id="contextDbPasswordMysql" autocomplete="new-password">
            </div>
          </div>

          <div data-db-fields="mssql" class="d-none">
            <div class="row g-2">
              <div class="col-md-8">
                <label for="contextDbHostMssql" class="form-label">Host *</label>
                <input type="text" class="form-control" id="contextDbHostMssql" placeholder="localhost">
              </div>
              <div class="col-md-4">
                <label for="contextDbPortMssql" class="form-label">Port</label>
                <input type="number" class="form-control" id="contextDbPortMssql" placeholder="1433">
              </div>
            </div>
            <div class="mb-2 mt-2">
              <label for="contextDbNameMssql" class="form-label">Database Name</label>
              <input type="text" class="form-control" id="contextDbNameMssql">
            </div>
            <div class="mb-2">
              <label for="contextDbUserMssql" class="form-label">User *</label>
              <input type="text" class="form-control" id="contextDbUserMssql">
            </div>
            <div class="mb-2">
              <label for="contextDbPasswordMssql" class="form-label">Password</label>
              <input type="password" class="form-control" id="contextDbPasswordMssql" autocomplete="new-password">
            </div>
          </div>

          <div class="d-flex align-items-center gap-2 mt-2">
            <button type="button" class="btn btn-primary btn-sm" id="saveContextDbBtn" disabled>Save</button>
            <span id="contextDbStatus" class="small"></span>
          </div>
        </form>
      </div>

      <!-- Data Sources sub-panel: reuses the existing Data Sources feature as-is,
           which already operates on the active context -->
      <div class="context-subtab-pane d-none" data-subtab-pane="sources">
        <p class="text-muted small">Shows data sources for whichever context is currently <strong>active</strong> (top-right switcher), not necessarily the one selected on the left.</p>
        <%- include('./data-sources.ejs') %>
      </div>

      <!-- Backup & Restore sub-panel: reuses the existing feature as-is, which
           already operates on the active context's database -->
      <div class="context-subtab-pane d-none" data-subtab-pane="backup">
        <p class="text-muted small">Exports/imports whichever context is currently <strong>active</strong> (top-right switcher), not necessarily the one selected on the left.</p>
        <%- include('./backup.ejs') %>
      </div>
    </div>
  </div>
</div>

<!-- Context Modal (create new) -->
<div class="modal fade" id="contextModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">New Context</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="contextForm">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label for="contextName" class="form-label">Name *</label>
            <input type="text" class="form-control" id="contextName" name="name" required>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="saveContextBtn">Create</button>
      </div>
    </div>
  </div>
</div>

<style>
  .context-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    margin-bottom: 6px;
    cursor: pointer;
  }

  .context-row:hover {
    background: #f8f9fa;
  }

  .context-row.selected {
    background: #e7f3ff;
    border-color: #007bff;
  }

  .context-row-title {
    flex: 1;
    font-weight: 500;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .context-row-actions {
    display: flex;
    gap: 4px;
  }

  .context-tab-visibility-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    margin-bottom: 6px;
  }
</style>

<script src="/js/contexts.js"></script>
