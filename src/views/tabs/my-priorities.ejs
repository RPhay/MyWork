<div class="drawer-layout" style="display: flex; gap: 0; height: 70vh; position: relative;">
  <!-- Vertical Tab (far left, always on top) -->
  <div class="drawer-tab" style="width: 30px; background: #f8f9fa; border-right: 1px solid #dee2e6; display: flex; align-items: center; justify-content: center; position: relative; z-index: 20;">
    <button class="drawer-toggle" id="associateItemsToggle" style="background: none; border: none; cursor: pointer; padding: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; flex-direction: column;">
      <span style="writing-mode: vertical-rl; text-orientation: mixed; transform: rotate(180deg); font-size: 11px; font-weight: 500; white-space: nowrap; color: #666; user-select: none;">Associate Items</span>
    </button>
  </div>

  <!-- Drawer Panel (Associate Items) - pushes content right -->
  <div class="drawer-panel" id="associateItemsPanel" style="width: 0; background: white; border-right: 1px solid #dee2e6; overflow: hidden; padding: 0; transition: width 0.3s ease; overflow-y: auto;" data-drawer-open="false">
      <div style="margin-bottom: 15px;">
        <h6 class="mb-3">Associate Items</h6>

        <!-- Categories Folder -->
        <div class="associate-folder mb-2">
          <div class="associate-folder-header" data-folder="categories" style="cursor: pointer; display: flex; align-items: center; gap: 6px; padding: 6px; border-radius: 3px; user-select: none;">
            <i class="bi bi-chevron-right associate-folder-toggle" style="font-size: 12px; transition: transform 0.2s; flex: none;"></i>
            <i class="bi bi-folder" style="font-size: 14px;"></i>
            <span style="font-size: 13px; font-weight: 500;">Categories</span>
          </div>
          <div id="projCategoriesListRight" class="associate-folder-content small" data-folder="categories" style="display: none; padding-left: 24px; margin-top: 4px;">
            <small class="text-muted">No categories</small>
          </div>
        </div>

        <!-- Goals Folder -->
        <div class="associate-folder mb-2">
          <div class="associate-folder-header" data-folder="goals" style="cursor: pointer; display: flex; align-items: center; gap: 6px; padding: 6px; border-radius: 3px; user-select: none;">
            <i class="bi bi-chevron-right associate-folder-toggle" style="font-size: 12px; transition: transform 0.2s; flex: none;"></i>
            <i class="bi bi-flag" style="font-size: 14px;"></i>
            <span style="font-size: 13px; font-weight: 500;">Goals</span>
          </div>
          <div id="projGoalsListRight" class="associate-folder-content small" data-folder="goals" style="display: none; padding-left: 24px; margin-top: 4px;">
            <small class="text-muted">No goals</small>
          </div>
        </div>

        <!-- To Dos Folder -->
        <div class="associate-folder mb-2">
          <div class="associate-folder-header" data-folder="todos" style="cursor: pointer; display: flex; align-items: center; gap: 6px; padding: 6px; border-radius: 3px; user-select: none;">
            <i class="bi bi-chevron-right associate-folder-toggle" style="font-size: 12px; transition: transform 0.2s; flex: none;"></i>
            <i class="bi bi-check2-square" style="font-size: 14px;"></i>
            <span style="font-size: 13px; font-weight: 500;">To Dos</span>
          </div>
          <div id="projToDosListRight" class="associate-folder-content small" data-folder="todos" style="display: none; padding-left: 24px; margin-top: 4px;">
            <small class="text-muted">No to dos</small>
          </div>
        </div>
      </div>
    </div>

  <!-- Split Pane (Center + Right) -->
  <div class="split-pane-container" id="prioritySplitPane" style="flex: 1; display: flex; gap: 0; overflow: hidden;">
      <!-- Center Pane: Projects List -->
      <div class="split-pane-left" id="priorityListPane" style="overflow-y: auto; padding: 15px;">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h6 class="mb-0">Projects</h6>
          <button class="btn btn-primary" id="addPriorityBtn" data-bs-toggle="modal" data-bs-target="#priorityModal">
            + Add Project
          </button>
        </div>

        <p class="text-muted small mb-2">Drop a project on another to make it a sub-project, between two projects to reorder it there, or onto empty space to make it top-level. Drag a category, goal, or to do from the associate panel onto a project to associate it.</p>

        <div class="priority-tree-header text-muted small fw-bold border-bottom pb-1 mb-1">
          <span>Title</span>
          <span>Categories</span>
          <span>Goals</span>
          <span>Actions</span>
        </div>

        <div id="prioritiesList">
          <p class="text-center text-muted">No projects yet</p>
        </div>
      </div>

      <!-- Divider -->
      <div class="split-pane-divider" id="priorityDivider"></div>

      <!-- Right Pane: Project Editor (Hidden by default) -->
      <div class="split-pane-right hidden" id="priorityEditorPane">
        <div class="split-pane-editor">
          <div class="split-pane-editor-title" id="priorityEditorTitle">Select a project to edit</div>
          <form id="priorityEditorForm">
            <input type="hidden" id="priorityEditorId" name="priorityId">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="mb-3">
              <label for="priorityEditorFormTitle" class="form-label">Title *</label>
              <input type="text" class="form-control" id="priorityEditorFormTitle" name="title" required>
            </div>

            <div class="mb-3">
              <label for="priorityEditorNotes" class="form-label">Notes</label>
              <textarea class="form-control" id="priorityEditorNotes" name="notes" rows="4"></textarea>
            </div>

            <div class="mb-3">
              <label class="form-label">Links</label>
              <div id="priorityEditorLinksList" class="mb-2"></div>
              <div class="input-group input-group-sm">
                <input type="url" class="form-control" id="priorityEditorLinkUrl" placeholder="https://example.com">
                <input type="text" class="form-control" id="priorityEditorLinkTitle" placeholder="Link title (optional)" style="max-width: 150px;">
                <button type="button" class="btn btn-outline-secondary" id="priorityEditorAddLinkBtn">
                  <i class="bi bi-plus-lg"></i>
                </button>
              </div>
            </div>

            <div class="d-flex gap-2">
              <button type="button" class="btn btn-primary" id="savePriorityEditorBtn">Save</button>
              <button type="button" class="btn btn-secondary" id="closePriorityEditorBtn">Close</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

<!-- Priority Modal -->
<div class="modal fade" id="priorityModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Project Form</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="priorityForm">
          <input type="hidden" id="priorityId" name="priorityId">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="mb-3">
            <label for="priorityTitle" class="form-label">Title *</label>
            <input type="text" class="form-control" id="priorityTitle" name="title" required>
          </div>

          <div class="mb-3">
            <label for="priorityNotes" class="form-label">Notes</label>
            <textarea class="form-control" id="priorityNotes" name="notes" rows="4"></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label">Links</label>
            <div id="priorityLinksList" class="mb-2"></div>
            <div class="input-group input-group-sm">
              <input type="url" class="form-control" id="priorityLinkUrl" placeholder="https://example.com">
              <input type="text" class="form-control" id="priorityLinkTitle" placeholder="Link title (optional)" style="max-width: 150px;">
              <button type="button" class="btn btn-outline-secondary" id="addPriorityLinkBtn">
                <i class="bi bi-plus-lg"></i>
              </button>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="savePriorityBtn">Save Project</button>
      </div>
    </div>
  </div>
</div>

<style>
  .priority-tree-header, .priority-node-header {
    display: grid;
    grid-template-columns: 1fr 160px 160px 84px;
    align-items: center;
    gap: 8px;
  }

  .priority-tree-header span:not(:first-child) {
    text-align: left;
  }

  .priority-node-header {
    padding: 6px 8px;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    margin-bottom: 6px;
    cursor: move;
  }

  .priority-node-header:hover {
    background: #f8f9fa;
  }

  .priority-node-header.dragging-item {
    opacity: 0.5;
  }

  .priority-node-header.priority-drop-target {
    background: #e7f3ff;
    outline: 2px dashed #007bff;
    outline-offset: -2px;
  }

  #prioritiesList.priority-drop-target-root {
    outline: 2px dashed #007bff;
    outline-offset: -2px;
    border-radius: 4px;
  }

  .priority-title-cell {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  .priority-title-cell .priority-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .priority-toggle {
    cursor: pointer;
    width: 1rem;
    flex: none;
    display: inline-block;
    text-align: center;
    color: #666;
    transition: transform 0.15s ease;
  }

  .priority-node.expanded > .priority-node-header .priority-toggle {
    transform: rotate(90deg);
  }

  .priority-title {
    font-weight: 500;
  }

  .priority-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
  }

  .priority-actions {
    display: flex;
    gap: 4px;
    justify-content: flex-end;
  }

  .priority-node-children {
    display: none;
    padding-left: 24px;
  }

  .priority-node.expanded > .priority-node-children {
    display: block;
  }

  .drawer-layout {
    position: relative;
  }

  .drawer-panel.open {
    transform: translateX(0) !important;
  }

  .drawer-panel.open ~ .split-pane-container {
    margin-left: 220px;
  }
</style>

<script src="/js/linksHelper.js"></script>
<script src="/js/priorities.js"></script>
