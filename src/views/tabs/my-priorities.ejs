<div class="row mb-4">
  <div class="col-md-12 text-end">
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#priorityModal" onclick="openNewPriorityForm()">
      + Add Priority
    </button>
  </div>
</div>

<div class="table-responsive">
  <table class="table table-hover" id="prioritiesTable">
    <thead class="table-light">
      <tr>
        <th width="40"></th>
        <th>Title</th>
        <th>Data Source</th>
        <th width="100">Actions</th>
      </tr>
    </thead>
    <tbody id="prioritiesTableBody" class="sortable-priorities">
      <tr>
        <td colspan="4" class="text-center text-muted">No priorities yet</td>
      </tr>
    </tbody>
  </table>
</div>

<!-- Priority Modal -->
<div class="modal fade" id="priorityModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Priority Form</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="priorityForm">
          <input type="hidden" id="priorityId" name="priorityId">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="mb-3">
            <label for="priorityTitle" class="form-label">Title *</label>
            <input type="text" class="form-control" id="priorityTitle" name="title" required>
          </div>

          <div class="mb-3">
            <label for="prioritySource" class="form-label">Data Source</label>
            <select class="form-select" id="prioritySource" name="source_id">
              <option value="">-- None --</option>
              <option value="1">Outlook Calendar</option>
              <option value="2">Azure DevOps</option>
              <option value="3">GitHub Commits</option>
              <option value="4">Outlook Email</option>
              <option value="5">Azure DevOps Commits</option>
              <option value="6">MS Teams Messages</option>
              <option value="7">Daily Notes</option>
              <option value="8">OneNote Priorities</option>
              <option value="9">ServiceNow</option>
            </select>
          </div>

          <div class="mb-3">
            <label for="priorityNotes" class="form-label">Notes</label>
            <textarea class="form-control" id="priorityNotes" name="notes" rows="4"></textarea>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="savePriority()">Save Priority</button>
      </div>
    </div>
  </div>
</div>

<script>
async function loadPriorities() {
  const tbody = document.getElementById('prioritiesTableBody');
  tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted">Loading...</td></tr>';

  try {
    const response = await fetch('/api/priorities');
    const result = await response.json();

    if (result.success && result.data.length > 0) {
      tbody.innerHTML = result.data.map(priority => `
        <tr data-priority-id="${priority.id}">
          <td class="drag-handle" style="cursor: move; color: #999;">⋮⋮</td>
          <td>${priority.title}</td>
          <td>${priority.source_id ? 'Source #' + priority.source_id : '-'}</td>
          <td>
            <button class="btn btn-sm btn-info" onclick="editPriority(${priority.id})">Edit</button>
            <button class="btn btn-sm btn-danger" onclick="deletePriority(${priority.id})">Delete</button>
          </td>
        </tr>
      `).join('');
    } else {
      tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted">No priorities yet</td></tr>';
    }

    // Initialize drag-and-drop after loading
    initSortable();
  } catch (error) {
    console.error('Error loading priorities:', error);
    tbody.innerHTML = '<tr><td colspan="4" class="text-center text-danger">Error loading priorities</td></tr>';
  }
}

function initSortable() {
  const sortableElement = document.querySelector('.sortable-priorities');
  if (sortableElement && window.Sortable) {
    if (window.sortableInstance) {
      window.sortableInstance.destroy();
    }
    window.sortableInstance = Sortable.create(sortableElement, {
      handle: '.drag-handle',
      ghostClass: 'sortable-ghost',
      animation: 150,
      onEnd: function(evt) {
        updatePriorityOrder(evt.item.dataset.priorityId, evt.newIndex);
      }
    });
  }
}

function openNewPriorityForm() {
  document.getElementById('priorityId').value = '';
  document.getElementById('priorityForm').reset();
}

async function savePriority() {
  const priorityId = document.getElementById('priorityId').value;

  const data = {
    title: document.getElementById('priorityTitle').value,
    source_id: document.getElementById('prioritySource').value || null,
    notes: document.getElementById('priorityNotes').value
  };

  try {
    const url = priorityId ? `/api/priorities/${priorityId}` : '/api/priorities';
    const method = priorityId ? 'PUT' : 'POST';

    const response = await fetch(url, {
      method,
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': window.APP_CONFIG?.csrfToken
      },
      body: JSON.stringify(data)
    });

    const result = await response.json();
    if (result.success) {
      app.notify('Priority saved!', 'success');
      bootstrap.Modal.getInstance(document.getElementById('priorityModal')).hide();
      loadPriorities();
    } else {
      app.notify('Error: ' + result.message, 'danger');
    }
  } catch (error) {
    console.error('Error:', error);
    app.notify('Error saving priority', 'danger');
  }
}

async function editPriority(priorityId) {
  try {
    const response = await fetch(`/api/priorities/${priorityId}`);
    const result = await response.json();
    const priority = result.data;

    document.getElementById('priorityId').value = priority.id;
    document.getElementById('priorityTitle').value = priority.title;
    document.getElementById('prioritySource').value = priority.source_id || '';
    document.getElementById('priorityNotes').value = priority.notes;

    const modal = new bootstrap.Modal(document.getElementById('priorityModal'));
    modal.show();
  } catch (error) {
    console.error('Error:', error);
    app.notify('Error loading priority', 'danger');
  }
}

async function deletePriority(priorityId) {
  if (!await app.confirm('Delete this priority?')) return;

  try {
    const response = await fetch(`/api/priorities/${priorityId}`, {
      method: 'DELETE',
      headers: { 'X-CSRF-Token': window.APP_CONFIG?.csrfToken }
    });

    const result = await response.json();
    if (result.success) {
      app.notify('Priority deleted', 'success');
      loadPriorities();
    } else {
      app.notify('Error deleting priority', 'danger');
    }
  } catch (error) {
    console.error('Error:', error);
    app.notify('Error deleting priority', 'danger');
  }
}

async function updatePriorityOrder(priorityId, newPosition) {
  try {
    const response = await fetch(`/api/priorities/${priorityId}/reorder`, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': window.APP_CONFIG?.csrfToken
      },
      body: JSON.stringify({ newIndex: newPosition })
    });

    const result = await response.json();
    if (!result.success) {
      loadPriorities(); // Reload if update failed
    }
  } catch (error) {
    console.error('Error reordering:', error);
    loadPriorities();
  }
}

// Load priorities on page load
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', loadPriorities);
} else {
  loadPriorities();
}
</script>
