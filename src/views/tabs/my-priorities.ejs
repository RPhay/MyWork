<div class="row" style="min-height: 60vh;">
  <!-- Main Column: Projects -->
  <div class="col-md-9" style="overflow-y: auto;">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h6 class="mb-0">Projects</h6>
      <button class="btn btn-primary" id="addPriorityBtn" data-bs-toggle="modal" data-bs-target="#priorityModal">
        + Add Project
      </button>
    </div>

    <p class="text-muted small mb-2">Drop a project on another to make it a sub-project, between two projects to reorder it there, or onto empty space to make it top-level. Drag a category or goal from the right onto a project to associate it.</p>

    <div class="priority-tree-header text-muted small fw-bold border-bottom pb-1 mb-1">
      <span>Title</span>
      <span>Categories</span>
      <span>Goals</span>
      <span>Actions</span>
    </div>

    <div id="prioritiesList">
      <p class="text-center text-muted">No projects yet</p>
    </div>
  </div>

  <!-- Right Column: Categories & Goals -->
  <div class="col-md-3" style="overflow-y: auto; border-left: 1px solid #dee2e6; padding-left: 15px;">
    <ul class="nav nav-tabs nav-fill mb-2" id="projRightPanelTabs" style="font-size: 0.8rem;">
      <li class="nav-item">
        <button class="nav-link active px-1" data-panel-tab="categories" type="button">Categories</button>
      </li>
      <li class="nav-item">
        <button class="nav-link px-1" data-panel-tab="goals" type="button">Goals</button>
      </li>
    </ul>

    <div id="projCategoriesListRight" class="right-panel-list" data-panel="categories">
      <small class="text-muted">No categories</small>
    </div>
    <div id="projGoalsListRight" class="right-panel-list d-none" data-panel="goals">
      <small class="text-muted">No goals</small>
    </div>
  </div>
</div>

<!-- Priority Modal -->
<div class="modal fade" id="priorityModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Project Form</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="priorityForm">
          <input type="hidden" id="priorityId" name="priorityId">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="mb-3">
            <label for="priorityTitle" class="form-label">Title *</label>
            <input type="text" class="form-control" id="priorityTitle" name="title" required>
          </div>

          <div class="mb-3">
            <label for="priorityNotes" class="form-label">Notes</label>
            <textarea class="form-control" id="priorityNotes" name="notes" rows="4"></textarea>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="savePriorityBtn">Save Project</button>
      </div>
    </div>
  </div>
</div>

<style>
  .priority-tree-header, .priority-node-header {
    display: grid;
    grid-template-columns: 1fr 160px 160px 84px;
    align-items: center;
    gap: 8px;
  }

  .priority-tree-header span:not(:first-child) {
    text-align: left;
  }

  .priority-node-header {
    padding: 6px 8px;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    margin-bottom: 6px;
    cursor: move;
  }

  .priority-node-header:hover {
    background: #f8f9fa;
  }

  .priority-node-header.dragging-item {
    opacity: 0.5;
  }

  .priority-node-header.priority-drop-target {
    background: #e7f3ff;
    outline: 2px dashed #007bff;
    outline-offset: -2px;
  }

  #prioritiesList.priority-drop-target-root {
    outline: 2px dashed #007bff;
    outline-offset: -2px;
    border-radius: 4px;
  }

  .priority-title-cell {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  .priority-title-cell .priority-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .priority-toggle {
    cursor: pointer;
    width: 1rem;
    flex: none;
    display: inline-block;
    text-align: center;
    color: #666;
    transition: transform 0.15s ease;
  }

  .priority-node.expanded > .priority-node-header .priority-toggle {
    transform: rotate(90deg);
  }

  .priority-title {
    font-weight: 500;
  }

  .priority-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
  }

  .priority-actions {
    display: flex;
    gap: 4px;
    justify-content: flex-end;
  }

  .priority-node-children {
    display: none;
  }

  .priority-node.expanded > .priority-node-children {
    display: block;
  }
</style>

<script src="/js/priorities.js"></script>