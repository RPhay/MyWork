<div class="drawer-layout" style="display: flex; gap: 0; height: 70vh; position: relative;">
  <div class="split-pane-container" id="taskSplitPane" style="flex: 1; display: flex; gap: 0; overflow: hidden;">
  <!-- Left Pane -->
  <div class="split-pane-left" id="taskListPane" style="padding: 15px; overflow-y: auto;">
    <div class="row mb-2">
      <div class="col-md-12 text-end">
        <button class="btn btn-primary" id="addTaskBtn" data-bs-toggle="modal" data-bs-target="#taskModal">
          + Add Task
        </button>
      </div>
    </div>

    <div class="task-tree-header text-muted small fw-bold border-bottom pb-1 mb-1">
      <span>Title</span>
      <span>Notes</span>
      <span>Actions</span>
    </div>

    <div id="tasksList">
      <p class="text-center text-muted">No tasks yet</p>
    </div>
  </div>

  <!-- Divider -->
  <div class="split-pane-divider" id="taskDivider"></div>

  <!-- Right Pane (Editor) -->
  <div class="split-pane-right hidden" id="taskEditorPane">
    <div class="split-pane-editor">
      <div class="split-pane-editor-title" id="taskEditorTitle">Select a task to edit</div>
      <form id="taskEditorForm">
        <input type="hidden" id="taskEditorId" name="taskId">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="mb-3">
          <label for="taskEditorFormTitle" class="form-label">Title *</label>
          <input type="text" class="form-control" id="taskEditorFormTitle" name="title" required>
        </div>

        <div class="mb-3">
          <label for="taskEditorNotes" class="form-label">Notes</label>
          <textarea class="form-control" id="taskEditorNotes" name="notes" rows="4"></textarea>
        </div>

        <div class="mb-3">
          <label class="form-label">Links</label>
          <div id="taskEditorLinksList" class="mb-2"></div>
          <div class="input-group input-group-sm">
            <input type="url" class="form-control" id="taskEditorLinkUrl" placeholder="https://example.com">
            <input type="text" class="form-control" id="taskEditorLinkTitle" placeholder="Link title (optional)" style="max-width: 150px;">
            <button type="button" class="btn btn-outline-secondary" id="taskEditorAddLinkBtn">
              <i class="bi bi-plus-lg"></i>
            </button>
          </div>
        </div>

        <div class="d-flex gap-2">
          <button type="button" class="btn btn-primary" id="saveTaskEditorBtn">Save</button>
          <button type="button" class="btn btn-secondary" id="closeTaskEditorBtn">Close</button>
        </div>
      </form>
    </div>
  </div>
  </div>
</div>

<!-- Task Modal -->
<div class="modal fade" id="taskModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Task Form</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="taskForm">
          <input type="hidden" id="taskId" name="taskId">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="mb-3">
            <label for="taskTitle" class="form-label">Title *</label>
            <input type="text" class="form-control" id="taskTitle" name="title" required>
          </div>

          <div class="mb-3">
            <label for="taskNotes" class="form-label">Notes</label>
            <textarea class="form-control" id="taskNotes" name="notes" rows="4"></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label">Links</label>
            <div id="taskLinksList" class="mb-2"></div>
            <div class="input-group input-group-sm">
              <input type="url" class="form-control" id="taskLinkUrl" placeholder="https://example.com">
              <input type="text" class="form-control" id="taskLinkTitle" placeholder="Link title (optional)" style="max-width: 150px;">
              <button type="button" class="btn btn-outline-secondary" id="addTaskLinkBtn">
                <i class="bi bi-plus-lg"></i>
              </button>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="saveTaskBtn">Save Task</button>
      </div>
    </div>
  </div>
</div>

<style>
  .task-tree-header, .task-row {
    display: grid;
    grid-template-columns: 1fr 1fr 112px;
    align-items: center;
    gap: 8px;
  }

  .task-row {
    padding: 6px 8px;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    margin-bottom: 6px;
  }

  .task-row:hover {
    background: #f8f9fa;
  }

  .task-name-cell {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  .task-title {
    font-weight: 500;
    word-break: break-word;
  }

  .task-actions {
    display: flex;
    gap: 4px;
    justify-content: flex-end;
  }

  @media (prefers-color-scheme: dark) {
    .task-row:hover {
      background: #2a2a2a;
    }
  }
</style>

<script src="/js/editors/TaskEditor.js"></script>
<script src="/js/tasks.js"></script>
