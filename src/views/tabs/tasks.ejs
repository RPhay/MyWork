<style>
  .task-tree-header, .task-row {
    display: grid;
    grid-template-columns: 1fr 1fr 112px;
    align-items: center;
    gap: 8px;
    width: 100%;
  }

  .task-row {
    padding: 8px;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    margin-bottom: 6px;
    height: auto;
    min-height: 44px;
  }

  .task-row:hover {
    background: #f8f9fa;
  }

  .task-row {
    cursor: move;
  }

  .task-row.task-drop-target {
    background: #e7f3ff;
    outline: 2px dashed #007bff;
    outline-offset: -2px;
  }

  #tasksList {
    width: 100%;
  }

  #tasksList.task-drop-target-root {
    outline: 2px dashed #007bff;
    outline-offset: -2px;
    border-radius: 4px;
  }

  .task-name-cell {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    width: 100%;
  }

  .task-folder-toggle {
    cursor: pointer;
    width: 1rem;
    flex: none;
    display: inline-block;
    text-align: center;
    color: #666;
    transition: transform 0.15s ease;
  }

  .task-node.expanded > .task-row .task-folder-toggle {
    transform: rotate(90deg);
  }

  .task-node-children {
    display: none;
  }

  .task-node.expanded > .task-node-children {
    display: block;
  }

  .task-title {
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .task-notes {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .task-actions {
    display: flex;
    gap: 4px;
    justify-content: flex-end;
  }

  @media (prefers-color-scheme: dark) {
    .task-row:hover {
      background: #2a2a2a;
    }
  }
</style>

<script src="/js/editors/TaskEditor.js"></script>
