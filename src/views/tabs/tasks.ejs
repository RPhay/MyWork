<div class="drawer-layout" style="display: flex; gap: 0; height: 70vh; position: relative;">
  <div class="split-pane-container" id="taskSplitPane" style="flex: 1; display: flex; gap: 0; overflow: hidden;">
  <!-- Left Pane -->
  <div class="split-pane-left" id="taskListPane" style="padding: 15px; overflow-y: auto;">
    <div class="row mb-2">
      <div class="col-md-12 text-end">
        <button class="btn btn-primary" id="addTaskBtn" data-bs-toggle="modal" data-bs-target="#taskModal">
          + Add Task
        </button>
      </div>
    </div>

    <p class="text-muted small mb-2">Drag a task under another to nest it. Drag to the empty space above to unfile it.</p>

    <div class="task-tree-header text-muted small fw-bold border-bottom pb-1 mb-1">
      <span>Title</span>
      <span>Notes</span>
      <span>Actions</span>
    </div>

    <div id="tasksList">
      <p class="text-center text-muted">No tasks yet</p>
    </div>
  </div>

  <!-- Divider -->
  <div class="split-pane-divider" id="taskDivider"></div>

  <!-- Right Pane (Editor) -->
  <div class="split-pane-right hidden" id="taskEditorPane">
    <div class="split-pane-editor">
      <div class="split-pane-editor-title" id="taskEditorTitle">Select an item to edit</div>
      <form id="taskEditorForm">
        <input type="hidden" id="taskEditorId" name="taskId">
        <input type="hidden" id="taskEditorType" name="type" value="task">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="mb-3">
          <label for="taskEditorFormTitle" class="form-label">Title *</label>
          <input type="text" class="form-control" id="taskEditorFormTitle" name="title" required>
        </div>

        <div class="mb-3">
          <label for="taskEditorNotes" class="form-label">Notes</label>
          <textarea class="form-control" id="taskEditorNotes" name="notes" rows="4"></textarea>
        </div>

        <!-- Recurrence Settings -->
        <div class="mb-3 p-2 border-top">
          <label class="form-check">
            <input type="checkbox" class="form-check-input" id="taskEditorRecurrenceEnabled" name="recurrenceEnabled">
            <span class="form-check-label">Recurring</span>
          </label>

          <div id="taskEditorRecurrencePanel" style="display:none;" class="mt-2 p-2 bg-light rounded">
            <div class="mb-2">
              <label for="taskEditorRecurrenceType" class="form-label small">Type</label>
              <select class="form-select form-select-sm" id="taskEditorRecurrenceType">
                <option value="daily">Daily</option>
                <option value="weekly">Weekly</option>
                <option value="monthly">Monthly</option>
                <option value="interval">Custom Interval</option>
              </select>
            </div>

            <!-- Weekly Config -->
            <div id="taskEditorWeeklyConfig" style="display:none;" class="mb-2">
              <label class="form-label small">Days of Week</label>
              <div class="btn-group btn-group-sm w-100" role="group">
                <input type="checkbox" class="btn-check" id="taskEditorDay0" value="0">
                <label class="btn btn-outline-secondary" for="taskEditorDay0">Sun</label>
                <input type="checkbox" class="btn-check" id="taskEditorDay1" value="1">
                <label class="btn btn-outline-secondary" for="taskEditorDay1">Mon</label>
                <input type="checkbox" class="btn-check" id="taskEditorDay2" value="2">
                <label class="btn btn-outline-secondary" for="taskEditorDay2">Tue</label>
                <input type="checkbox" class="btn-check" id="taskEditorDay3" value="3">
                <label class="btn btn-outline-secondary" for="taskEditorDay3">Wed</label>
                <input type="checkbox" class="btn-check" id="taskEditorDay4" value="4">
                <label class="btn btn-outline-secondary" for="taskEditorDay4">Thu</label>
                <input type="checkbox" class="btn-check" id="taskEditorDay5" value="5">
                <label class="btn btn-outline-secondary" for="taskEditorDay5">Fri</label>
                <input type="checkbox" class="btn-check" id="taskEditorDay6" value="6">
                <label class="btn btn-outline-secondary" for="taskEditorDay6">Sat</label>
              </div>
            </div>

            <!-- Monthly Config -->
            <div id="taskEditorMonthlyConfig" style="display:none;" class="mb-2">
              <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="taskEditorMonthlyType" id="taskEditorMonthlyDate" value="date" checked>
                <label class="form-check-label" for="taskEditorMonthlyDate">Specific Date</label>
                <input type="number" class="form-control form-control-sm mt-1" id="taskEditorMonthlyDateInput" min="1" max="31" placeholder="Day (1-31)" style="width:80px;">
              </div>
              <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="taskEditorMonthlyType" id="taskEditorMonthlyWeekday" value="weekday">
                <label class="form-check-label" for="taskEditorMonthlyWeekday">Weekday Pattern</label>
                <div class="row mt-1 g-1">
                  <div class="col-6">
                    <select class="form-select form-select-sm" id="taskEditorMonthlyWeekdaySelect">
                      <option value="0">Sunday</option>
                      <option value="1">Monday</option>
                      <option value="2">Tuesday</option>
                      <option value="3">Wednesday</option>
                      <option value="4">Thursday</option>
                      <option value="5">Friday</option>
                      <option value="6">Saturday</option>
                    </select>
                  </div>
                  <div class="col-6">
                    <select class="form-select form-select-sm" id="taskEditorMonthlyWeekofmonthSelect">
                      <option value="1">1st</option>
                      <option value="2">2nd</option>
                      <option value="3">3rd</option>
                      <option value="4">4th</option>
                      <option value="5">5th</option>
                    </select>
                  </div>
                </div>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="taskEditorMonthlyType" id="taskEditorMonthlyLastday" value="lastday">
                <label class="form-check-label" for="taskEditorMonthlyLastday">Last Day of Month</label>
              </div>
            </div>

            <!-- Interval Config -->
            <div id="taskEditorIntervalConfig" style="display:none;" class="mb-2">
              <label for="taskEditorIntervalDays" class="form-label small">Every N Days</label>
              <input type="number" class="form-control form-control-sm" id="taskEditorIntervalDays" min="1" max="365" value="1">

              <label class="form-label small mt-2">Filter by Days (optional)</label>
              <div class="btn-group btn-group-sm w-100" role="group">
                <input type="checkbox" class="btn-check" id="taskEditorIntervalFilterWeekdays">
                <label class="btn btn-outline-secondary" for="taskEditorIntervalFilterWeekdays">Weekdays</label>
                <input type="checkbox" class="btn-check" id="taskEditorIntervalFilterWeekends">
                <label class="btn btn-outline-secondary" for="taskEditorIntervalFilterWeekends">Weekends</label>
              </div>

              <label class="form-label small mt-2">Specific Days</label>
              <div class="btn-group btn-group-sm w-100" role="group">
                <input type="checkbox" class="btn-check" id="taskEditorIntervalDay0" value="0">
                <label class="btn btn-outline-secondary" for="taskEditorIntervalDay0">Sun</label>
                <input type="checkbox" class="btn-check" id="taskEditorIntervalDay1" value="1">
                <label class="btn btn-outline-secondary" for="taskEditorIntervalDay1">Mon</label>
                <input type="checkbox" class="btn-check" id="taskEditorIntervalDay2" value="2">
                <label class="btn btn-outline-secondary" for="taskEditorIntervalDay2">Tue</label>
                <input type="checkbox" class="btn-check" id="taskEditorIntervalDay3" value="3">
                <label class="btn btn-outline-secondary" for="taskEditorIntervalDay3">Wed</label>
                <input type="checkbox" class="btn-check" id="taskEditorIntervalDay4" value="4">
                <label class="btn btn-outline-secondary" for="taskEditorIntervalDay4">Thu</label>
                <input type="checkbox" class="btn-check" id="taskEditorIntervalDay5" value="5">
                <label class="btn btn-outline-secondary" for="taskEditorIntervalDay5">Fri</label>
                <input type="checkbox" class="btn-check" id="taskEditorIntervalDay6" value="6">
                <label class="btn btn-outline-secondary" for="taskEditorIntervalDay6">Sat</label>
              </div>
            </div>

            <!-- Common Options -->
            <div class="mb-2">
              <label for="taskEditorRecurrenceStartDate" class="form-label small">Start Date (optional)</label>
              <input type="date" class="form-control form-control-sm" id="taskEditorRecurrenceStartDate">
            </div>

            <div class="mb-2">
              <label for="taskEditorRecurrenceEndDate" class="form-label small">End Date (optional)</label>
              <input type="date" class="form-control form-control-sm" id="taskEditorRecurrenceEndDate">
            </div>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label">Links</label>
          <div id="taskEditorLinksList" class="mb-2"></div>
          <div class="input-group input-group-sm">
            <input type="url" class="form-control" id="taskEditorLinkUrl" placeholder="https://example.com">
            <input type="text" class="form-control" id="taskEditorLinkTitle" placeholder="Link title (optional)" style="max-width: 150px;">
            <button type="button" class="btn btn-outline-secondary" id="taskEditorAddLinkBtn">
              <i class="bi bi-plus-lg"></i>
            </button>
          </div>
        </div>

        <div class="d-flex gap-2">
          <button type="button" class="btn btn-primary" id="saveTaskEditorBtn">Save</button>
          <button type="button" class="btn btn-secondary" id="closeTaskEditorBtn">Close</button>
          <button type="button" class="btn btn-danger ms-auto" id="deleteTaskEditorBtn">Delete</button>
        </div>
      </form>
    </div>
  </div>
  </div>
</div>


