<div class="d-flex justify-content-between align-items-center mb-2">
  <h6 class="mb-0"><i class="bi bi-kanban"></i> Priorities</h6>
</div>

<!-- All Priorities -->
<div class="priority-view-pane" data-view="all">
  <p class="text-muted small mb-3">
    Drag anything in from a typed tab or from Dailies. What lands here is a
    reference to the original, not a copy - edit it on its own page and it
    changes here too. On the board you can only move a row between columns,
    reorder it, or take it off.
  </p>

  <div class="row g-3 priority-board-row">
    <div class="col-md-4">
      <div class="priority-bay-header">Not Started</div>
      <div class="priority-bay" data-status="Not Started" id="bay-Not Started">
        <p class="text-center text-muted small board-empty">Drop anything here</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="priority-bay-header">In Progress</div>
      <div class="priority-bay" data-status="In Progress" id="bay-In Progress">
        <p class="text-center text-muted small board-empty">Drop anything here</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="priority-bay-header">Complete</div>
      <div class="priority-bay" data-status="Complete" id="bay-Complete">
        <p class="text-center text-muted small board-empty">Drop anything here</p>
      </div>
    </div>
  </div>
</div>

<style>
  /* A board card is a reference to a record that lives elsewhere, so it shows
     what the row IS - icon, title, type - and nothing that could be mistaken
     for an editable field. */
  .board-card {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 8px 10px;
    margin-bottom: 6px;
    background: #fff;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    cursor: grab;
  }

  .board-card:hover { border-color: #adb5bd; }
  .board-card.dragging-item { opacity: 0.5; }

  .board-card-icon { font-size: 20px; line-height: 1; flex: none; }

  .board-card-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }

  /* Wraps rather than truncating: nothing in this app cuts a value off with an
     ellipsis, the row grows instead. The board sits in a narrow rail, which is
     exactly where an ellipsis would hide the most. */
  .board-card-title {
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .board-card-meta { display: flex; align-items: center; gap: 6px; }

  .board-card-type {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #6c757d;
  }

  /* The record's own status, shown because it is worth knowing and greyed
     because it is not what the column means. */
  .board-card-status {
    font-size: 0.7rem;
    color: #868e96;
    padding: 1px 5px;
    border: 1px solid #e9ecef;
    border-radius: 3px;
  }

  .board-card-remove { padding: 0; color: #adb5bd; flex: none; line-height: 1; }
  .board-card-remove:hover { color: #dc3545; }

  .board-empty { padding: 18px 0; }

  .priority-bay-header {
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #495057;
    margin-bottom: 6px;
    padding: 0 4px;
  }

  .priority-bay {
    min-height: 55vh;
    background: #f1f3f5;
    border-radius: 6px;
    padding: 8px;
  }

  .priority-bay.bay-drop-target {
    outline: 2px dashed #007bff;
    outline-offset: -2px;
    background: #e7f3ff;
  }

  .priority-strip {
    background: #fff;
    border: 1px solid #dee2e6;
    border-left: 4px solid #6c757d;
    border-radius: 4px;
    margin-bottom: 6px;
  }

  #bay-In\ Progress .priority-strip {
    border-left-color: #ffc107;
  }

  #bay-Complete .priority-strip {
    border-left-color: #198754;
  }

  .priority-strip.dragging-item {
    opacity: 0.5;
  }

  .priority-strip-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 8px;
    cursor: move;
  }

  .priority-strip-toggle {
    width: 1rem;
    flex: none;
    display: inline-block;
    text-align: center;
    color: #666;
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  .priority-strip.expanded > .priority-strip-header .priority-strip-toggle {
    transform: rotate(90deg);
  }

  /* Cell takes the free space; title ellipsises inside it; badge stays with
     the text instead of being pushed to the row's actions. */
  .priority-strip-title-cell {
    display: flex;
    align-items: center;
    flex: 1;
    min-width: 0;
  }

  .priority-strip-title {
    flex: 0 1 auto;
    font-weight: 500;
    font-size: 0.85rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .priority-strip-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
  }

  .priority-strip-actions {
    display: flex;
    gap: 2px;
  }

  .priority-strip-children {
    display: none;
    padding: 2px 8px 6px 8px;
    border-top: 1px dashed #dee2e6;
  }

  .priority-strip.expanded > .priority-strip-children {
    display: block;
  }

  .priority-strip-child {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 6px 4px 20px;
    font-size: 0.8rem;
    border-radius: 3px;
  }

  .priority-strip-child:hover {
    background: #f8f9fa;
  }

</style>

<script src="/js/priority-board.js"></script>