<!-- Generic Entity Tab Template
     Unified template for any entity type (except Dailies, Templates, Priorities which have custom implementations)
     Handles hierarchical tree view, drag/drop, split-pane editor
-->

<div style="display: flex; gap: 0; height: 70vh; position: relative;" data-entity-type="<%= typeSlug %>" data-type-name="<%= typeName %>">
  <div class="split-pane-container" id="<%= typeSlug %>SplitPane" style="flex: 1; display: flex; gap: 0; overflow: hidden;">
    <!-- Left Pane: List/Tree -->
    <div class="split-pane-left" id="<%= typeSlug %>ListPane" style="padding: 15px; overflow-y: auto;">
      <div class="row mb-2">
        <div class="col-md-6">
          <div class="btn-group" role="group" style="display: inline-flex; gap: 2px;">
            <button type="button" class="btn btn-sm btn-outline-secondary" id="expandAll<%= typeSlug %>Btn" title="Expand all">
              <i class="bi bi-chevron-double-down"></i> Expand All
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="collapseAll<%= typeSlug %>Btn" title="Collapse all">
              <i class="bi bi-chevron-double-up"></i> Collapse All
            </button>
          </div>
        </div>
        <div class="col-md-6 text-end">
          <!-- Available on every type that supports nesting; generic-entity-init.js
               removes it for flat types. A folder is an is_folder row of this
               same type, not a type of its own. -->
          <button class="btn btn-outline-secondary" id="add<%= typeSlug %>FolderBtn" title="Create a folder to organize <%= typeName %>">
            <i class="bi bi-folder-plus"></i> + Folder
          </button>
          <button class="btn btn-primary" id="add<%= typeSlug %>Btn">
            + New <%= typeNameSingular %>
          </button>
        </div>
      </div>

      <p class="text-muted small mb-2">Drag to organize. Click to edit, click again to close.</p>

      <div id="<%= typeSlug %>EntityList" style="overflow-y: auto;">
        <p class="text-center text-muted">Loading...</p>
      </div>
    </div>

    <!-- Divider -->
    <div class="split-pane-divider" id="<%= typeSlug %>Divider"></div>

    <!-- Right Pane: Editor -->
    <div class="split-pane-right hidden" id="<%= typeSlug %>EditorPane">
      <div class="split-pane-editor">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
          <div class="split-pane-editor-title">Edit <%= typeNameSingular %></div>
          <div style="gap: 0.5rem; display: flex;">
            <button type="button" class="btn btn-primary btn-sm" id="<%= typeSlug %>SaveBtn" disabled>Save</button>
            <button type="button" class="btn btn-secondary btn-sm" id="<%= typeSlug %>CloseBtn">Cancel</button>
          </div>
        </div>
        <div id="<%= typeSlug %>-editor-pane" style="overflow-y: auto;"></div>
      </div>
    </div>
  </div>
</div>

<style>
.entity-row {
  padding: 8px;
  border: 1px solid #dee2e6;
  border-radius: 4px;
  margin-bottom: 4px;
  cursor: pointer;
  transition: background-color 0.2s;
}

.entity-row:hover {
  background-color: #f8f9fa;
}

/* The row whose item the editor currently has open. */
.entity-row.selected {
  border-color: #0d6efd;
  background-color: #e7f1ff;
}

.entity-row[draggable="true"] {
  cursor: move;
}

.entity-row-content {
  display: flex;
  align-items: center;
  gap: 8px;
}

.entity-toggle {
  cursor: pointer;
  display: inline-block;
  width: 18px;
  transform: rotate(0deg);
  transition: transform 0.2s;
}

.entity-node.expanded > .entity-node-children {
  display: block;
}

.entity-node-children {
  display: none;
  margin-left: 18px;
}

.entity-drop-target-nest {
  outline: 2px dashed #0d6efd;
  outline-offset: -2px;
  background: #e7f3ff;
}

.entity-row-icon {
  display: inline-block;
  margin-right: 4px;
  font-size: 1.1em;
}

/* Folders are organizational, so they read a little heavier than the items
   they hold. The 📁 icon itself comes from genericEntity.js#renderEntityRow. */
.entity-row-folder .entity-title {
  font-weight: 600;
}

.entity-title {
  font-weight: 500;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entity-actions {
  display: flex;
  gap: 4px;
  flex-shrink: 0;
}

.row-field {
  color: #6c757d;
  font-size: 0.875rem;
  margin-left: 8px;
}

.entity-row-link {
  text-decoration: none;
  white-space: nowrap;
  max-width: 14rem;
  overflow: hidden;
  text-overflow: ellipsis;
  display: inline-block;
  vertical-align: bottom;
}

.entity-row-link:hover {
  text-decoration: underline;
}
</style>
