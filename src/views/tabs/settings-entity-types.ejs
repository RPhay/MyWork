<!-- Settings: Manage Entity Types -->
<div style="padding: 20px; max-width: 1000px;">
  <h2>Manage Entity Types</h2>
  <p class="text-muted">Create custom entity types to organize work the way you need.</p>

  <!-- Create New Type Form -->
  <div class="card mb-4">
    <div class="card-header">
      <h5 class="mb-0">Create New Type</h5>
    </div>
    <div class="card-body">
      <form id="createTypeForm">
        <div class="row">
          <div class="col-md-6">
            <div class="mb-3">
              <label for="typeLabel" class="form-label">Type Name *</label>
              <input type="text" class="form-control" id="typeLabel" name="label" required
                     placeholder="e.g., Books, Projects, Health Goals">
            </div>
          </div>
          <div class="col-md-6">
            <div class="mb-3">
              <label for="typeIcon" class="form-label">Icon (emoji)</label>
              <input type="text" class="form-control" id="typeIcon" name="icon" maxlength="2"
                     placeholder="e.g., 📚, 🎯, ❤️">
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6">
            <div class="mb-3">
              <label for="typeLabelSingular" class="form-label">Singular Name</label>
              <input type="text" class="form-control" id="typeLabelSingular" name="label_singular"
                     placeholder="e.g., Book, Project, Health Goal">
            </div>
          </div>
          <div class="col-md-6">
            <div class="mb-3">
              <label class="form-label">Options</label>
              <div class="form-check">
                <input type="checkbox" class="form-check-input" id="supportsHierarchy" name="supports_hierarchy">
                <label class="form-check-label" for="supportsHierarchy">
                  Supports Hierarchy (parent/child nesting)
                </label>
              </div>
            </div>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label">Fields</label>
          <div id="fieldsContainer" class="border rounded p-3 mb-3" style="min-height: 100px; background-color: #f8f9fa;">
            <!-- Fields will be added here dynamically -->
          </div>
          <button type="button" class="btn btn-sm btn-outline-secondary" id="addFieldBtn">
            <i class="bi bi-plus"></i> Add Field
          </button>
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-primary">Create Type</button>
          <button type="reset" class="btn btn-outline-secondary">Clear</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Existing System Types -->
  <div class="card">
    <div class="card-header">
      <h5 class="mb-0">System Types (Read-only)</h5>
    </div>
    <div class="card-body">
      <div id="systemTypesList" class="list-group">
        <div class="spinner-border" role="status">
          <span class="visually-hidden">Loading...</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr auto;
    gap: 10px;
    align-items: end;
    padding: 10px;
    background: white;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    margin-bottom: 8px;
  }

  .field-row input,
  .field-row select {
    font-size: 0.9em;
  }

  .field-row .btn-sm {
    padding: 0.375rem 0.5rem;
  }

  .type-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px;
    border-bottom: 1px solid #dee2e6;
  }

  .type-item:last-child {
    border-bottom: none;
  }

  .type-icon {
    font-size: 1.5em;
    margin-right: 10px;
  }

  .type-info {
    flex: 1;
  }

  .type-slug {
    font-family: monospace;
    color: #6c757d;
    font-size: 0.85em;
  }

  .type-fields {
    color: #6c757d;
    font-size: 0.9em;
    margin-top: 3px;
  }
</style>

<script src="/js/settings-entity-types.js"></script>
