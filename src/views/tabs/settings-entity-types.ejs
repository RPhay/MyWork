<!-- Settings: Manage Entity Types
     Split-pane, matching the typed pages: list on the left, editor on the
     right. The editor used to be a floating modal, which made this page the
     odd one out among every other place you edit something in this app. -->
<div style="display: flex; gap: 0; height: 78vh; position: relative;">
  <div class="split-pane-container" id="entityTypeSplitPane" style="flex: 1; display: flex; gap: 0; overflow: hidden;">
    <div class="split-pane-left" id="entityTypeListPane" style="padding: 20px; overflow-y: auto;">
  <div class="d-flex justify-content-between align-items-start mb-3">
    <h2 class="mb-0">Entity Types</h2>
    <button class="btn btn-outline-secondary btn-sm" id="revertAllTypesBtn"
            title="Put every type's icon, labels and field settings back to the saved defaults. Records are not touched.">
      <i class="bi bi-arrow-counterclockwise"></i> Restore all to defaults
    </button>
  </div>
  <p class="text-muted mb-4">Manage editable types and templates that organize your work. Drag to reorder tabs; use the switch to show or hide a type on the dashboard.</p>

  <!-- Editable Types Section -->
  <div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h4 class="mb-0">Editable Types</h4>
        <small class="text-muted">Types you can create and manage in your dailies</small>
      </div>
      <button class="btn btn-primary" id="createNewTypeBtn">
        <i class="bi bi-plus"></i> New Type
      </button>
    </div>

    <div class="card">
      <div class="card-body p-0">
        <div id="editableTypesList" class="list-group list-group-flush">
          <div class="text-center p-4 text-muted">
            <div class="spinner-border" role="status" style="width: 2rem; height: 2rem;">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Loading types...</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Read-Only Types Section -->
  <div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h4 class="mb-0">Read-Only Types</h4>
        <small class="text-muted">Templates and special types (Dailies, External integrations)</small>
      </div>
    </div>

    <div class="card">
      <div class="card-body p-0">
        <div id="readonlyTypesList" class="list-group list-group-flush">
          <div class="text-center p-4 text-muted">
            <div class="spinner-border" role="status" style="width: 2rem; height: 2rem;">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Loading types...</p>
          </div>
        </div>
      </div>
    </div>
  </div>
    </div>

    <div class="split-pane-divider" id="entityTypeDivider"></div>

    <div class="split-pane-right hidden" id="entityTypeEditorPane">
      <div class="split-pane-editor">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
          <div class="split-pane-editor-title" id="entityTypeEditorTitle">Edit Type</div>
          <div class="editor-actions-bar" id="entityTypeEditorActions"></div>
        </div>
        <div id="entityType-editor-pane" style="overflow-y: auto;"></div>
      </div>
    </div>
  </div>
</div>

<style>
  .type-list-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    border-bottom: 1px solid #dee2e6;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .type-list-item:last-child {
    border-bottom: none;
  }

  .type-list-item:hover {
    background-color: #f8f9fa;
  }

  .type-drag-handle {
    cursor: grab;
    user-select: none;
    color: #adb5bd;
    font-size: 0.9em;
    margin-right: 4px;
  }

  .type-list-item-right {
    display: flex;
    align-items: center;
  }

  /* A disabled type has no tab on the dashboard - fade it so that reads at a glance. */
  .type-list-item:has(.type-visible-toggle:not(:checked)) .type-info {
    opacity: 0.55;
  }

  /* A locked editor should LOOK locked. Bootstrap's switches stay fully
     coloured when disabled, so a read-only type's toggles read as live
     controls even though nothing happens when they are clicked. */
  .type-editor-readonly .form-check-input,
  .type-editor-readonly .form-select,
  .type-editor-readonly .form-control,
  .type-editor-readonly button {
    opacity: 0.6;
  }

  /* Clickable: a read-only type opens the editor to be READ. The dimming stays
     to say it cannot be changed, but `cursor: default` and the killed hover
     said "nothing happens here", which is no longer true. */
  .type-list-item.readonly {
    cursor: pointer;
    opacity: 0.8;
  }

  .type-list-item-left {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .type-icon {
    font-size: 1.5em;
    min-width: 2em;
    text-align: center;
  }

  .type-info h6 {
    margin-bottom: 4px;
    font-weight: 600;
  }

  .type-info .small {
    color: #6c757d;
  }

  .type-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.75em;
    font-weight: 600;
    margin-left: 8px;
  }

  .type-badge.template {
    background-color: #e8f4f8;
    color: #0c5460;
  }

  .type-badge.daily {
    background-color: #fff3cd;
    color: #856404;
  }

  .type-badge.external {
    background-color: #f8d7da;
    color: #721c24;
  }

  .type-list-item-right {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  /* The edit button was removed: clicking the row opens the editor, so it was
     a second control for the same action. */

  .type-edit-btn {
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .type-icon-btn {
    font-size: 1.4rem;
    line-height: 1;
    padding: 6px 12px;
  }

  .type-icon-picker {
    position: fixed;
    z-index: 1060;
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 2px;
    background: #fff;
    border: 1px solid #dee2e6;
    border-radius: 6px;
    box-shadow: 0 6px 18px rgba(0,0,0,0.18);
    padding: 8px;
    max-height: 50vh;
    overflow-y: auto;
  }

  .type-icon-choice {
    background: none;
    border: 1px solid transparent;
    border-radius: 4px;
    font-size: 1.25rem;
    line-height: 1;
    padding: 4px;
    cursor: pointer;
  }

  .type-icon-choice:hover {
    background: #e7f1ff;
    border-color: #0d6efd;
  }
</style>

