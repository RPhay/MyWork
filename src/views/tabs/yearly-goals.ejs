<div class="row mb-4">
  <div class="col-md-6">
    <label for="yearSelect" class="form-label">Select Year:</label>
    <div class="d-flex gap-2">
      <select id="yearSelect" class="form-select"></select>
      <button type="button" class="btn btn-outline-secondary text-nowrap" id="addYearBtn" data-bs-toggle="modal" data-bs-target="#yearModal">
        + Add Year
      </button>
    </div>
  </div>
  <div class="col-md-6 text-end">
    <button class="btn btn-primary" id="addGoalBtn" data-bs-toggle="modal" data-bs-target="#goalModal">
      + Add Goal
    </button>
  </div>
</div>

<!-- Year Modal -->
<div class="modal fade" id="yearModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Add Year</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="yearForm">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label for="newYear" class="form-label">Year *</label>
            <input type="number" class="form-control" id="newYear" name="year" required min="1900" max="9999" step="1">
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="saveYearBtn">Add Year</button>
      </div>
    </div>
  </div>
</div>

<div class="split-pane-container" id="goalSplitPane" style="height: 600px;">
  <!-- Left Pane -->
  <div class="split-pane-left" id="goalListPane">
    <p class="text-muted small mb-2">Drag a goal between two others to reorder it.</p>

    <div class="table-responsive">
      <table class="table table-hover" id="goalsTable">
        <thead class="table-light">
          <tr>
            <th>Name</th>
            <th>Goal Categories</th>
            <th>Status</th>
            <th>Due Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="goalsTableBody">
          <tr>
            <td colspan="5" class="text-center text-muted">No goals for this year</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Divider -->
  <div class="split-pane-divider" id="goalDivider"></div>

  <!-- Right Pane (Editor) -->
  <div class="split-pane-right hidden" id="goalEditorPane">
    <div class="split-pane-editor">
      <div class="split-pane-editor-title" id="editorTitle">Select a goal to edit</div>
      <div id="goalEditorForm" style="display: none;">
        <!-- Goal form content will go here, moved from modal -->
      </div>
    </div>
  </div>
</div>

<!-- Goal Modal -->
<div class="modal fade" id="goalModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Goal Form</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="goalForm">
          <input type="hidden" id="goalId" name="goalId">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="mb-3">
            <label for="goalName" class="form-label">Name *</label>
            <input type="text" class="form-control" id="goalName" name="name" required>
          </div>

          <div class="mb-3">
            <label for="goalDescription" class="form-label">Description</label>
            <textarea class="form-control" id="goalDescription" name="description" rows="3"></textarea>
          </div>

          <div class="mb-3">
            <label for="goalMeasurements" class="form-label">Measurements</label>
            <textarea class="form-control" id="goalMeasurements" name="measurements" rows="3"></textarea>
          </div>

          <div class="mb-3">
            <label for="goalUpdates" class="form-label">Goal Updates</label>
            <textarea class="form-control" id="goalUpdates" name="goal_updates" rows="3"></textarea>
          </div>

          <div class="mb-3">
            <label for="goalCategories" class="form-label">Goal Categories</label>
            <select class="form-select" id="goalCategories" name="categories" multiple></select>
          </div>

          <div class="mb-3">
            <label for="goalStatus" class="form-label">Status</label>
            <select class="form-select" id="goalStatus" name="status">
              <option value="Not Started">Not Started</option>
              <option value="In Progress">In Progress</option>
              <option value="Complete">Complete</option>
            </select>
          </div>

          <div class="mb-3">
            <label for="goalDueDate" class="form-label">Due Date</label>
            <input type="date" class="form-control" id="goalDueDate" name="due_date">
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="saveGoalBtn">Save Goal</button>
      </div>
    </div>
  </div>
</div>

<style>
  #goalsTableBody tr[draggable="true"] {
    cursor: move;
  }

  #goalsTableBody tr.dragging-item {
    opacity: 0.5;
  }

  .goal-status-badge {
    cursor: pointer;
  }
</style>

<script src="/js/goals.js"></script>

