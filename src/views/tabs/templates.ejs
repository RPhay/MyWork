<div class="row" style="min-height: 60vh;">
  <!-- Main Column: Templates -->
  <div class="col-md-9" style="overflow-y: auto;">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h6>Templates</h6>
      <button class="btn btn-sm btn-primary" id="addTemplateBtn" data-bs-toggle="modal" data-bs-target="#templateModal">
        + Add Template
      </button>
    </div>

    <p class="text-muted small mb-2">Drag a project, goal, or category from the right onto a template to associate it. Drag a template between two others to reorder it. Drag templates onto a day in Dailies to create a work item. <strong>Drag a calendar event from Outlook</strong> directly onto the templates list to create a new template.</p>

    <div class="template-tree-header text-muted small fw-bold border-bottom pb-1 mb-2">
      <span>Title</span>
      <span>Oh!</span>
      <span>Status</span>
      <span>Time Box</span>
      <span>Actions</span>
    </div>

    <div id="templatesList">
      <p class="text-center text-muted">No templates yet</p>
    </div>
  </div>

  <!-- Right Column: Projects, Goals & Areas -->
  <div class="col-md-3" style="overflow-y: auto; border-left: 1px solid #dee2e6; padding-left: 15px;">
    <ul class="nav nav-tabs nav-fill mb-2" id="templateRightPanelTabs" style="font-size: 0.8rem;">
      <li class="nav-item">
        <button class="nav-link active px-1" data-panel-tab="priorities" type="button">Projects</button>
      </li>
      <li class="nav-item">
        <button class="nav-link px-1" data-panel-tab="goals" type="button">Goals</button>
      </li>
      <li class="nav-item">
        <button class="nav-link px-1" data-panel-tab="areas" type="button">Categories</button>
      </li>
    </ul>

    <div id="tplPrioritiesListRight" class="tpl-right-panel-list" data-panel="priorities">
      <small class="text-muted">No priorities</small>
    </div>
    <div id="tplGoalsListRight" class="tpl-right-panel-list d-none" data-panel="goals">
      <small class="text-muted">No goals</small>
    </div>
    <div id="tplAreasListRight" class="tpl-right-panel-list d-none" data-panel="areas">
      <small class="text-muted">No categories</small>
    </div>
  </div>
</div>

<!-- Template Modal -->
<div class="modal fade" id="templateModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Template Form</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="templateForm">
          <input type="hidden" id="templateId" name="templateId">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="mb-3 d-flex gap-2 align-items-end">
            <div class="flex-grow-1">
              <label for="templateTitle" class="form-label">Title *</label>
              <input type="text" class="form-control" id="templateTitle" name="title" required>
            </div>
            <div>
              <label class="form-label d-block">Oh!</label>
              <input type="hidden" id="templateEmoji" name="emoji">
              <button type="button" class="btn btn-outline-secondary emoji-field-btn text-muted" id="templateEmojiBtn" data-action="pick-emoji-field" data-input="templateEmoji">Pick an emoji</button>
            </div>
          </div>

          <div class="mb-3">
            <label for="templateDescription" class="form-label">Description</label>
            <textarea class="form-control" id="templateDescription" name="description" rows="3"></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label d-block">Time Box</label>
            <div class="d-flex flex-wrap gap-2" id="templateTimeBox">
              <input type="radio" class="btn-check" name="templateTimeBoxBubble" id="templateTimeBoxNone" value="" autocomplete="off" checked>
              <label class="btn btn-outline-secondary btn-sm rounded-pill" for="templateTimeBoxNone">No time box</label>

              <input type="radio" class="btn-check" name="templateTimeBoxBubble" id="templateTimeBox15" value="15" autocomplete="off">
              <label class="btn btn-outline-secondary btn-sm rounded-pill" for="templateTimeBox15">15m</label>

              <input type="radio" class="btn-check" name="templateTimeBoxBubble" id="templateTimeBox30" value="30" autocomplete="off">
              <label class="btn btn-outline-secondary btn-sm rounded-pill" for="templateTimeBox30">30m</label>

              <input type="radio" class="btn-check" name="templateTimeBoxBubble" id="templateTimeBox45" value="45" autocomplete="off">
              <label class="btn btn-outline-secondary btn-sm rounded-pill" for="templateTimeBox45">45m</label>

              <input type="radio" class="btn-check" name="templateTimeBoxBubble" id="templateTimeBox60" value="60" autocomplete="off">
              <label class="btn btn-outline-secondary btn-sm rounded-pill" for="templateTimeBox60">60m</label>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="saveTemplateBtn">Save Template</button>
      </div>
    </div>
  </div>
</div>

<style>
  .template-tree-header, .template-node-header {
    display: grid;
    grid-template-columns: 1fr 40px 100px 70px 84px;
    align-items: center;
    gap: 8px;
  }

  .template-node {
    border: 1px solid #dee2e6;
    border-radius: 4px;
    margin-bottom: 8px;
  }

  .template-node-header {
    padding: 8px 10px;
    cursor: move;
    user-select: none;
  }

  .template-node-header.dragging-item {
    opacity: 0.5;
  }

  .template-node-header:hover {
    background: #f8f9fa;
  }

  .template-node.drag-over > .template-node-header {
    background: #e7f3ff;
    outline: 2px dashed #007bff;
    outline-offset: -2px;
  }

  .template-node-toggle {
    width: 1rem;
    display: inline-block;
    text-align: center;
    color: #666;
    transition: transform 0.15s ease;
  }

  .template-node.expanded .template-node-toggle {
    transform: rotate(90deg);
  }

  .template-title-cell {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .template-title-cell .template-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 500;
  }

  .template-node-header .badge {
    justify-self: start;
  }

  .template-emoji {
    text-align: center;
    font-size: 1rem;
    cursor: pointer;
    border-radius: 4px;
    min-height: 1.2rem;
  }

  .template-emoji:hover {
    background: #e9ecef;
  }

  .template-status-badge {
    cursor: pointer;
    justify-self: start;
  }

  .template-timebox-badge {
    cursor: pointer;
    justify-self: start;
  }

  .template-actions {
    display: flex;
    gap: 4px;
    justify-content: flex-end;
  }

  .template-node-children {
    display: none;
    padding: 4px 10px 8px 2.25rem;
  }

  .template-node.expanded .template-node-children {
    display: block;
  }

  .template-child-item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    font-size: 0.85rem;
    border-radius: 3px;
  }

  .template-child-item:hover {
    background: #f8f9fa;
  }

  .template-child-item .template-child-remove {
    margin-left: auto;
    opacity: 0.6;
  }

  .template-child-item .template-child-remove:hover {
    opacity: 1;
  }

  .tpl-priority-item, .tpl-goal-item, .tpl-area-item {
    padding: 3px 6px;
    margin-bottom: 2px;
    background: #f8f9fa;
    border-radius: 3px;
    cursor: move;
    font-size: 0.8rem;
    line-height: 1.3;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .tpl-priority-item:hover, .tpl-goal-item:hover, .tpl-area-item:hover {
    background: #e9ecef;
  }

  .tpl-right-panel-list {
    padding-top: 4px;
  }

  .templates-drop-target {
    background-color: #e3f2fd !important;
    border: 2px dashed #2196f3 !important;
    border-radius: 4px !important;
  }
</style>

<script src="/js/templates.js"></script>