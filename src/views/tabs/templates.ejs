<div class="drawer-layout" style="display: flex; gap: 0; height: 60vh; position: relative;">
  <!-- Vertical Tab (far left, always on top) -->
  <div class="drawer-tab" style="width: 30px; background: #f8f9fa; border-right: 1px solid #dee2e6; display: flex; align-items: center; justify-content: center; position: relative; z-index: 20;">
    <button class="drawer-toggle" id="templatesAssociateItemsToggle" style="background: none; border: none; cursor: pointer; padding: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; flex-direction: column;">
      <span style="writing-mode: vertical-rl; text-orientation: mixed; transform: rotate(180deg); font-size: 11px; font-weight: 500; white-space: nowrap; color: #666; user-select: none;">Associate Items</span>
    </button>
  </div>

  <!-- Drawer Panel (Associate Items) - pushes content right -->
  <div class="drawer-panel" id="templatesAssociateItemsPanel" style="width: 0; background: white; border-right: 1px solid #dee2e6; overflow: hidden; padding: 0; transition: width 0.3s ease; overflow-y: auto;" data-drawer-open="false">
      <div style="margin-bottom: 15px;">
        <h6 class="mb-3">Associate Items</h6>

        <!-- Projects Folder -->
        <div class="associate-folder mb-2">
          <div class="associate-folder-header" data-folder="projects" style="cursor: pointer; display: flex; align-items: center; gap: 6px; padding: 6px; border-radius: 3px; user-select: none;">
            <i class="bi bi-chevron-right associate-folder-toggle" style="font-size: 12px; transition: transform 0.2s; flex: none;"></i>
            <i class="bi bi-folder" style="font-size: 14px;"></i>
            <span style="font-size: 13px; font-weight: 500;">Projects</span>
          </div>
          <div id="tplPrioritiesListRight" class="associate-folder-content small" data-folder="projects" style="display: none; padding-left: 24px; margin-top: 4px;">
            <small class="text-muted">No projects</small>
          </div>
        </div>

        <!-- Goals Folder -->
        <div class="associate-folder mb-2">
          <div class="associate-folder-header" data-folder="goals" style="cursor: pointer; display: flex; align-items: center; gap: 6px; padding: 6px; border-radius: 3px; user-select: none;">
            <i class="bi bi-chevron-right associate-folder-toggle" style="font-size: 12px; transition: transform 0.2s; flex: none;"></i>
            <i class="bi bi-flag" style="font-size: 14px;"></i>
            <span style="font-size: 13px; font-weight: 500;">Goals</span>
          </div>
          <div id="tplGoalsListRight" class="associate-folder-content small" data-folder="goals" style="display: none; padding-left: 24px; margin-top: 4px;">
            <small class="text-muted">No goals</small>
          </div>
        </div>

        <!-- Categories Folder -->
        <div class="associate-folder mb-2">
          <div class="associate-folder-header" data-folder="areas" style="cursor: pointer; display: flex; align-items: center; gap: 6px; padding: 6px; border-radius: 3px; user-select: none;">
            <i class="bi bi-chevron-right associate-folder-toggle" style="font-size: 12px; transition: transform 0.2s; flex: none;"></i>
            <i class="bi bi-tags" style="font-size: 14px;"></i>
            <span style="font-size: 13px; font-weight: 500;">Categories</span>
          </div>
          <div id="tplAreasListRight" class="associate-folder-content small" data-folder="areas" style="display: none; padding-left: 24px; margin-top: 4px;">
            <small class="text-muted">No categories</small>
          </div>
        </div>
      </div>
    </div>

  <!-- Split Pane (Center + Right) -->
  <div class="split-pane-container" id="templatesSplitPane" style="flex: 1; display: flex; gap: 0; overflow: hidden;">
      <!-- Center Pane: Templates List -->
      <div class="split-pane-left" id="templatesLeftPane" style="overflow-y: auto;">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h6>Templates</h6>
          <button class="btn btn-sm btn-primary" id="addTemplateBtn" data-bs-toggle="modal" data-bs-target="#templateModal">
            + Add Template
          </button>
        </div>

        <p class="text-muted small mb-2">Drag a project, goal, or category from the left onto a template to associate it. Drag a template between two others to reorder it. Drag templates onto a day in Dailies to create a work item. <strong>Drag a calendar event from Outlook</strong> directly onto the templates list to create a new template.</p>

        <div class="template-tree-header text-muted small fw-bold border-bottom pb-1 mb-2">
          <span>Title</span>
          <span>Oh!</span>
          <span>Status</span>
          <span>Time Box</span>
          <span>Actions</span>
        </div>

        <div id="templatesList">
          <p class="text-center text-muted">No templates yet</p>
        </div>
      </div>

      <!-- Divider -->
      <div class="split-pane-divider" id="templatesDivider"></div>

      <!-- Right Pane: Template Editor (Hidden by default) -->
      <div class="split-pane-right hidden" id="templateEditorPane">
        <div class="split-pane-editor">
          <div class="split-pane-editor-title" id="templateEditorTitle">Select a template to edit</div>
          <form id="templateEditorForm">
            <input type="hidden" id="templateEditorId" name="templateId">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="mb-3 d-flex gap-2 align-items-end">
              <div class="flex-grow-1">
                <label for="templateEditorTitle" class="form-label">Title *</label>
                <input type="text" class="form-control" id="templateEditorTitle" name="title" required>
              </div>
              <div>
                <label class="form-label d-block">Oh!</label>
                <input type="hidden" id="templateEditorEmoji" name="emoji">
                <button type="button" class="btn btn-outline-secondary emoji-field-btn text-muted" id="templateEditorEmojiBtn" data-action="pick-emoji-field" data-input="templateEditorEmoji">Pick</button>
              </div>
            </div>

            <div class="mb-3">
              <label for="templateEditorDescription" class="form-label">Description</label>
              <textarea class="form-control" id="templateEditorDescription" name="description" rows="3"></textarea>
            </div>

            <div class="mb-3">
              <label class="form-label d-block">Time Box</label>
              <div class="d-flex flex-wrap gap-2" id="templateEditorTimeBox">
                <input type="radio" class="btn-check" name="templateEditorTimeBoxBubble" id="templateEditorTimeBoxNone" value="" autocomplete="off" checked>
                <label class="btn btn-outline-secondary btn-sm rounded-pill" for="templateEditorTimeBoxNone">No time box</label>

                <input type="radio" class="btn-check" name="templateEditorTimeBoxBubble" id="templateEditorTimeBox15" value="15" autocomplete="off">
                <label class="btn btn-outline-secondary btn-sm rounded-pill" for="templateEditorTimeBox15">15m</label>

                <input type="radio" class="btn-check" name="templateEditorTimeBoxBubble" id="templateEditorTimeBox30" value="30" autocomplete="off">
                <label class="btn btn-outline-secondary btn-sm rounded-pill" for="templateEditorTimeBox30">30m</label>

                <input type="radio" class="btn-check" name="templateEditorTimeBoxBubble" id="templateEditorTimeBox45" value="45" autocomplete="off">
                <label class="btn btn-outline-secondary btn-sm rounded-pill" for="templateEditorTimeBox45">45m</label>

                <input type="radio" class="btn-check" name="templateEditorTimeBoxBubble" id="templateEditorTimeBox60" value="60" autocomplete="off">
                <label class="btn btn-outline-secondary btn-sm rounded-pill" for="templateEditorTimeBox60">60m</label>
              </div>
            </div>

            <div class="d-flex gap-2">
              <button type="button" class="btn btn-primary" id="saveTemplateEditorBtn">Save</button>
              <button type="button" class="btn btn-secondary" id="closeTemplateEditorBtn">Close</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Template Modal -->
<div class="modal fade" id="templateModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Template Form</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="templateForm">
          <input type="hidden" id="templateId" name="templateId">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="mb-3 d-flex gap-2 align-items-end">
            <div class="flex-grow-1">
              <label for="templateTitle" class="form-label">Title *</label>
              <input type="text" class="form-control" id="templateTitle" name="title" required>
            </div>
            <div>
              <label class="form-label d-block">Oh!</label>
              <input type="hidden" id="templateEmoji" name="emoji">
              <button type="button" class="btn btn-outline-secondary emoji-field-btn text-muted" id="templateEmojiBtn" data-action="pick-emoji-field" data-input="templateEmoji">Pick an emoji</button>
            </div>
          </div>

          <div class="mb-3">
            <label for="templateDescription" class="form-label">Description</label>
            <textarea class="form-control" id="templateDescription" name="description" rows="3"></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label d-block">Time Box</label>
            <div class="d-flex flex-wrap gap-2" id="templateTimeBox">
              <input type="radio" class="btn-check" name="templateTimeBoxBubble" id="templateTimeBoxNone" value="" autocomplete="off" checked>
              <label class="btn btn-outline-secondary btn-sm rounded-pill" for="templateTimeBoxNone">No time box</label>

              <input type="radio" class="btn-check" name="templateTimeBoxBubble" id="templateTimeBox15" value="15" autocomplete="off">
              <label class="btn btn-outline-secondary btn-sm rounded-pill" for="templateTimeBox15">15m</label>

              <input type="radio" class="btn-check" name="templateTimeBoxBubble" id="templateTimeBox30" value="30" autocomplete="off">
              <label class="btn btn-outline-secondary btn-sm rounded-pill" for="templateTimeBox30">30m</label>

              <input type="radio" class="btn-check" name="templateTimeBoxBubble" id="templateTimeBox45" value="45" autocomplete="off">
              <label class="btn btn-outline-secondary btn-sm rounded-pill" for="templateTimeBox45">45m</label>

              <input type="radio" class="btn-check" name="templateTimeBoxBubble" id="templateTimeBox60" value="60" autocomplete="off">
              <label class="btn btn-outline-secondary btn-sm rounded-pill" for="templateTimeBox60">60m</label>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="saveTemplateBtn">Save Template</button>
      </div>
    </div>
  </div>
</div>

<style>
  .drawer-layout {
    position: relative;
  }

  .drawer-panel.open {
    transform: translateX(0) !important;
  }

  .drawer-panel.open ~ .split-pane-container {
    margin-left: 220px;
  }

  .template-tree-header, .template-node-header {
    display: grid;
    grid-template-columns: 1fr 40px 100px 70px 84px;
    align-items: center;
    gap: 8px;
  }

  .template-node {
    border: 1px solid #dee2e6;
    border-radius: 4px;
    margin-bottom: 8px;
  }

  .template-node-header {
    padding: 8px 10px;
    cursor: move;
    user-select: none;
  }

  .template-node-header.dragging-item {
    opacity: 0.5;
  }

  .template-node-header:hover {
    background: #f8f9fa;
  }

  .template-node.drag-over > .template-node-header {
    background: #e7f3ff;
    outline: 2px dashed #007bff;
    outline-offset: -2px;
  }

  .template-node-toggle {
    width: 1rem;
    display: inline-block;
    text-align: center;
    color: #666;
    transition: transform 0.15s ease;
  }

  .template-node.expanded > .template-node-header .template-node-toggle {
    transform: rotate(90deg);
  }

  .template-title-cell {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  .template-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .template-emoji {
    text-align: center;
    width: 40px;
    cursor: pointer;
  }

  .template-status-badge {
    text-align: center;
    min-width: 90px;
    cursor: pointer;
  }

  .template-timebox-badge {
    text-align: center;
    min-width: 60px;
    cursor: pointer;
  }

  .template-actions {
    display: flex;
    gap: 4px;
    justify-content: flex-end;
  }

  .template-node-children {
    display: none;
    padding-left: 10px;
  }

  .template-node.expanded > .template-node-children {
    display: block;
  }

  #templatesList {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  #templatesList.templates-drop-target {
    outline: 2px dashed #007bff;
    outline-offset: -2px;
    border-radius: 4px;
  }

  .template-child-item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    background: #f8f9fa;
    border-radius: 2px;
    margin-bottom: 4px;
    font-size: 0.85rem;
  }

  .template-child-remove {
    margin-left: auto;
  }
</style>

<script src="/js/templates.js"></script>
