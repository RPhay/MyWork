<div class="drawer-layout" style="display: flex; gap: 0; height: 70vh; position: relative;">
  <div class="split-pane-container" id="todoSplitPane" style="flex: 1; display: flex; gap: 0; overflow: hidden;">
  <!-- Left Pane -->
  <div class="split-pane-left" id="todoListPane" style="padding: 15px; overflow-y: auto;">
    <div class="row mb-2">
      <div class="col-md-12 text-end">
        <button class="btn btn-primary" id="addToDoBtn" data-bs-toggle="modal" data-bs-target="#toDoModal">
          + Add To Do
        </button>
      </div>
    </div>

    <p class="text-muted small mb-2">Drag a to do under another to nest it. Drag to the empty space above to unfile it.</p>

    <div class="todo-tree-header text-muted small fw-bold border-bottom pb-1 mb-1">
      <span>Title</span>
      <span>Notes</span>
      <span>Actions</span>
    </div>

    <div id="toDosList">
      <p class="text-center text-muted">No to dos yet</p>
    </div>
  </div>

  <!-- Todo Context Menu -->
  <div id="toDoContextMenu" class="context-menu d-none" style="position: fixed; background: white; border: 1px solid #ddd; border-radius: 4px; box-shadow: 0 2px 8px rgba(0,0,0,0.15); z-index: 1000; min-width: 150px;">
    <button type="button" class="context-menu-item" data-action="create-child-todo" style="display: block; width: 100%; text-align: left; padding: 0.5rem 1rem; border: none; background: none; cursor: pointer;">
      <i class="bi bi-plus-circle"></i> Create Child Todo
    </button>
  </div>

  <!-- Divider -->
  <div class="split-pane-divider" id="todoDivider"></div>

  <!-- Right Pane (Editor) -->
  <div class="split-pane-right hidden" id="todoEditorPane">
    <div class="split-pane-editor">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div class="split-pane-editor-title" id="todoEditorTitle">Select an item to edit</div>
        <div style="gap: 0.5rem; display: flex;">
          <button type="button" class="btn btn-primary btn-sm" id="saveToDoEditorBtn" disabled>Save</button>
          <button type="button" class="btn btn-secondary btn-sm" id="closeToDoEditorBtn">Cancel</button>
          <button type="button" class="btn btn-danger btn-sm" id="deleteToDoEditorBtn">Delete</button>
        </div>
      </div>
      <form id="toDoEditorForm">
        <input type="hidden" id="toDoEditorId" name="toDoId">
        <input type="hidden" id="toDoEditorType" name="type" value="todo">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="mb-3">
          <label for="toDoEditorFormTitle" class="form-label">Title *</label>
          <input type="text" class="form-control" id="toDoEditorFormTitle" name="title" required>
        </div>

        <div class="mb-3">
          <label for="toDoEditorNotes" class="form-label">Notes</label>
          <textarea class="form-control" id="toDoEditorNotes" name="notes" rows="4"></textarea>
        </div>

        <!-- Recurrence Settings -->
        <div class="mb-3 p-2 border-top">
          <label class="form-check">
            <input type="checkbox" class="form-check-input" id="toDoEditorRecurrenceEnabled" name="recurrenceEnabled">
            <span class="form-check-label">Recurring</span>
          </label>

          <div id="toDoEditorRecurrencePanel" style="display:none;" class="mt-2 p-2 bg-light rounded">
            <div class="mb-2">
              <label class="form-label small d-block">Type</label>
              <div class="btn-group btn-group-sm w-100" role="group">
                <input type="radio" class="btn-check" id="toDoEditorRecurrenceTypeDaily" name="toDoEditorRecurrenceType" value="daily" checked>
                <label class="btn btn-outline-secondary" for="toDoEditorRecurrenceTypeDaily">Daily</label>
                <input type="radio" class="btn-check" id="toDoEditorRecurrenceTypeWeekly" name="toDoEditorRecurrenceType" value="weekly">
                <label class="btn btn-outline-secondary" for="toDoEditorRecurrenceTypeWeekly">Weekly</label>
                <input type="radio" class="btn-check" id="toDoEditorRecurrenceTypeMonthly" name="toDoEditorRecurrenceType" value="monthly">
                <label class="btn btn-outline-secondary" for="toDoEditorRecurrenceTypeMonthly">Monthly</label>
                <input type="radio" class="btn-check" id="toDoEditorRecurrenceTypeInterval" name="toDoEditorRecurrenceType" value="interval">
                <label class="btn btn-outline-secondary" for="toDoEditorRecurrenceTypeInterval">Custom Interval</label>
              </div>
            </div>

            <!-- Weekly Config -->
            <div id="toDoEditorWeeklyConfig" style="display:none;" class="mb-2">
              <label class="form-label small">Days of Week</label>
              <div class="btn-group btn-group-sm w-100" role="group">
                <input type="checkbox" class="btn-check" id="toDoEditorDay0" value="0">
                <label class="btn btn-outline-secondary" for="toDoEditorDay0">Sun</label>
                <input type="checkbox" class="btn-check" id="toDoEditorDay1" value="1">
                <label class="btn btn-outline-secondary" for="toDoEditorDay1">Mon</label>
                <input type="checkbox" class="btn-check" id="toDoEditorDay2" value="2">
                <label class="btn btn-outline-secondary" for="toDoEditorDay2">Tue</label>
                <input type="checkbox" class="btn-check" id="toDoEditorDay3" value="3">
                <label class="btn btn-outline-secondary" for="toDoEditorDay3">Wed</label>
                <input type="checkbox" class="btn-check" id="toDoEditorDay4" value="4">
                <label class="btn btn-outline-secondary" for="toDoEditorDay4">Thu</label>
                <input type="checkbox" class="btn-check" id="toDoEditorDay5" value="5">
                <label class="btn btn-outline-secondary" for="toDoEditorDay5">Fri</label>
                <input type="checkbox" class="btn-check" id="toDoEditorDay6" value="6">
                <label class="btn btn-outline-secondary" for="toDoEditorDay6">Sat</label>
              </div>
            </div>

            <!-- Monthly Config -->
            <div id="toDoEditorMonthlyConfig" style="display:none;" class="mb-2">
              <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="toDoEditorMonthlyType" id="toDoEditorMonthlyDate" value="date" checked>
                <label class="form-check-label" for="toDoEditorMonthlyDate">Specific Date</label>
                <input type="number" class="form-control form-control-sm mt-1" id="toDoEditorMonthlyDateInput" min="1" max="31" placeholder="Day (1-31)" style="width:80px;">
              </div>
              <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="toDoEditorMonthlyType" id="toDoEditorMonthlyWeekday" value="weekday">
                <label class="form-check-label" for="toDoEditorMonthlyWeekday">Weekday Pattern</label>
                <div class="row mt-1 g-1">
                  <div class="col-6">
                    <select class="form-select form-select-sm" id="toDoEditorMonthlyWeekdaySelect">
                      <option value="0">Sunday</option>
                      <option value="1">Monday</option>
                      <option value="2">Tuesday</option>
                      <option value="3">Wednesday</option>
                      <option value="4">Thursday</option>
                      <option value="5">Friday</option>
                      <option value="6">Saturday</option>
                    </select>
                  </div>
                  <div class="col-6">
                    <select class="form-select form-select-sm" id="toDoEditorMonthlyWeekofmonthSelect">
                      <option value="1">1st</option>
                      <option value="2">2nd</option>
                      <option value="3">3rd</option>
                      <option value="4">4th</option>
                      <option value="5">5th</option>
                    </select>
                  </div>
                </div>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="toDoEditorMonthlyType" id="toDoEditorMonthlyLastday" value="lastday">
                <label class="form-check-label" for="toDoEditorMonthlyLastday">Last Day of Month</label>
              </div>
            </div>

            <!-- Interval Config -->
            <div id="toDoEditorIntervalConfig" style="display:none;" class="mb-2">
              <label for="toDoEditorIntervalDays" class="form-label small">Every N Days</label>
              <input type="number" class="form-control form-control-sm" id="toDoEditorIntervalDays" min="1" max="365" value="1">

              <label class="form-label small mt-2">Filter by Days (optional)</label>
              <div class="btn-group btn-group-sm w-100" role="group">
                <input type="checkbox" class="btn-check" id="toDoEditorIntervalFilterWeekdays">
                <label class="btn btn-outline-secondary" for="toDoEditorIntervalFilterWeekdays">Weekdays</label>
                <input type="checkbox" class="btn-check" id="toDoEditorIntervalFilterWeekends">
                <label class="btn btn-outline-secondary" for="toDoEditorIntervalFilterWeekends">Weekends</label>
              </div>

              <label class="form-label small mt-2">Specific Days</label>
              <div class="btn-group btn-group-sm w-100" role="group">
                <input type="checkbox" class="btn-check" id="toDoEditorIntervalDay0" value="0">
                <label class="btn btn-outline-secondary" for="toDoEditorIntervalDay0">Sun</label>
                <input type="checkbox" class="btn-check" id="toDoEditorIntervalDay1" value="1">
                <label class="btn btn-outline-secondary" for="toDoEditorIntervalDay1">Mon</label>
                <input type="checkbox" class="btn-check" id="toDoEditorIntervalDay2" value="2">
                <label class="btn btn-outline-secondary" for="toDoEditorIntervalDay2">Tue</label>
                <input type="checkbox" class="btn-check" id="toDoEditorIntervalDay3" value="3">
                <label class="btn btn-outline-secondary" for="toDoEditorIntervalDay3">Wed</label>
                <input type="checkbox" class="btn-check" id="toDoEditorIntervalDay4" value="4">
                <label class="btn btn-outline-secondary" for="toDoEditorIntervalDay4">Thu</label>
                <input type="checkbox" class="btn-check" id="toDoEditorIntervalDay5" value="5">
                <label class="btn btn-outline-secondary" for="toDoEditorIntervalDay5">Fri</label>
                <input type="checkbox" class="btn-check" id="toDoEditorIntervalDay6" value="6">
                <label class="btn btn-outline-secondary" for="toDoEditorIntervalDay6">Sat</label>
              </div>
            </div>

            <!-- Common Options -->
            <div class="mb-2">
              <label for="toDoEditorRecurrenceStartDate" class="form-label small">Start Date (optional)</label>
              <input type="date" class="form-control form-control-sm" id="toDoEditorRecurrenceStartDate">
            </div>

            <div class="mb-2">
              <label for="toDoEditorRecurrenceEndDate" class="form-label small">End Date (optional)</label>
              <input type="date" class="form-control form-control-sm" id="toDoEditorRecurrenceEndDate">
            </div>

            <!-- Preview -->
            <div class="p-2 bg-white rounded border mt-2">
              <small class="text-muted">Next occurrences:</small>
              <div id="toDoEditorRecurrencePreview" class="mt-1 small"></div>
            </div>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label">Items</label>
          <div id="toDoEditorItemsList"></div>
          <button type="button" class="btn btn-sm btn-outline-secondary mt-1" id="toDoEditorAddItemBtn">
            <i class="bi bi-plus-lg"></i> Add Item
          </button>
        </div>

        <div class="mb-3">
          <label class="form-label">Links</label>
          <div id="toDoEditorLinksList" class="mb-2"></div>
          <div class="input-group input-group-sm">
            <input type="url" class="form-control" id="toDoEditorLinkUrl" placeholder="https://example.com">
            <input type="text" class="form-control" id="toDoEditorLinkTitle" placeholder="Link title (optional)" style="max-width: 150px;">
            <button type="button" class="btn btn-outline-secondary" id="toDoEditorAddLinkBtn">
              <i class="bi bi-plus-lg"></i>
            </button>
          </div>
        </div>

        <!-- Associated Items Sections -->
        <hr class="my-3">

        <div class="mb-3">
          <label class="form-label">Categories</label>
          <div id="toDoEditorCategoriesList" class="list-group list-group-sm mb-2"></div>
          <button type="button" class="btn btn-sm btn-outline-secondary" id="toDoEditorAddCategoryBtn">
            <i class="bi bi-plus-lg"></i> Add Category
          </button>
        </div>

        <div class="mb-3">
          <label class="form-label">Projects</label>
          <div id="toDoEditorProjectsList" class="list-group list-group-sm mb-2"></div>
          <button type="button" class="btn btn-sm btn-outline-secondary" id="toDoEditorAddProjectBtn">
            <i class="bi bi-plus-lg"></i> Add Project
          </button>
        </div>

      </form>
    </div>
  </div>
  </div>
</div>

<!-- To Do Convert Context Menu (right-click a to do) -->
<div id="todoContextMenu" class="context-menu d-none">
  <button type="button" class="context-menu-item" data-convert-type="project"><i class="bi bi-folder2"></i> Convert to Project</button>
  <button type="button" class="context-menu-item" data-convert-type="sub-project"><i class="bi bi-folder2"></i> Convert to Sub-Project</button>
  <button type="button" class="context-menu-item" data-convert-type="area"><i class="bi bi-diagram-3"></i> Convert to Category</button>
  <button type="button" class="context-menu-item" data-convert-type="sub-area"><i class="bi bi-diagram-3"></i> Convert to Sub-Category</button>
  <button type="button" class="context-menu-item" data-convert-type="work-item"><i class="bi bi-card-checklist"></i> Convert to Work Item</button>
</div>

<!-- To Do Modal -->
