<div class="drawer-layout" style="display: flex; gap: 0; height: 70vh; position: relative;">
  <div class="split-pane-container" id="areaSplitPane" style="flex: 1; display: flex; gap: 0; overflow: hidden;">
    <!-- Left Pane -->
    <div class="split-pane-left" id="areaListPane" style="padding: 15px; overflow-y: auto;">
    <div class="row mb-2">
      <div class="col-md-12 text-end">
        <button class="btn btn-primary" id="addAreaBtn" data-bs-toggle="modal" data-bs-target="#areaModal">
          + Add Category
        </button>
      </div>
    </div>

    <p class="text-muted small mb-2">Drop a category on another to make it a sub-category, between two categories to reorder it there, or onto empty space to make it top-level.</p>

    <div class="area-tree-header text-muted small fw-bold border-bottom pb-1 mb-1">
      <span>Name</span>
      <span>Description</span>
      <span>Actions</span>
    </div>

    <div id="areasList">
      <p class="text-center text-muted">No categories yet</p>
    </div>
    </div>

    <!-- Divider -->
    <div class="split-pane-divider" id="areaDivider"></div>

    <!-- Right Pane (Editor) -->
    <div class="split-pane-right hidden" id="areaEditorPane">
      <div class="split-pane-editor">
        <div class="split-pane-editor-title" id="areaEditorTitle">Select a category to edit</div>
        <form id="areaEditorForm">
          <input type="hidden" id="areaEditorId" name="areaId">
          <input type="hidden" id="areaEditorParentId" name="parentId">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <p class="text-muted small mb-2 d-none" id="areaEditorParentHint"></p>

          <div class="mb-3">
            <label for="areaEditorName" class="form-label">Name *</label>
            <input type="text" class="form-control" id="areaEditorName" name="name" required>
          </div>

          <div class="mb-3">
            <label for="areaEditorDescription" class="form-label">Description</label>
            <textarea class="form-control" id="areaEditorDescription" name="description" rows="4"></textarea>
          </div>

          <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary" id="saveAreaEditorBtn">Save</button>
            <button type="button" class="btn btn-secondary" id="closeAreaEditorBtn">Close</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Category Context Menu -->
<div id="areaContextMenu" class="context-menu d-none">
  <button type="button" class="context-menu-item" data-menu-action="add-subcategory"><i class="bi bi-diagram-3"></i> Add Subcategory</button>
  <button type="button" class="context-menu-item" data-menu-action="create-template"><i class="bi bi-clipboard-plus"></i> Create Template from Category</button>
</div>

<!-- Category Modal -->
<div class="modal fade" id="areaModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Category Form</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="text-muted small mb-2 d-none" id="areaParentHint"></p>
        <form id="areaForm">
          <input type="hidden" id="areaId" name="areaId">
          <input type="hidden" id="areaParentId" name="parentId">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="mb-3">
            <label for="areaName" class="form-label">Name *</label>
            <input type="text" class="form-control" id="areaName" name="name" required>
          </div>

          <div class="mb-3">
            <label for="areaDescription" class="form-label">Description</label>
            <textarea class="form-control" id="areaDescription" name="description" rows="4"></textarea>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="saveAreaBtn">Save Category</button>
      </div>
    </div>
  </div>
</div>

<style>
  .area-tree-header, .area-node-header {
    display: grid;
    grid-template-columns: 1fr 1fr 84px;
    align-items: center;
    gap: 8px;
  }

  .area-node-header {
    padding: 6px 8px;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    margin-bottom: 6px;
    cursor: move;
  }

  .area-node-header:hover {
    background: #f8f9fa;
  }

  .area-node-header.dragging-item {
    opacity: 0.5;
  }

  .area-node-header.area-drop-target {
    background: #e7f3ff;
    outline: 2px dashed #007bff;
    outline-offset: -2px;
  }

  #areasList.area-drop-target-root {
    outline: 2px dashed #007bff;
    outline-offset: -2px;
    border-radius: 4px;
  }

  .area-name-cell {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  .area-name-cell .area-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .area-toggle {
    cursor: pointer;
    width: 1rem;
    flex: none;
    display: inline-block;
    text-align: center;
    color: #666;
    transition: transform 0.15s ease;
  }

  .area-node.expanded > .area-node-header .area-toggle {
    transform: rotate(90deg);
  }

  .area-name {
    font-weight: 500;
  }

  .area-description {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .area-actions {
    display: flex;
    gap: 4px;
    justify-content: flex-end;
  }

  .area-node-children {
    display: none;
  }

  .area-node.expanded > .area-node-children {
    display: block;
  }
</style>

<script src="/js/areas.js"></script>