<div class="row mb-4">
  <div class="col-md-6">
    <div class="btn-group" role="group">
      <input type="radio" class="btn-check" name="viewMode" id="dayView" value="day" checked onchange="changeViewMode('day')">
      <label class="btn btn-outline-primary" for="dayView">Day View</label>

      <input type="radio" class="btn-check" name="viewMode" id="weekView" value="week" onchange="changeViewMode('week')">
      <label class="btn btn-outline-primary" for="weekView">Week View</label>
    </div>
  </div>
  <div class="col-md-6 text-end">
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#workModal" onclick="openNewWorkForm()">
      + Add Work
    </button>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-3">
    <div class="card">
      <div class="card-body">
        <div id="calendar"></div>
      </div>
    </div>
  </div>
  <div class="col-md-9">
    <div class="card">
      <div class="card-body">
        <div class="row">
          <div class="col-md-8">
            <label for="selectedDate" class="form-label">Selected Date:</label>
            <input type="date" id="selectedDate" class="form-control" onchange="loadWorkItems()">
          </div>
          <div class="col-md-4">
            <label class="form-label">&nbsp;</label>
            <div>
              <button class="btn btn-sm btn-secondary" onclick="previousDate()">← Previous</button>
              <button class="btn btn-sm btn-secondary" onclick="today()">Today</button>
              <button class="btn btn-sm btn-secondary" onclick="nextDate()">Next →</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-12">
    <div id="dayViewContent">
      <h5 id="dayViewTitle">Today's Work</h5>
      <div class="table-responsive">
        <table class="table table-hover">
          <thead class="table-light">
            <tr>
              <th>Title</th>
              <th>Associated Goals/Priorities</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="workItemsTableBody">
            <tr>
              <td colspan="4" class="text-center text-muted">Loading work items...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Work Item Modal -->
<div class="modal fade" id="workModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Work Item Form</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="workForm">
          <input type="hidden" id="workId" name="workId">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="mb-3">
            <label for="workDate" class="form-label">Date *</label>
            <input type="date" class="form-control" id="workDate" name="date" required>
          </div>

          <div class="mb-3">
            <label for="workTitle" class="form-label">Title *</label>
            <input type="text" class="form-control" id="workTitle" name="title" required>
          </div>

          <div class="mb-3">
            <label for="workDescription" class="form-label">Description</label>
            <textarea class="form-control" id="workDescription" name="description" rows="3"></textarea>
          </div>

          <div class="mb-3">
            <label for="workGoals" class="form-label">Associated Goals</label>
            <select class="form-select" id="workGoals" name="goals" multiple>
              <!-- Goals will be loaded via AJAX -->
            </select>
          </div>

          <div class="mb-3">
            <label for="workPriorities" class="form-label">Associated Priorities</label>
            <select class="form-select" id="workPriorities" name="priorities" multiple>
              <!-- Priorities will be loaded via AJAX -->
            </select>
          </div>

          <div class="mb-3">
            <label for="workSource" class="form-label">Data Source</label>
            <select class="form-select" id="workSource" name="source_id">
              <option value="">-- None --</option>
              <option value="1">Outlook Calendar</option>
              <option value="2">Azure DevOps</option>
              <option value="3">GitHub Commits</option>
              <option value="4">Outlook Email</option>
              <option value="5">Azure DevOps Commits</option>
              <option value="6">MS Teams Messages</option>
              <option value="7">Daily Notes</option>
              <option value="8">OneNote Priorities</option>
              <option value="9">ServiceNow</option>
            </select>
          </div>

          <div class="mb-3">
            <label for="workStatus" class="form-label">Status</label>
            <select class="form-select" id="workStatus" name="status">
              <option value="Not Started">Not Started</option>
              <option value="In Progress">In Progress</option>
              <option value="Complete">Complete</option>
            </select>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="saveWorkItem()">Save Work</button>
      </div>
    </div>
  </div>
</div>

<script>
function renderCalendar() {
  const today = new Date();
  const year = today.getFullYear();
  const month = today.getMonth();

  const firstDay = new Date(year, month, 1);
  const lastDay = new Date(year, month + 1, 0);
  const daysInMonth = lastDay.getDate();
  const startingDayOfWeek = firstDay.getDay();

  const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

  let html = `<h5>${monthNames[month]} ${year}</h5><table class="table table-sm" style="font-size: 0.85rem;">`;
  html += '<tr><th>Sun</th><th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th><th>Sat</th></tr><tr>';

  for (let i = 0; i < startingDayOfWeek; i++) {
    html += '<td>&nbsp;</td>';
  }

  for (let day = 1; day <= daysInMonth; day++) {
    const date = new Date(year, month, day);
    const dateStr = date.toISOString().split('T')[0];
    const isToday = dateStr === new Date().toISOString().split('T')[0];
    const isSelected = dateStr === document.getElementById('selectedDate').value;

    html += `<td style="cursor: pointer; padding: 5px; text-align: center; ${isToday ? 'background: #e7f3ff; font-weight: bold;' : ''} ${isSelected ? 'background: #007bff; color: white;' : ''}" onclick="selectDate('${dateStr}')">${day}</td>`;

    if ((day + startingDayOfWeek) % 7 === 0 && day < daysInMonth) {
      html += '</tr><tr>';
    }
  }

  html += '</tr></table>';
  document.getElementById('calendar').innerHTML = html;
}

function selectDate(dateStr) {
  document.getElementById('selectedDate').value = dateStr;
  loadWorkItems();
  renderCalendar();
}

function changeViewMode(mode) {
  console.log('Changing view mode to:', mode);
  loadWorkItems();
}

async function loadWorkItems() {
  const date = document.getElementById('selectedDate').value;
  const tbody = document.getElementById('workItemsTableBody');

  tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted">Loading...</td></tr>';

  try {
    const response = await fetch(`/api/work/date/${date}`);
    const result = await response.json();

    if (result.success && result.data.length > 0) {
      tbody.innerHTML = result.data.map(item => `
        <tr>
          <td>${item.title}</td>
          <td>-</td>
          <td><span class="badge bg-${item.status === 'Complete' ? 'success' : item.status === 'In Progress' ? 'warning' : 'secondary'}">${item.status}</span></td>
          <td>
            <button class="btn btn-sm btn-info" onclick="editWorkItem(${item.id})">Edit</button>
            <button class="btn btn-sm btn-danger" onclick="deleteWorkItem(${item.id})">Delete</button>
          </td>
        </tr>
      `).join('');
    } else {
      tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted">No work items for ' + date + '</td></tr>';
    }
  } catch (error) {
    console.error('Error:', error);
    tbody.innerHTML = '<tr><td colspan="4" class="text-center text-danger">Error loading work items</td></tr>';
  }
}

function previousDate() {
  const dateInput = document.getElementById('selectedDate');
  const date = new Date(dateInput.value);
  date.setDate(date.getDate() - 1);
  dateInput.value = date.toISOString().split('T')[0];
  loadWorkItems();
  renderCalendar();
}

function nextDate() {
  const dateInput = document.getElementById('selectedDate');
  const date = new Date(dateInput.value);
  date.setDate(date.getDate() + 1);
  dateInput.value = date.toISOString().split('T')[0];
  loadWorkItems();
  renderCalendar();
}

function today() {
  const dateInput = document.getElementById('selectedDate');
  dateInput.value = new Date().toISOString().split('T')[0];
  loadWorkItems();
  renderCalendar();
}

function openNewWorkForm() {
  document.getElementById('workId').value = '';
  const dateInput = document.getElementById('selectedDate');
  document.getElementById('workDate').value = dateInput.value || new Date().toISOString().split('T')[0];
  document.getElementById('workForm').reset();
}

async function saveWorkItem() {
  const workId = document.getElementById('workId').value;

  const data = {
    date: document.getElementById('workDate').value,
    title: document.getElementById('workTitle').value,
    description: document.getElementById('workDescription').value,
    status: document.getElementById('workStatus').value,
    goal_ids: Array.from(document.getElementById('workGoals').selectedOptions).map(opt => opt.value),
    priority_ids: Array.from(document.getElementById('workPriorities').selectedOptions).map(opt => opt.value),
    source_id: document.getElementById('workSource').value || null
  };

  try {
    const url = workId ? `/api/work/${workId}` : '/api/work';
    const method = workId ? 'PUT' : 'POST';

    const response = await fetch(url, {
      method,
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': window.APP_CONFIG?.csrfToken
      },
      body: JSON.stringify(data)
    });

    const result = await response.json();
    if (result.success) {
      app.notify('Work item saved!', 'success');
      bootstrap.Modal.getInstance(document.getElementById('workModal')).hide();
      loadWorkItems();
    } else {
      app.notify('Error: ' + result.message, 'danger');
    }
  } catch (error) {
    console.error('Error:', error);
    app.notify('Error saving work item', 'danger');
  }
}

async function editWorkItem(workId) {
  try {
    const response = await fetch(`/api/work/${workId}`);
    const result = await response.json();
    const item = result.data;

    document.getElementById('workId').value = item.id;
    document.getElementById('workDate').value = item.date;
    document.getElementById('workTitle').value = item.title;
    document.getElementById('workDescription').value = item.description;
    document.getElementById('workStatus').value = item.status;

    const modal = new bootstrap.Modal(document.getElementById('workModal'));
    modal.show();
  } catch (error) {
    console.error('Error:', error);
    app.notify('Error loading work item', 'danger');
  }
}

async function deleteWorkItem(workId) {
  if (!await app.confirm('Delete this work item?')) return;

  try {
    const response = await fetch(`/api/work/${workId}`, {
      method: 'DELETE',
      headers: { 'X-CSRF-Token': window.APP_CONFIG?.csrfToken }
    });

    const result = await response.json();
    if (result.success) {
      app.notify('Work item deleted', 'success');
      loadWorkItems();
    } else {
      app.notify('Error deleting work item', 'danger');
    }
  } catch (error) {
    console.error('Error:', error);
    app.notify('Error deleting work item', 'danger');
  }
}

// Initialize on page load
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', function() {
    const dateInput = document.getElementById('selectedDate');
    dateInput.value = new Date().toISOString().split('T')[0];
    renderCalendar();
    loadWorkItems();
  });
} else {
  const dateInput = document.getElementById('selectedDate');
  dateInput.value = new Date().toISOString().split('T')[0];
  renderCalendar();
  loadWorkItems();
}
</script>
