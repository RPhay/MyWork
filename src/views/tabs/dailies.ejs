<div class="drawer-layout" style="display: flex; gap: 0; height: 70vh; position: relative;">
  <!-- Vertical Tab (far left, always on top) -->
  <div class="drawer-tab" style="width: 30px; background: #f8f9fa; border-right: 1px solid #dee2e6; display: flex; align-items: center; justify-content: center; position: relative; z-index: 20;">
    <button class="drawer-toggle" id="dailiesAssociateItemsToggle" style="background: none; border: none; cursor: pointer; padding: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; flex-direction: column;">
      <span style="writing-mode: vertical-rl; text-orientation: mixed; transform: rotate(180deg); font-size: 11px; font-weight: 500; white-space: nowrap; color: #666; user-select: none;">Associate Items</span>
    </button>
  </div>

  <!-- Drawer Panel (Associate Items) - pushes content right -->
  <div class="drawer-panel" id="dailiesAssociateItemsPanel" style="width: 0; background: white; border-right: 1px solid #dee2e6; overflow: hidden; padding: 0; transition: width 0.3s ease; overflow-y: auto;" data-drawer-open="false">
    <div style="margin-bottom: 15px;">
      <h6 class="mb-3">Associate Items</h6>

      <!-- Projects Folder -->
      <div class="associate-folder mb-2">
        <div class="associate-folder-header" data-folder="projects" style="cursor: pointer; display: flex; align-items: center; gap: 6px; padding: 6px; border-radius: 3px; user-select: none;">
          <i class="bi bi-chevron-right associate-folder-toggle" style="font-size: 12px; transition: transform 0.2s; flex: none;"></i>
          <i class="bi bi-folder" style="font-size: 14px;"></i>
          <span style="font-size: 13px; font-weight: 500;">Projects</span>
        </div>
        <div id="prioritiesListRight" class="associate-folder-content small" data-folder="projects" style="display: none; padding-left: 24px; margin-top: 4px;">
          <small class="text-muted">No projects</small>
        </div>
      </div>

      <!-- Goals Folder -->
      <div class="associate-folder mb-2">
        <div class="associate-folder-header" data-folder="goals" style="cursor: pointer; display: flex; align-items: center; gap: 6px; padding: 6px; border-radius: 3px; user-select: none;">
          <i class="bi bi-chevron-right associate-folder-toggle" style="font-size: 12px; transition: transform 0.2s; flex: none;"></i>
          <i class="bi bi-flag" style="font-size: 14px;"></i>
          <span style="font-size: 13px; font-weight: 500;">Goals</span>
        </div>
        <div id="goalsListRight" class="associate-folder-content small" data-folder="goals" style="display: none; padding-left: 24px; margin-top: 4px;">
          <small class="text-muted">No goals</small>
        </div>
      </div>

      <!-- Categories Folder -->
      <div class="associate-folder mb-2">
        <div class="associate-folder-header" data-folder="areas" style="cursor: pointer; display: flex; align-items: center; gap: 6px; padding: 6px; border-radius: 3px; user-select: none;">
          <i class="bi bi-chevron-right associate-folder-toggle" style="font-size: 12px; transition: transform 0.2s; flex: none;"></i>
          <i class="bi bi-tags" style="font-size: 14px;"></i>
          <span style="font-size: 13px; font-weight: 500;">Categories</span>
        </div>
        <div id="areasListRight" class="associate-folder-content small" data-folder="areas" style="display: none; padding-left: 24px; margin-top: 4px;">
          <small class="text-muted">No categories</small>
        </div>
      </div>

      <!-- Templates Folder -->
      <div class="associate-folder mb-2">
        <div class="associate-folder-header" data-folder="templates" style="cursor: pointer; display: flex; align-items: center; gap: 6px; padding: 6px; border-radius: 3px; user-select: none;">
          <i class="bi bi-chevron-right associate-folder-toggle" style="font-size: 12px; transition: transform 0.2s; flex: none;"></i>
          <i class="bi bi-list-check" style="font-size: 14px;"></i>
          <span style="font-size: 13px; font-weight: 500;">Templates</span>
        </div>
        <div id="templatesListRight" class="associate-folder-content small" data-folder="templates" style="display: none; padding-left: 24px; margin-top: 4px;">
          <small class="text-muted">No templates</small>
        </div>
      </div>

      <!-- Data Sources Import Section -->
      <div style="margin-top: 15px; padding-top: 15px; border-top: 1px solid #dee2e6;">
        <div class="text-muted small fw-bold mb-2">Import from</div>
        <div id="dataSourcesIcons" style="display: flex; gap: 8px; flex-wrap: wrap;">
          <!-- Data source icons will be added here by JavaScript -->
        </div>
      </div>
    </div>
  </div>

  <!-- Outer Split Pane (Calendar | Content) -->
  <div class="split-pane-container" id="dailiesOuterSplitPane" style="flex: 1; display: flex; gap: 0; overflow: hidden;">
    <!-- Left Pane: Calendar -->
    <div class="split-pane-left" id="dailiesCalendarPane" style="overflow-y: auto; padding: 15px; font-size: 0.9rem;">
      <div id="calendar"></div>
    </div>

    <!-- Divider between calendar and work items -->
    <div class="split-pane-divider" id="dailiesOuterDivider"></div>

    <!-- Right Pane: Inner Split Pane (Work Items | Editor) -->
    <div class="split-pane-right" id="dailiesContentRight">
      <div class="split-pane-container" id="dailiesSplitPane" style="flex: 1; display: flex; gap: 0; overflow: hidden;">
      <!-- Center Pane: Work Items -->
      <div class="split-pane-left" id="dailiesCenterPane" style="overflow-y: auto; padding: 15px;">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h6>Work Items for <span id="selectedDateDisplay"></span> <span id="dailyTimeTotal" class="text-muted small fw-normal"></span></h6>
          <div class="d-flex gap-2">
            <button class="btn btn-sm btn-primary" id="addWorkItemBtn" data-bs-toggle="modal" data-bs-target="#workModal">
              + Add
            </button>
          </div>
        </div>

        <div class="work-item-tree-header text-muted small fw-bold border-bottom pb-1 mb-2">
          <span>Title</span>
          <span>Oh!</span>
          <span>Time</span>
          <span>Status</span>
          <span>Time Box</span>
          <span>Actions</span>
        </div>

        <div id="workItemsList">
          <p class="text-center text-muted">No work items</p>
        </div>
      </div>

      <!-- Divider -->
      <div class="split-pane-divider" id="dailiesDivider"></div>

      <!-- Right Pane: Work Item Editor (Hidden by default) -->
      <div class="split-pane-right hidden" id="workItemEditorPane">
        <div class="split-pane-editor">
          <div class="split-pane-editor-title" id="workItemEditorDisplayTitle">Select a work item to edit</div>
          <form id="workItemEditorForm">
            <input type="hidden" id="workItemEditorId" name="workId">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="mb-3">
              <div class="d-flex gap-2 align-items-end">
                <div class="flex-grow-1">
                  <label for="workItemEditorTitle" class="form-label">Title *</label>
                  <input type="text" class="form-control" id="workItemEditorTitle" name="title" required>
                </div>
                <div>
                  <label class="form-label d-block">Oh!</label>
                  <input type="hidden" id="workItemEditorEmoji" name="emoji">
                  <button type="button" class="btn btn-outline-secondary emoji-field-btn text-muted" id="workItemEditorEmojiBtn" data-action="pick-emoji-field" data-input="workItemEditorEmoji">Pick</button>
                </div>
              </div>
            </div>

            <div class="mb-3">
              <label for="workItemEditorDescription" class="form-label">Description</label>
              <textarea class="form-control" id="workItemEditorDescription" name="description" rows="3"></textarea>
            </div>

            <div class="mb-3">
              <label for="workItemEditorStatus" class="form-label">Status</label>
              <select class="form-select" id="workItemEditorStatus" name="status">
                <option value="">Not Started</option>
                <option value="in_progress">In Progress</option>
                <option value="blocked">Blocked</option>
                <option value="completed">Completed</option>
              </select>
            </div>

            <div class="mb-3">
              <label for="workItemEditorTimeBox" class="form-label">Time Box (hours)</label>
              <input type="number" class="form-control" id="workItemEditorTimeBox" name="time_box" min="0" step="0.5">
            </div>

            <div class="d-flex gap-2">
              <button type="button" class="btn btn-primary" id="saveWorkItemEditorBtn">Save</button>
              <button type="button" class="btn btn-secondary" id="closeWorkItemEditorBtn">Close</button>
            </div>
          </form>
        </div>
      </div>
      </div>
    </div>
  </div>
</div>

<!-- Work Item Modal -->
<div class="modal fade" id="workModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Add Item to Dailies</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <!-- Tabs for different item types -->
        <ul class="nav nav-tabs mb-3" id="addItemTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="project-tab" data-bs-toggle="tab" data-bs-target="#project-content" type="button" role="tab" aria-controls="project-content" aria-selected="true">Project</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="task-tab" data-bs-toggle="tab" data-bs-target="#task-content" type="button" role="tab" aria-controls="task-content" aria-selected="false">Task</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="ticket-tab" data-bs-toggle="tab" data-bs-target="#ticket-content" type="button" role="tab" aria-controls="ticket-content" aria-selected="false">Ticket</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="idea-tab" data-bs-toggle="tab" data-bs-target="#idea-content" type="button" role="tab" aria-controls="idea-content" aria-selected="false">Brainstorm</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="template-tab" data-bs-toggle="tab" data-bs-target="#template-content" type="button" role="tab" aria-controls="template-content" aria-selected="false">Template</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="goal-tab" data-bs-toggle="tab" data-bs-target="#goal-content" type="button" role="tab" aria-controls="goal-content" aria-selected="false">Goal</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="todo-tab" data-bs-toggle="tab" data-bs-target="#todo-content" type="button" role="tab" aria-controls="todo-content" aria-selected="false">To Do</button>
          </li>
        </ul>

        <div class="tab-content" id="addItemTabContent">
          <!-- Project Tab -->
          <div class="tab-pane fade show active" id="project-content" role="tabpanel" aria-labelledby="project-tab">
            <button type="button" class="btn btn-sm btn-outline-primary mb-3" data-action="create-new-item" data-type="priority">+ Create New Project</button>
            <div id="projectsList" class="list-group">
              <p class="text-muted small">Loading projects...</p>
            </div>
          </div>

          <!-- Task Tab -->
          <div class="tab-pane fade" id="task-content" role="tabpanel" aria-labelledby="task-tab">
            <button type="button" class="btn btn-sm btn-outline-primary mb-3" data-action="create-new-item" data-type="task">+ Create New Task</button>
            <div id="tasksList" class="list-group">
              <p class="text-muted small">Loading tasks...</p>
            </div>
          </div>

          <!-- Ticket Tab -->
          <div class="tab-pane fade" id="ticket-content" role="tabpanel" aria-labelledby="ticket-tab">
            <button type="button" class="btn btn-sm btn-outline-primary mb-3" data-action="create-new-item" data-type="ticket">+ Create New Ticket</button>
            <div id="ticketsList" class="list-group">
              <p class="text-muted small">Loading tickets...</p>
            </div>
          </div>

          <!-- Brainstorm Tab -->
          <div class="tab-pane fade" id="idea-content" role="tabpanel" aria-labelledby="idea-tab">
            <button type="button" class="btn btn-sm btn-outline-primary mb-3" data-action="create-new-item" data-type="idea">+ Create New Brainstorm</button>
            <div id="ideaList" class="list-group">
              <p class="text-muted small">Loading brainstorms...</p>
            </div>
          </div>

          <!-- Template Tab -->
          <div class="tab-pane fade" id="template-content" role="tabpanel" aria-labelledby="template-tab">
            <button type="button" class="btn btn-sm btn-outline-primary mb-3" data-action="create-new-item" data-type="template">+ Create New Template</button>
            <div id="templatesList" class="list-group">
              <p class="text-muted small">Loading templates...</p>
            </div>
          </div>

          <!-- Goal Tab -->
          <div class="tab-pane fade" id="goal-content" role="tabpanel" aria-labelledby="goal-tab">
            <button type="button" class="btn btn-sm btn-outline-primary mb-3" data-action="create-new-item" data-type="goal">+ Create New Goal</button>
            <div id="goalsList" class="list-group">
              <p class="text-muted small">Loading goals...</p>
            </div>
          </div>

          <!-- To Do Tab -->
          <div class="tab-pane fade" id="todo-content" role="tabpanel" aria-labelledby="todo-tab">
            <button type="button" class="btn btn-sm btn-outline-primary mb-3" data-action="create-new-item" data-type="todo">+ Create New To Do</button>
            <div id="todosList" class="list-group">
              <p class="text-muted small">Loading to dos...</p>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
      </div>
    </div>
  </div>
</div>

<style>
  .drawer-layout {
    position: relative;
  }

  .drawer-panel.open {
    transform: translateX(0) !important;
  }

  .drawer-panel.open ~ .split-pane-container {
    margin-left: 220px;
  }

  .work-item-tree-header {
    display: grid;
    grid-template-columns: 1fr 40px 50px 100px 70px 84px;
    align-items: center;
    gap: 8px;
  }

  .work-item {
    border: 1px solid #dee2e6;
    border-radius: 4px;
    margin-bottom: 8px;
  }

  .work-item-header {
    display: grid;
    grid-template-columns: 1fr 40px 50px 100px 70px 84px;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    cursor: move;
    user-select: none;
  }

  .work-item-header.dragging-item {
    opacity: 0.5;
  }

  .work-item-header:hover {
    background: #f8f9fa;
  }

  .work-item.drag-over > .work-item-header {
    background: #e7f3ff;
    outline: 2px dashed #007bff;
    outline-offset: -2px;
  }

  .work-item-toggle {
    width: 1rem;
    display: inline-block;
    text-align: center;
    color: #666;
    transition: transform 0.15s ease;
  }

  .work-item.expanded > .work-item-header .work-item-toggle {
    transform: rotate(90deg);
  }

  .work-item-title-cell {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  .work-item-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .work-item-emoji {
    text-align: center;
    width: 40px;
    cursor: pointer;
  }

  .work-item-start-time {
    text-align: center;
    min-width: 50px;
    font-size: 0.9rem;
    color: #666;
  }

  .work-item-status-badge {
    text-align: center;
    min-width: 90px;
    cursor: pointer;
  }

  .work-item-timebox-badge {
    text-align: center;
    min-width: 60px;
    cursor: pointer;
  }

  .work-item-actions {
    display: flex;
    gap: 4px;
    justify-content: flex-end;
  }

  .work-item-children {
    display: none;
    padding-left: 10px;
  }

  .work-item.expanded > .work-item-children {
    display: block;
  }

  #workItemsList {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  #dailiesCenterPane.work-items-drop-target {
    outline: 2px dashed #007bff;
    outline-offset: -2px;
    border-radius: 4px;
  }
</style>

<script src="/js/dailies.js"></script>
