<div class="row" style="height: 70vh;">
  <!-- Left Column: Calendar -->
  <div class="col-md-3" style="overflow-y: auto; border-right: 1px solid #dee2e6; padding: 20px;">
    <div id="calendar" style="font-size: 0.9rem;"></div>
  </div>

  <!-- Middle Column: Work Items -->
  <div class="col-md-6" style="overflow-y: auto;">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h6>Work Items for <span id="selectedDateDisplay"></span> <span id="dailyTimeTotal" class="text-muted small fw-normal"></span></h6>
      <div class="d-flex gap-2">
        <button class="btn btn-sm btn-secondary" id="pasteEmailBtn" title="Paste an email (Ctrl+V)">
          📋 Paste Email
        </button>
        <button class="btn btn-sm btn-primary" id="addWorkItemBtn" data-bs-toggle="modal" data-bs-target="#workModal">
          + Add
        </button>
      </div>
    </div>

    <div class="work-item-tree-header text-muted small fw-bold border-bottom pb-1 mb-2">
      <span>Title</span>
      <span>Oh!</span>
      <span>Status</span>
      <span>Time Box</span>
      <span>Actions</span>
    </div>

    <div id="workItemsList">
      <p class="text-center text-muted">No work items</p>
    </div>
  </div>

  <!-- Right Column: Priorities, Goals & Areas -->
  <div class="col-md-3" style="overflow-y: auto; border-left: 1px solid #dee2e6; padding-left: 15px;">
    <ul class="nav nav-tabs nav-fill mb-2" id="rightPanelTabs" style="font-size: 0.8rem;">
      <li class="nav-item">
        <button class="nav-link px-1" data-panel-tab="priorities" type="button">Projects</button>
      </li>
      <li class="nav-item">
        <button class="nav-link px-1" data-panel-tab="goals" type="button">Goals</button>
      </li>
      <li class="nav-item">
        <button class="nav-link px-1" data-panel-tab="areas" type="button">Categories</button>
      </li>
      <li class="nav-item">
        <button class="nav-link active px-1" data-panel-tab="templates" type="button">Templates</button>
      </li>
    </ul>

    <div id="prioritiesListRight" class="right-panel-list d-none" data-panel="priorities">
      <small class="text-muted">No priorities</small>
    </div>
    <div id="goalsListRight" class="right-panel-list d-none" data-panel="goals">
      <small class="text-muted">No goals</small>
    </div>
    <div id="areasListRight" class="right-panel-list d-none" data-panel="areas">
      <small class="text-muted">No categories</small>
    </div>
    <div id="templatesListRight" class="right-panel-list" data-panel="templates">
      <small class="text-muted">No templates</small>
    </div>
  </div>
</div>

<!-- Work Item Modal -->
<div class="modal fade" id="workModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Work Item Form</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="workForm">
          <input type="hidden" id="workId" name="workId">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="mb-3">
            <div class="d-flex gap-2 align-items-end">
              <div class="flex-grow-1">
                <label for="workTitle" class="form-label">Title *</label>
                <input type="text" class="form-control" id="workTitle" name="title" required>
              </div>
              <div>
                <label class="form-label d-block">Oh!</label>
                <input type="hidden" id="workEmoji" name="emoji">
                <button type="button" class="btn btn-outline-secondary emoji-field-btn text-muted" id="workEmojiBtn" data-action="pick-emoji-field" data-input="workEmoji">Pick an emoji</button>
              </div>
            </div>
          </div>

          <div class="mb-3">
            <label for="workDescription" class="form-label">Description</label>
            <textarea class="form-control" id="workDescription" name="description" rows="3"></textarea>
          </div>

          <div class="mb-3">
            <label for="workNotes" class="form-label">Notes</label>
            <textarea class="form-control" id="workNotes" name="notes" rows="3"></textarea>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="saveWorkBtn">Save Work</button>
      </div>
    </div>
  </div>
</div>

<!-- Work Item Context Menu -->
<div id="workItemContextMenu" class="context-menu d-none">
  <button type="button" class="context-menu-item" data-menu-action="edit-notes"><i class="bi bi-sticky"></i> Add/Edit Notes</button>
  <button type="button" class="context-menu-item" data-menu-action="create-todo"><i class="bi bi-check2-square"></i> Create To Do</button>
  <button type="button" class="context-menu-item" data-menu-action="move-to"><i class="bi bi-calendar-event"></i> Move To...</button>
  <button type="button" class="context-menu-item" data-menu-action="clone-to"><i class="bi bi-calendar-plus"></i> Clone To...</button>
</div>

<!-- Calendar Drop Menu (shown after dropping a work item onto a calendar day) -->
<div id="calendarDropMenu" class="context-menu d-none">
  <button type="button" class="context-menu-item" data-drop-action="move"><i class="bi bi-calendar-event"></i> Move Work Item to Date</button>
  <button type="button" class="context-menu-item" data-drop-action="copy"><i class="bi bi-calendar-plus"></i> Copy Work Item to Date</button>
</div>

<!-- Calendar Day Context Menu (right-click a calendar cell) -->
<%
  const dayHighlightColors = [
    { key: 'red', hex: '#ffadad', label: 'Red' },
    { key: 'orange', hex: '#ffd6a5', label: 'Orange' },
    { key: 'yellow', hex: '#fdffb6', label: 'Yellow' },
    { key: 'green', hex: '#caffbf', label: 'Green' },
    { key: 'blue', hex: '#9bf6ff', label: 'Blue' },
    { key: 'indigo', hex: '#a0c4ff', label: 'Indigo' },
    { key: 'purple', hex: '#bdb2ff', label: 'Purple' },
    { key: 'pink', hex: '#ffc6ff', label: 'Pink' },
  ];
  const dayTextColors = [
    { key: 'red', hex: '#e63946', label: 'Red' },
    { key: 'orange', hex: '#ff8500', label: 'Orange' },
    { key: 'yellow', hex: '#ffd60a', label: 'Yellow' },
    { key: 'green', hex: '#06d6a0', label: 'Green' },
    { key: 'blue', hex: '#118ab2', label: 'Blue' },
    { key: 'indigo', hex: '#3a0ca3', label: 'Indigo' },
    { key: 'purple', hex: '#9d4edd', label: 'Purple' },
    { key: 'pink', hex: '#ff006e', label: 'Pink' },
  ];
%>
<div id="calendarDayContextMenu" class="context-menu d-none">
  <div id="calendarDayContextMenuScope" class="context-menu-scope text-muted small d-none"></div>
  <div class="context-menu-item context-menu-has-submenu">
    <i class="bi bi-palette"></i> Highlight Day
    <i class="bi bi-chevron-right context-submenu-caret"></i>
    <div class="context-submenu">
      <div class="highlight-color-grid">
        <% dayHighlightColors.forEach(c => { %>
          <button type="button" class="highlight-color-swatch" data-target="background" data-color="<%= c.hex %>" style="background-color: <%= c.hex %>;" title="<%= c.label %>" aria-label="Highlight day <%= c.label %>"></button>
        <% }) %>
      </div>
    </div>
  </div>
  <div class="context-menu-item context-menu-has-submenu">
    <i class="bi bi-fonts"></i> Text Color
    <i class="bi bi-chevron-right context-submenu-caret"></i>
    <div class="context-submenu">
      <div class="highlight-color-grid">
        <% dayTextColors.forEach(c => { %>
          <button type="button" class="highlight-color-swatch" data-target="text" data-color="<%= c.hex %>" style="background-color: <%= c.hex %>;" title="<%= c.label %>" aria-label="Set text color <%= c.label %>"></button>
        <% }) %>
      </div>
    </div>
  </div>
  <button type="button" class="context-menu-item" data-menu-action="clear-day-highlight"><i class="bi bi-x-circle"></i> Clear Highlight</button>
</div>

<!-- Emoji Picker Popover (shown by clicking the "Oh!" cell on a work item) -->
