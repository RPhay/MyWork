<div class="row mb-3">
  <div class="col-md-12">
    <div class="btn-group" role="group">
      <input type="radio" class="btn-check" name="viewMode" id="dayView" value="day" checked onchange="changeViewMode('day')">
      <label class="btn btn-outline-primary" for="dayView">Day View</label>

      <input type="radio" class="btn-check" name="viewMode" id="weekView" value="week" onchange="changeViewMode('week')">
      <label class="btn btn-outline-primary" for="weekView">Week View</label>
    </div>
  </div>
</div>

<div class="row" style="height: 70vh;">
  <!-- Left Column: Calendar -->
  <div class="col-md-3" style="overflow-y: auto; border-right: 1px solid #dee2e6;">
    <h6 class="mb-3">Select Date</h6>
    <div id="calendar" class="mb-4"></div>

    <div class="d-grid gap-2">
      <button class="btn btn-sm btn-secondary" onclick="previousDate()">← Previous Day</button>
      <button class="btn btn-sm btn-secondary" onclick="today()">Today</button>
      <button class="btn btn-sm btn-secondary" onclick="nextDate()">Next Day →</button>
    </div>
  </div>

  <!-- Middle Column: Work Items -->
  <div class="col-md-6" style="overflow-y: auto;">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h6>Work Items for <span id="selectedDateDisplay"></span></h6>
      <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#workModal" onclick="openNewWorkForm()">
        + Add
      </button>
    </div>

    <div class="table-responsive">
      <table class="table table-sm table-hover">
        <thead class="table-light">
          <tr>
            <th>Title</th>
            <th>Status</th>
            <th width="80">Actions</th>
          </tr>
        </thead>
        <tbody id="workItemsTableBody">
          <tr>
            <td colspan="3" class="text-center text-muted">No work items</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Right Column: Priorities & Goals -->
  <div class="col-md-3" style="overflow-y: auto; border-left: 1px solid #dee2e6;">
    <h6 class="mb-3">My Priorities</h6>
    <div id="prioritiesListRight" class="mb-4" style="max-height: 250px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 4px; padding: 10px;">
      <small class="text-muted">Loading...</small>
    </div>

    <h6 class="mb-3">My Goals</h6>
    <div id="goalsListRight" class="mb-4" style="max-height: 250px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 4px; padding: 10px;">
      <small class="text-muted">Loading...</small>
    </div>
  </div>
</div>

<!-- Work Item Modal -->
<div class="modal fade" id="workModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Work Item Form</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="workForm">
          <input type="hidden" id="workId" name="workId">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="mb-3">
            <label for="workDate" class="form-label">Date *</label>
            <input type="date" class="form-control" id="workDate" name="date" required>
          </div>

          <div class="mb-3">
            <label for="workTitle" class="form-label">Title *</label>
            <input type="text" class="form-control" id="workTitle" name="title" required>
          </div>

          <div class="mb-3">
            <label for="workDescription" class="form-label">Description</label>
            <textarea class="form-control" id="workDescription" name="description" rows="3"></textarea>
          </div>

          <div class="mb-3">
            <label for="workGoals" class="form-label">Associated Goals</label>
            <select class="form-select" id="workGoals" name="goals" multiple>
              <!-- Goals will be loaded via AJAX -->
            </select>
          </div>

          <div class="mb-3">
            <label for="workPriorities" class="form-label">Associated Priorities</label>
            <select class="form-select" id="workPriorities" name="priorities" multiple>
              <!-- Priorities will be loaded via AJAX -->
            </select>
          </div>

          <div class="mb-3">
            <label for="workSource" class="form-label">Data Source</label>
            <select class="form-select" id="workSource" name="source_id">
              <option value="">-- None --</option>
              <option value="1">Outlook Calendar</option>
              <option value="2">Azure DevOps</option>
              <option value="3">GitHub Commits</option>
              <option value="4">Outlook Email</option>
              <option value="5">Azure DevOps Commits</option>
              <option value="6">MS Teams Messages</option>
              <option value="7">Daily Notes</option>
              <option value="8">OneNote Priorities</option>
              <option value="9">ServiceNow</option>
            </select>
          </div>

          <div class="mb-3">
            <label for="workStatus" class="form-label">Status</label>
            <select class="form-select" id="workStatus" name="status">
              <option value="Not Started">Not Started</option>
              <option value="In Progress">In Progress</option>
              <option value="Complete">Complete</option>
            </select>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="saveWorkItem()">Save Work</button>
      </div>
    </div>
  </div>
</div>

<style>
  .priority-item, .goal-item {
    padding: 8px;
    margin-bottom: 5px;
    background: #f8f9fa;
    border: 1px solid #dee2e6;
    border-radius: 3px;
    cursor: move;
    font-size: 0.85rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .priority-item:hover, .goal-item:hover {
    background: #e9ecef;
  }

  .dragging-item {
    opacity: 0.5;
    background: #fff3cd;
  }
</style>

<script>
let currentViewMode = 'day';

function renderCalendar() {
  const today = new Date();
  const year = today.getFullYear();
  const month = today.getMonth();

  const firstDay = new Date(year, month, 1);
  const lastDay = new Date(year, month + 1, 0);
  const daysInMonth = lastDay.getDate();
  const startingDayOfWeek = firstDay.getDay();

  const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

  let html = `<h6>${monthNames[month]} ${year}</h6><table class="table table-sm" style="font-size: 0.85rem; margin-bottom: 0;">`;
  html += '<tr style="text-align: center;"><th>S</th><th>M</th><th>T</th><th>W</th><th>T</th><th>F</th><th>S</th></tr><tr>';

  for (let i = 0; i < startingDayOfWeek; i++) {
    html += '<td>&nbsp;</td>';
  }

  for (let day = 1; day <= daysInMonth; day++) {
    const date = new Date(year, month, day);
    const dateStr = date.toISOString().split('T')[0];
    const isToday = dateStr === new Date().toISOString().split('T')[0];
    const isSelected = dateStr === document.getElementById('selectedDate')?.value;

    html += `<td style="cursor: pointer; padding: 5px; text-align: center; ${isToday ? 'background: #e7f3ff; font-weight: bold;' : ''} ${isSelected ? 'background: #007bff; color: white;' : ''}" onclick="selectDate('${dateStr}')">${day}</td>`;

    if ((day + startingDayOfWeek) % 7 === 0 && day < daysInMonth) {
      html += '</tr><tr>';
    }
  }

  html += '</tr></table>';
  document.getElementById('calendar').innerHTML = html;
}

function selectDate(dateStr) {
  // Create hidden input if it doesn't exist
  let dateInput = document.getElementById('selectedDate');
  if (!dateInput) {
    dateInput = document.createElement('input');
    dateInput.type = 'hidden';
    dateInput.id = 'selectedDate';
    document.body.appendChild(dateInput);
  }
  dateInput.value = dateStr;
  loadWorkItems();
  renderCalendar();
  updateDateDisplay();
}

function updateDateDisplay() {
  const dateInput = document.getElementById('selectedDate');
  const dateStr = dateInput?.value || new Date().toISOString().split('T')[0];
  const date = new Date(dateStr + 'T00:00:00');
  const formatted = date.toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' });
  document.getElementById('selectedDateDisplay').textContent = formatted;
}

function changeViewMode(mode) {
  currentViewMode = mode;
  loadWorkItems();
}

async function loadWorkItems() {
  const dateInput = document.getElementById('selectedDate');
  if (!dateInput || !dateInput.value) {
    const today = new Date().toISOString().split('T')[0];
    selectDate(today);
    return;
  }

  const date = dateInput.value;
  const tbody = document.getElementById('workItemsTableBody');

  tbody.innerHTML = '<tr><td colspan="3" class="text-center text-muted">Loading...</td></tr>';

  try {
    const response = await fetch(`/api/work/date/${date}`);
    const result = await response.json();

    if (result.success && result.data.length > 0) {
      tbody.innerHTML = result.data.map(item => `
        <tr>
          <td>${item.title}</td>
          <td><span class="badge bg-${item.status === 'Complete' ? 'success' : item.status === 'In Progress' ? 'warning' : 'secondary'}">${item.status}</span></td>
          <td>
            <button class="btn btn-sm btn-info" onclick="editWorkItem(${item.id})">Edit</button>
            <button class="btn btn-sm btn-danger" onclick="deleteWorkItem(${item.id})">Del</button>
          </td>
        </tr>
      `).join('');
    } else {
      tbody.innerHTML = '<tr><td colspan="3" class="text-center text-muted">No work items</td></tr>';
    }
  } catch (error) {
    console.error('Error:', error);
    tbody.innerHTML = '<tr><td colspan="3" class="text-center text-danger">Error loading</td></tr>';
  }
}

async function loadPrioritiesAndGoals() {
  // Load priorities
  try {
    const prioResponse = await fetch('/api/priorities');
    const prioResult = await prioResponse.json();
    const prioritiesDiv = document.getElementById('prioritiesListRight');

    if (prioResult.success && prioResult.data.length > 0) {
      prioritiesDiv.innerHTML = prioResult.data.map(p => `
        <div class="priority-item" draggable="true" data-type="priority" data-id="${p.id}" onmouseenter="this.style.backgroundColor='#e9ecef'" onmouseleave="this.style.backgroundColor='#f8f9fa'">
          <span>${p.title}</span>
          <small class="text-muted">→</small>
        </div>
      `).join('');
      setupDragListeners();
    } else {
      prioritiesDiv.innerHTML = '<small class="text-muted">No priorities</small>';
    }
  } catch (error) {
    console.error('Error loading priorities:', error);
  }

  // Load goals
  try {
    const year = new Date().getFullYear();
    const goalResponse = await fetch(`/api/goals/year/${year}`);
    const goalResult = await goalResponse.json();
    const goalsDiv = document.getElementById('goalsListRight');

    if (goalResult.success && goalResult.data.length > 0) {
      goalsDiv.innerHTML = goalResult.data.map(g => `
        <div class="goal-item" draggable="true" data-type="goal" data-id="${g.id}" onmouseenter="this.style.backgroundColor='#e9ecef'" onmouseleave="this.style.backgroundColor='#f8f9fa'">
          <span>${g.name}</span>
          <small class="text-muted">→</small>
        </div>
      `).join('');
      setupDragListeners();
    } else {
      goalsDiv.innerHTML = '<small class="text-muted">No goals</small>';
    }
  } catch (error) {
    console.error('Error loading goals:', error);
  }
}

function setupDragListeners() {
  const draggables = document.querySelectorAll('[draggable="true"]');
  draggables.forEach(item => {
    item.addEventListener('dragstart', (e) => {
      e.dataTransfer.effectAllowed = 'copy';
      e.dataTransfer.setData('type', item.dataset.type);
      e.dataTransfer.setData('id', item.dataset.id);
      e.dataTransfer.setData('name', item.textContent.trim());
      item.classList.add('dragging-item');
    });

    item.addEventListener('dragend', (e) => {
      item.classList.remove('dragging-item');
    });
  });
}

function previousDate() {
  const dateInput = document.getElementById('selectedDate') || (() => {
    const input = document.createElement('input');
    input.type = 'hidden';
    input.id = 'selectedDate';
    input.value = new Date().toISOString().split('T')[0];
    document.body.appendChild(input);
    return input;
  })();

  const date = new Date(dateInput.value);
  date.setDate(date.getDate() - 1);
  dateInput.value = date.toISOString().split('T')[0];
  loadWorkItems();
  renderCalendar();
  updateDateDisplay();
}

function nextDate() {
  const dateInput = document.getElementById('selectedDate') || (() => {
    const input = document.createElement('input');
    input.type = 'hidden';
    input.id = 'selectedDate';
    input.value = new Date().toISOString().split('T')[0];
    document.body.appendChild(input);
    return input;
  })();

  const date = new Date(dateInput.value);
  date.setDate(date.getDate() + 1);
  dateInput.value = date.toISOString().split('T')[0];
  loadWorkItems();
  renderCalendar();
  updateDateDisplay();
}

function today() {
  const dateInput = document.getElementById('selectedDate') || (() => {
    const input = document.createElement('input');
    input.type = 'hidden';
    input.id = 'selectedDate';
    document.body.appendChild(input);
    return input;
  })();

  dateInput.value = new Date().toISOString().split('T')[0];
  loadWorkItems();
  renderCalendar();
  updateDateDisplay();
}

function openNewWorkForm() {
  document.getElementById('workId').value = '';
  const dateInput = document.getElementById('selectedDate');
  document.getElementById('workDate').value = dateInput?.value || new Date().toISOString().split('T')[0];
  document.getElementById('workForm').reset();
}

async function saveWorkItem() {
  const workId = document.getElementById('workId').value;

  const data = {
    date: document.getElementById('workDate').value,
    title: document.getElementById('workTitle').value,
    description: document.getElementById('workDescription').value,
    status: document.getElementById('workStatus').value,
    goal_ids: Array.from(document.getElementById('workGoals').selectedOptions).map(opt => opt.value),
    priority_ids: Array.from(document.getElementById('workPriorities').selectedOptions).map(opt => opt.value),
    source_id: document.getElementById('workSource').value || null
  };

  try {
    const url = workId ? `/api/work/${workId}` : '/api/work';
    const method = workId ? 'PUT' : 'POST';

    const response = await fetch(url, {
      method,
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': window.APP_CONFIG?.csrfToken
      },
      body: JSON.stringify(data)
    });

    const result = await response.json();
    if (result.success) {
      app.notify('Work item saved!', 'success');
      bootstrap.Modal.getInstance(document.getElementById('workModal')).hide();
      loadWorkItems();
    } else {
      app.notify('Error: ' + result.message, 'danger');
    }
  } catch (error) {
    console.error('Error:', error);
    app.notify('Error saving work item', 'danger');
  }
}

async function editWorkItem(workId) {
  try {
    const response = await fetch(`/api/work/${workId}`);
    const result = await response.json();
    const item = result.data;

    document.getElementById('workId').value = item.id;
    document.getElementById('workDate').value = item.date;
    document.getElementById('workTitle').value = item.title;
    document.getElementById('workDescription').value = item.description;
    document.getElementById('workStatus').value = item.status;

    const modal = new bootstrap.Modal(document.getElementById('workModal'));
    modal.show();
  } catch (error) {
    console.error('Error:', error);
    app.notify('Error loading work item', 'danger');
  }
}

async function deleteWorkItem(workId) {
  if (!await app.confirm('Delete this work item?')) return;

  try {
    const response = await fetch(`/api/work/${workId}`, {
      method: 'DELETE',
      headers: { 'X-CSRF-Token': window.APP_CONFIG?.csrfToken }
    });

    const result = await response.json();
    if (result.success) {
      app.notify('Work item deleted', 'success');
      loadWorkItems();
    } else {
      app.notify('Error deleting work item', 'danger');
    }
  } catch (error) {
    console.error('Error:', error);
    app.notify('Error deleting work item', 'danger');
  }
}

// Initialize on page load
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', function() {
    const today = new Date().toISOString().split('T')[0];
    const dateInput = document.createElement('input');
    dateInput.type = 'hidden';
    dateInput.id = 'selectedDate';
    dateInput.value = today;
    document.body.appendChild(dateInput);

    renderCalendar();
    updateDateDisplay();
    loadWorkItems();
    loadPrioritiesAndGoals();
  });
} else {
  const today = new Date().toISOString().split('T')[0];
  const dateInput = document.createElement('input');
  dateInput.type = 'hidden';
  dateInput.id = 'selectedDate';
  dateInput.value = today;
  document.body.appendChild(dateInput);

  renderCalendar();
  updateDateDisplay();
  loadWorkItems();
  loadPrioritiesAndGoals();
}
</script>
