<div style="display: flex; flex-direction: column; gap: 0; height: 70vh; position: relative;">
  <!-- The calendar's switch lives OUTSIDE the pane it controls, or hiding the
       calendar would hide the only way to bring it back. -->
  <div class="dailies-rail-head">
    <button type="button" class="btn btn-sm btn-outline-secondary" id="toggleDailiesCalendarBtn"
            title="Show or hide the calendar">
      <i class="bi bi-calendar3"></i> Calendar
    </button>
  </div>

  <!-- Outer Split Pane (Calendar | Content) -->
  <div class="split-pane-container" id="dailiesOuterSplitPane" style="flex: 1; display: flex; gap: 0; overflow: hidden;">
    <!-- Left Pane: Tabbed Calendar/Picker -->
    <div class="split-pane-left" id="dailiesCalendarPane" style="display: flex; flex-direction: column; overflow: hidden;">

      <!-- Tab Content -->
      <div class="tab-content" style="flex: 1; overflow: hidden;">
        <!-- Calendar Tab -->
        <div class="tab-pane fade show active" id="calendar-pane" role="tabpanel" aria-labelledby="calendar-tab" style="overflow-y: auto; padding: 15px; font-size: 0.9rem; height: 100%;">
          <div id="calendar"></div>
        </div>

        <!-- Work Picker Tab -->
        <!-- Work Picker removed: the rail already lists the day's work. -->
      </div>
    </div>

    <!-- Divider between calendar and work items -->
    <div class="split-pane-divider" id="dailiesOuterDivider"></div>

    <!-- Right Pane: Inner Split Pane (Work Items | Editor) -->
    <div class="split-pane-right" id="dailiesContentRight">
      <div class="split-pane-container" id="dailiesSplitPane" style="flex: 1; display: flex; gap: 0; overflow: hidden;">
      <!-- Center Pane: Work Items -->
      <div class="split-pane-left" id="dailiesCenterPane" style="overflow-y: auto; padding: 15px;">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h6>Work Items for <span id="selectedDateDisplay"></span> <span id="dailyTimeTotal" class="text-muted small fw-normal"></span></h6>
          <%# The + Add button is gone: work is put on a day by dragging it in
              from a typed page, not by creating a bare work item here. %>
        </div>

        <div class="work-item-tree-header text-muted small fw-bold border-bottom pb-1 mb-2">
          <span title="What the work is. Click a row to expand what is linked to it; double-click to edit.">Title</span>
          <span title="Oh! - flag this as something that came up unexpectedly, rather than planned work">Oh!</span>
          <span title="When the work is scheduled to start">Time</span>
          <span title="Not Started, In Progress or Complete. Click the badge on a row to cycle it.">Status</span>
          <span title="How long you intend to spend on this, in hours. Totals for the day show beside the date.">Time Box</span>
          <span title="Notes written by Claude for this item">Claude</span>
          <span title="Your own notes for this item">Notes</span>
          <span title="Remove this item from the day">Actions</span>
        </div>

        <%# Appears once two or more rows are selected, like the typed pages. %>
        <div id="dailiesSelectionBar" class="entity-selection-bar" hidden>
          <span id="dailiesSelectionCount">0 selected</span>
          <div class="btn-group" role="group" style="display: inline-flex; gap: 2px;">
            <button type="button" class="btn btn-sm btn-outline-danger" data-action="delete-selected-dailies">Delete</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="clear-dailies-selection">Clear</button>
          </div>
        </div>

        <div id="workItemsList">
          <p class="text-center text-muted">No work items</p>
        </div>
      </div>

      <!-- Divider -->
      <div class="split-pane-divider" id="dailiesDivider"></div>

      <!-- Right Pane: Work Item Editor (Hidden by default) -->
      <div class="split-pane-right hidden" id="workItemEditorPane">
        <div class="split-pane-editor">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <div class="split-pane-editor-title" id="workItemEditorDisplayTitle">Select a work item to edit</div>
            <div class="editor-actions-bar">
              <div class="btn-group" role="group" style="display: inline-flex; gap: 2px;">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="closeWorkItemEditorBtn">Revert</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="saveWorkItemEditorBtn" disabled>Save</button>
              </div>
            </div>
          </div>
          <form id="workItemEditorForm">
            <input type="hidden" id="workItemEditorId" name="workId">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="mb-3">
              <div class="d-flex gap-2 align-items-end">
                <div class="flex-grow-1">
                  <label for="workItemEditorTitle" class="form-label">Title *</label>
                  <input type="text" class="form-control" id="workItemEditorTitle" name="title" required>
                </div>
                <div>
                  <label class="form-label d-block">Oh!</label>
                  <input type="hidden" id="workItemEditorEmoji" name="emoji">
                  <button type="button" class="btn btn-outline-secondary emoji-field-btn text-muted" id="workItemEditorEmojiBtn" data-action="pick-emoji-field" data-input="workItemEditorEmoji" title="Choose an emoji to make this item easier to spot in the list">Pick</button>
                </div>
              </div>
            </div>

            <div class="mb-3">
              <label for="workItemEditorDescription" class="form-label">Description</label>
              <textarea class="form-control" id="workItemEditorDescription" name="description" rows="3"></textarea>
            </div>

            <div class="mb-3">
              <label class="form-label">Status</label>
              <!-- Every value on screen with a box round the current one, the
                   same control every typed page uses. It was a <select>, whose
                   options were "", in_progress, blocked and completed - none of
                   which are values this app stores. workItemService only accepts
                   'Not Started', 'In Progress' and 'Complete', so picking
                   anything but the first was rejected. The hidden input is what
                   the form reads, so the ids the JS drives still resolve. -->
              <div class="option-choice-row" role="radiogroup" aria-label="Status" data-status-picker="workItemEditorStatus">
                <button type="button" class="option-choice status-option status-role-todo selected"
                        data-action="pick-status" data-value="Not Started" role="radio" aria-checked="true">Not Started</button>
                <button type="button" class="option-choice status-option status-role-active"
                        data-action="pick-status" data-value="In Progress" role="radio" aria-checked="false">In Progress</button>
                <button type="button" class="option-choice status-option status-role-done"
                        data-action="pick-status" data-value="Complete" role="radio" aria-checked="false">Complete</button>
              </div>
              <input type="hidden" id="workItemEditorStatus" name="status" value="Not Started">
            </div>

            <div class="mb-3">
              <label for="workItemEditorTimeBox" class="form-label">Time Box (hours)</label>
              <input type="number" class="form-control" id="workItemEditorTimeBox" name="time_box" min="0" step="0.5">
            </div>

          </form>
        </div>
      </div>

      <!-- Right Pane: Child Item Editor (Hidden by default) -->
      <div class="split-pane-right hidden" id="childItemEditorPane">
        <div class="split-pane-editor">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <div>
              <div class="split-pane-editor-title" id="childItemEditorDisplayTitle">Select an item to edit</div>
              <small class="text-muted" id="childItemEditorTypeLabel"></small>
            </div>
            <div class="editor-actions-bar">
              <div class="btn-group" role="group" style="display: inline-flex; gap: 2px;">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="closeChildItemEditorBtn">Revert</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="saveChildItemEditorBtn" disabled>Save</button>
              </div>
            </div>
          </div>
          <form id="childItemEditorForm">
            <input type="hidden" id="childItemEditorId" name="id">
            <input type="hidden" id="childItemEditorType" name="type">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <!-- Universal fields -->
            <div class="mb-3">
              <label for="childItemEditorTitle" class="form-label">Title *</label>
              <input type="text" class="form-control" id="childItemEditorTitle" name="title" required>
            </div>

            <!-- For todos and tasks: notes/description -->
            <div class="mb-3" id="childItemEditorNotesField" style="display: none;">
              <label for="childItemEditorNotes" class="form-label">Notes</label>
              <textarea class="form-control" id="childItemEditorNotes" name="notes" rows="3"></textarea>
            </div>

            <!-- For priorities/areas: description -->
            <div class="mb-3" id="childItemEditorDescriptionField" style="display: none;">
              <label for="childItemEditorDescription" class="form-label">Description</label>
              <textarea class="form-control" id="childItemEditorDescription" name="description" rows="3"></textarea>
            </div>

            <!-- For todos/tasks: status -->
            <div class="mb-3" id="childItemEditorStatusField" style="display: none;">
              <label class="form-label">Status</label>
              <!-- Same control as above. These two values are the todo/task
                   vocabulary, which is not the work item one - kept as they
                   were, only the presentation changes. -->
              <div class="option-choice-row" role="radiogroup" aria-label="Status" data-status-picker="childItemEditorStatus">
                <button type="button" class="option-choice status-option status-role-todo selected"
                        data-action="pick-status" data-value="incomplete" role="radio" aria-checked="true">Incomplete</button>
                <button type="button" class="option-choice status-option status-role-done"
                        data-action="pick-status" data-value="complete" role="radio" aria-checked="false">Complete</button>
              </div>
              <input type="hidden" id="childItemEditorStatus" name="status" value="incomplete">
            </div>

            <!-- For goals: year -->
            <div class="mb-3" id="childItemEditorYearField" style="display: none;">
              <label for="childItemEditorYear" class="form-label">Year</label>
              <input type="number" class="form-control" id="childItemEditorYear" name="year">
            </div>

          </form>
        </div>
      </div>
      </div>
    </div>
  </div>

</div>


<style>
  /* `display: grid` beats the hidden attribute's UA rule, so hiding the header
     on an empty day needs saying explicitly. */
  .work-item-tree-header[hidden] {
    display: none;
  }

  .work-item-tree-header {
    display: grid;
    grid-template-columns: 1fr 40px 50px 100px 70px 40px 40px 84px;
    align-items: center;
    gap: 8px;
  }

  .work-item {
    border: 1px solid #dee2e6;
    border-radius: 4px;
    margin-bottom: 8px;
  }

  .work-item-header {
    display: grid;
    grid-template-columns: 1fr 40px 50px 100px 70px 40px 40px 84px;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    cursor: move;
    user-select: none;
  }

  .work-item-header.dragging-item {
    opacity: 0.5;
  }

  .work-item-header:hover {
    background: #f8f9fa;
  }

  .work-item.drag-over > .work-item-header {
    background: #e7f3ff;
    outline: 2px dashed #007bff;
    outline-offset: -2px;
  }

  .work-item-toggle {
    width: 1rem;
    display: inline-block;
    text-align: center;
    color: #666;
    transition: transform 0.15s ease;
  }

  .work-item.expanded > .work-item-header .work-item-toggle {
    transform: rotate(90deg);
  }

  .work-item-title-cell {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  .work-item-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .work-item-emoji {
    text-align: center;
    width: 40px;
    cursor: pointer;
  }

  .work-item-start-time {
    text-align: center;
    min-width: 50px;
    font-size: 0.9rem;
    color: #666;
  }

  .work-item-status-badge {
    text-align: center;
    min-width: 90px;
    cursor: pointer;
  }

  .work-item-timebox-badge {
    text-align: center;
    min-width: 60px;
    cursor: pointer;
  }


  .work-item-actions {
    display: flex;
    gap: 4px;
    justify-content: flex-end;
  }

  .work-item-children {
    display: none;
    padding-left: 10px;
  }

  .work-item.expanded > .work-item-children {
    display: block;
  }

  #workItemsList {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  #dailiesCenterPane.work-items-drop-target {
    outline: 2px dashed #007bff;
    outline-offset: -2px;
    border-radius: 4px;
  }
</style>

<!-- Work Item Context Menu -->
<div id="workItemContextMenu" class="context-menu d-none">
  <div class="context-menu-submenu-group">
    <button type="button" class="context-menu-item has-submenu" data-submenu="add-items">
      <i class="bi bi-plus-circle"></i> Add
      <i class="bi bi-chevron-right" style="float: right; font-size: 0.8rem;"></i>
    </button>
    <div id="add-items-submenu" class="context-menu-submenu d-none">
      <button type="button" class="context-menu-item" data-action="add-project"><i class="bi bi-collection"></i> Project</button>
      <button type="button" class="context-menu-item" data-action="add-area"><i class="bi bi-diagram-3"></i> Category</button>
      <button type="button" class="context-menu-item" data-action="add-goal"><i class="bi bi-bullseye"></i> Goal</button>
      <button type="button" class="context-menu-item" data-action="add-todo"><i class="bi bi-check2-square"></i> Todo</button>
      <button type="button" class="context-menu-item" data-action="add-task"><i class="bi bi-card-checklist"></i> Task</button>
      <button type="button" class="context-menu-item" data-action="add-ticket"><i class="bi bi-ticket"></i> Ticket</button>
      <button type="button" class="context-menu-item" data-action="add-idea"><i class="bi bi-lightbulb"></i> Idea</button>
    </div>
  </div>

  <div class="context-menu-submenu-group">
    <button type="button" class="context-menu-item has-submenu" data-submenu="create-items">
      <i class="bi bi-plus-circle"></i> Create
      <i class="bi bi-chevron-right" style="float: right; font-size: 0.8rem;"></i>
    </button>
    <div id="create-items-submenu" class="context-menu-submenu d-none">
      <button type="button" class="context-menu-item" data-action="create-project"><i class="bi bi-collection"></i> Project</button>
      <button type="button" class="context-menu-item" data-action="create-area"><i class="bi bi-diagram-3"></i> Category</button>
      <button type="button" class="context-menu-item" data-action="create-goal"><i class="bi bi-bullseye"></i> Goal</button>
      <button type="button" class="context-menu-item" data-action="create-todo"><i class="bi bi-check2-square"></i> Todo</button>
      <button type="button" class="context-menu-item" data-action="create-task"><i class="bi bi-card-checklist"></i> Task</button>
      <button type="button" class="context-menu-item" data-action="create-ticket"><i class="bi bi-ticket"></i> Ticket</button>
      <button type="button" class="context-menu-item" data-action="create-idea"><i class="bi bi-lightbulb"></i> Idea</button>
    </div>
  </div>

  <div class="context-menu-submenu-group" style="border-top: 1px solid #ddd; margin-top: 0.5rem; padding-top: 0.5rem;">
    <button type="button" class="context-menu-item" data-action="move-to">
      <i class="bi bi-arrow-left-right"></i> Move to Date
    </button>
    <button type="button" class="context-menu-item" data-action="clone-to">
      <i class="bi bi-files"></i> Copy to Date
    </button>
  </div>
</div>

<!-- Work Item Notes Modal -->
<div class="modal fade" id="workNotesModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header border-bottom">
        <h5 class="modal-title">Edit Notes</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="workNotesModalId">
        <textarea id="workNotesModalText" class="form-control" rows="6" placeholder="Add your notes here..."></textarea>
      </div>
      <div class="modal-footer border-top">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="saveWorkNotesBtn" title="Save these notes to the work item">Save</button>
      </div>
    </div>
  </div>
</div>
