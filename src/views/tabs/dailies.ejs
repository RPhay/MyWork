<div id="emojiPickerPopover" class="context-menu d-none">
  <ul class="nav nav-tabs nav-fill emoji-picker-tabs" id="emojiPickerTabs">
    <% emojiCategories.forEach((cat, i) => { %>
      <li class="nav-item">
        <button class="nav-link px-1 <%= i === 0 ? 'active' : '' %>" data-emoji-tab="<%= cat.key %>" type="button" title="<%= cat.label %>">
          <i class="bi <%= cat.icon %>"></i>
        </button>
      </li>
    <% }) %>
  </ul>
  <% emojiCategories.forEach((cat, i) => { %>
    <div class="emoji-picker-grid <%= i === 0 ? '' : 'd-none' %>" data-emoji-panel="<%= cat.key %>">
      <% if (i === 0) { %>
        <button type="button" class="emoji-picker-btn" data-emoji="" title="No emoji">
          <i class="bi bi-slash-circle text-muted"></i>
        </button>
      <% } %>
      <% cat.emojis.forEach(emoji => { %>
        <button type="button" class="emoji-picker-btn" data-emoji="<%= emoji %>"><%= emoji %></button>
      <% }) %>
    </div>
  <% }) %>
</div>

<!-- Move/Clone Daily Modal -->
<div class="modal fade" id="moveCloneModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
