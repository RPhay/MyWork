      <button type="button" class="context-menu-item" data-action="add-idea"><i class="bi bi-lightbulb"></i> Idea</button>
    </div>
  </div>

  <div class="context-menu-submenu-group">
    <button type="button" class="context-menu-item has-submenu" data-submenu="create-items">
      <i class="bi bi-plus-circle"></i> Create
      <i class="bi bi-chevron-right" style="float: right; font-size: 0.8rem;"></i>
    </button>
    <div id="create-items-submenu" class="context-menu-submenu d-none">
      <button type="button" class="context-menu-item" data-action="create-project"><i class="bi bi-collection"></i> Project</button>
      <button type="button" class="context-menu-item" data-action="create-area"><i class="bi bi-diagram-3"></i> Category</button>
      <button type="button" class="context-menu-item" data-action="create-goal"><i class="bi bi-bullseye"></i> Goal</button>
      <button type="button" class="context-menu-item" data-action="create-todo"><i class="bi bi-check2-square"></i> Todo</button>
      <button type="button" class="context-menu-item" data-action="create-task"><i class="bi bi-card-checklist"></i> Task</button>
      <button type="button" class="context-menu-item" data-action="create-ticket"><i class="bi bi-ticket"></i> Ticket</button>
      <button type="button" class="context-menu-item" data-action="create-idea"><i class="bi bi-lightbulb"></i> Idea</button>
    </div>
  </div>

  <div class="context-menu-submenu-group" style="border-top: 1px solid #ddd; margin-top: 0.5rem; padding-top: 0.5rem;">
    <button type="button" class="context-menu-item" data-action="move-to">
      <i class="bi bi-arrow-left-right"></i> Move to Date
    </button>
    <button type="button" class="context-menu-item" data-action="clone-to">
      <i class="bi bi-files"></i> Copy to Date
    </button>
  </div>
</div>

<!-- Daily Notes Modal -->
<div class="modal fade" id="workNotesModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header border-bottom">
        <h5 class="modal-title">Edit Notes</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="workNotesModalId">
        <textarea id="workNotesModalText" class="form-control" rows="6" placeholder="Add your notes here..."></textarea>
      </div>
      <div class="modal-footer border-top">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-sm btn-outline-success" id="saveWorkNotesBtn" title="Save these notes to the work item">Save</button>
      </div>
    </div>
  </div>
</div>

<!-- Restored 2026-08-21. These four blocks were dropped by 22f432a (the
     drawer/split-pane refactor) while the JS that drives them stayed. Every
     one has a live caller, and showEmojiPicker/showCalendarDropMenu do not
     null-guard, so clicking an "Oh!" cell threw. -->


<!-- Calendar Drop Menu (shown after dropping a work item onto a calendar day) -->
<div id="calendarDropMenu" class="context-menu d-none">
  <button type="button" class="context-menu-item" data-drop-action="move"><i class="bi bi-calendar-event"></i> Move Daily to Date</button>
  <button type="button" class="context-menu-item" data-drop-action="copy"><i class="bi bi-calendar-plus"></i> Copy Daily to Date</button>
</div>

<!-- Calendar Day Context Menu (right-click a calendar cell) -->
<%
  const dayHighlightColors = [
    { key: 'red', hex: '#ffadad', label: 'Red' },
    { key: 'orange', hex: '#ffd6a5', label: 'Orange' },
    { key: 'yellow', hex: '#fdffb6', label: 'Yellow' },
    { key: 'green', hex: '#caffbf', label: 'Green' },
    { key: 'blue', hex: '#9bf6ff', label: 'Blue' },
    { key: 'indigo', hex: '#a0c4ff', label: 'Indigo' },
    { key: 'purple', hex: '#bdb2ff', label: 'Purple' },
    { key: 'pink', hex: '#ffc6ff', label: 'Pink' },
  ];
  const dayTextColors = [
    { key: 'red', hex: '#e63946', label: 'Red' },
    { key: 'orange', hex: '#ff8500', label: 'Orange' },
    { key: 'yellow', hex: '#ffd60a', label: 'Yellow' },
    { key: 'green', hex: '#06d6a0', label: 'Green' },
    { key: 'blue', hex: '#118ab2', label: 'Blue' },
    { key: 'indigo', hex: '#3a0ca3', label: 'Indigo' },
    { key: 'purple', hex: '#9d4edd', label: 'Purple' },
    { key: 'pink', hex: '#ff006e', label: 'Pink' },
  ];
%>
<div id="calendarDayContextMenu" class="context-menu d-none">
  <div id="calendarDayContextMenuScope" class="context-menu-scope text-muted small d-none"></div>
  <div class="context-menu-item context-menu-has-submenu">
    <i class="bi bi-palette"></i> Highlight Day
    <i class="bi bi-chevron-right context-submenu-caret"></i>
    <div class="context-submenu">
      <div class="highlight-color-grid">
        <% dayHighlightColors.forEach(c => { %>
          <button type="button" class="highlight-color-swatch" data-target="background" data-color="<%= c.hex %>" style="background-color: <%= c.hex %>;" title="<%= c.label %>" aria-label="Highlight day <%= c.label %>"></button>
        <% }) %>
      </div>
    </div>
  </div>
  <div class="context-menu-item context-menu-has-submenu">
    <i class="bi bi-fonts"></i> Text Color
    <i class="bi bi-chevron-right context-submenu-caret"></i>
    <div class="context-submenu">
      <div class="highlight-color-grid">
        <% dayTextColors.forEach(c => { %>
          <button type="button" class="highlight-color-swatch" data-target="text" data-color="<%= c.hex %>" style="background-color: <%= c.hex %>;" title="<%= c.label %>" aria-label="Set text color <%= c.label %>"></button>
        <% }) %>
      </div>
    </div>
  </div>
  <button type="button" class="context-menu-item" data-menu-action="clear-day-highlight"><i class="bi bi-x-circle"></i> Clear Highlight</button>
</div>

