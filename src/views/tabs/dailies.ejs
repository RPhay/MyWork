<div class="drawer-layout" style="display: flex; gap: 0; height: 70vh; position: relative;">
  <!-- Vertical Tab (far left, always on top) -->
  <div class="drawer-tab" style="width: 30px; background: #f8f9fa; border-right: 1px solid #dee2e6; display: flex; align-items: center; justify-content: center; position: relative; z-index: 20;">
    <button class="drawer-toggle" id="dailiesAssociateItemsToggle" style="background: none; border: none; cursor: pointer; padding: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; flex-direction: column;">
      <span style="writing-mode: vertical-rl; text-orientation: mixed; transform: rotate(180deg); font-size: 11px; font-weight: 500; white-space: nowrap; color: #666; user-select: none;">Associate Items</span>
    </button>
  </div>

  <!-- Drawer Panel (Associate Items) - slides over content -->
  <div class="drawer-panel" id="dailiesAssociateItemsPanel" style="width: 220px; background: white; border-right: 1px solid #dee2e6; overflow-y: auto; padding: 15px; position: fixed; left: -220px; top: 0; bottom: 0; z-index: 15; transition: left 0.3s ease;">
    <div style="margin-bottom: 15px;">
      <h6 class="mb-3">Associate Items</h6>

        <ul class="nav nav-tabs nav-fill mb-2" id="dailiesAssociateTabs" style="font-size: 0.8rem;">
          <li class="nav-item">
            <button class="nav-link active px-1" data-panel-tab="projects" type="button">Projects</button>
          </li>
          <li class="nav-item">
            <button class="nav-link px-1" data-panel-tab="goals" type="button">Goals</button>
          </li>
          <li class="nav-item">
            <button class="nav-link px-1" data-panel-tab="areas" type="button">Categories</button>
          </li>
          <li class="nav-item">
            <button class="nav-link px-1" data-panel-tab="templates" type="button">Templates</button>
          </li>
        </ul>

        <div id="prioritiesListRight" class="right-panel-list small" data-panel="projects">
          <small class="text-muted">No projects</small>
        </div>
        <div id="goalsListRight" class="right-panel-list small d-none" data-panel="goals">
          <small class="text-muted">No goals</small>
        </div>
        <div id="areasListRight" class="right-panel-list small d-none" data-panel="areas">
          <small class="text-muted">No categories</small>
        </div>
        <div id="templatesListRight" class="right-panel-list small d-none" data-panel="templates">
          <small class="text-muted">No templates</small>
        </div>

        <!-- Data Sources Import Section -->
        <div style="margin-top: 15px; padding-top: 15px; border-top: 1px solid #dee2e6;">
          <div class="text-muted small fw-bold mb-2">Import from</div>
          <div id="dataSourcesIcons" style="display: flex; gap: 8px; flex-wrap: wrap;">
            <!-- Data source icons will be added here by JavaScript -->
          </div>
        </div>
      </div>
    </div>

  <!-- Calendar Section (left, always visible) -->
  <div style="width: 160px; background: white; border-right: 1px solid #dee2e6; overflow-y: auto; padding: 15px; font-size: 0.9rem;">
    <div id="calendar"></div>
  </div>

  <!-- Split Pane (Center + Right) -->
  <div class="split-pane-container" id="dailiesSplitPane" style="flex: 1; display: flex; gap: 0; overflow: hidden;">
    <!-- Center Pane: Work Items -->
      <div class="split-pane-left" id="dailiesCenterPane" style="overflow-y: auto;">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h6>Work Items for <span id="selectedDateDisplay"></span> <span id="dailyTimeTotal" class="text-muted small fw-normal"></span></h6>
          <div class="d-flex gap-2">
            <button class="btn btn-sm btn-primary" id="addWorkItemBtn" data-bs-toggle="modal" data-bs-target="#workModal">
              + Add
            </button>
          </div>
        </div>

        <div class="work-item-tree-header text-muted small fw-bold border-bottom pb-1 mb-2">
          <span>Title</span>
          <span>Oh!</span>
          <span>Status</span>
          <span>Time Box</span>
          <span>Actions</span>
        </div>

        <div id="workItemsList">
          <p class="text-center text-muted">No work items</p>
        </div>
      </div>

      <!-- Divider -->
      <div class="split-pane-divider" id="dailiesDivider"></div>

      <!-- Right Pane: Work Item Editor (Hidden by default) -->
      <div class="split-pane-right hidden" id="workItemEditorPane">
        <div class="split-pane-editor">
          <div class="split-pane-editor-title" id="workItemEditorTitle">Select a work item to edit</div>
          <form id="workItemEditorForm">
            <input type="hidden" id="workItemEditorId" name="workId">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="mb-3">
              <div class="d-flex gap-2 align-items-end">
                <div class="flex-grow-1">
                  <label for="workItemEditorTitle" class="form-label">Title *</label>
                  <input type="text" class="form-control" id="workItemEditorTitle" name="title" required>
                </div>
                <div>
                  <label class="form-label d-block">Oh!</label>
                  <input type="hidden" id="workItemEditorEmoji" name="emoji">
                  <button type="button" class="btn btn-outline-secondary emoji-field-btn text-muted" id="workItemEditorEmojiBtn" data-action="pick-emoji-field" data-input="workItemEditorEmoji">Pick</button>
                </div>
              </div>
            </div>

            <div class="mb-3">
              <label for="workItemEditorDescription" class="form-label">Description</label>
              <textarea class="form-control" id="workItemEditorDescription" name="description" rows="3"></textarea>
            </div>

            <div class="mb-3">
              <label for="workItemEditorStatus" class="form-label">Status</label>
              <select class="form-select" id="workItemEditorStatus" name="status">
                <option value="">Not Started</option>
                <option value="in_progress">In Progress</option>
                <option value="blocked">Blocked</option>
                <option value="completed">Completed</option>
              </select>
            </div>

            <div class="mb-3">
              <label for="workItemEditorTimeBox" class="form-label">Time Box (hours)</label>
              <input type="number" class="form-control" id="workItemEditorTimeBox" name="time_box" min="0" step="0.5">
            </div>

            <div class="d-flex gap-2">
              <button type="button" class="btn btn-primary" id="saveWorkItemEditorBtn">Save</button>
              <button type="button" class="btn btn-secondary" id="closeWorkItemEditorBtn">Close</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Work Item Modal -->
<div class="modal fade" id="workModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Work Item Form</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="workForm">
          <input type="hidden" id="workId" name="workId">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="mb-3">
            <div class="d-flex gap-2 align-items-end">
              <div class="flex-grow-1">
                <label for="workTitle" class="form-label">Title *</label>
                <input type="text" class="form-control" id="workTitle" name="title" required>
              </div>
              <div>
                <label class="form-label d-block">Oh!</label>
                <input type="hidden" id="workEmoji" name="emoji">
                <button type="button" class="btn btn-outline-secondary emoji-field-btn text-muted" id="workEmojiBtn" data-action="pick-emoji-field" data-input="workEmoji">Pick an emoji</button>
              </div>
            </div>
          </div>

          <div class="mb-3">
            <label for="workDescription" class="form-label">Description</label>
            <textarea class="form-control" id="workDescription" name="description" rows="3"></textarea>
          </div>

          <div class="mb-3">
            <label for="workNotes" class="form-label">Notes</label>
            <textarea class="form-control" id="workNotes" name="notes" rows="2"></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label d-block">Status</label>
            <div class="d-flex flex-wrap gap-2" id="workItemStatus">
              <input type="radio" class="btn-check" name="workStatus" id="workStatusNotStarted" value="Not Started" autocomplete="off" checked>
              <label class="btn btn-outline-secondary btn-sm rounded-pill" for="workStatusNotStarted">Not Started</label>

              <input type="radio" class="btn-check" name="workStatus" id="workStatusInProgress" value="In Progress" autocomplete="off">
              <label class="btn btn-outline-secondary btn-sm rounded-pill" for="workStatusInProgress">In Progress</label>

              <input type="radio" class="btn-check" name="workStatus" id="workStatusBlocked" value="Blocked" autocomplete="off">
              <label class="btn btn-outline-secondary btn-sm rounded-pill" for="workStatusBlocked">Blocked</label>

              <input type="radio" class="btn-check" name="workStatus" id="workStatusComplete" value="Complete" autocomplete="off">
              <label class="btn btn-outline-secondary btn-sm rounded-pill" for="workStatusComplete">Complete</label>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label d-block">Time Box</label>
            <div class="d-flex flex-wrap gap-2" id="workItemTimeBox">
              <input type="radio" class="btn-check" name="workTimeBoxBubble" id="workTimeBoxNone" value="" autocomplete="off" checked>
              <label class="btn btn-outline-secondary btn-sm rounded-pill" for="workTimeBoxNone">No time box</label>

              <input type="radio" class="btn-check" name="workTimeBoxBubble" id="workTimeBox15" value="15" autocomplete="off">
              <label class="btn btn-outline-secondary btn-sm rounded-pill" for="workTimeBox15">15m</label>

              <input type="radio" class="btn-check" name="workTimeBoxBubble" id="workTimeBox30" value="30" autocomplete="off">
              <label class="btn btn-outline-secondary btn-sm rounded-pill" for="workTimeBox30">30m</label>

              <input type="radio" class="btn-check" name="workTimeBoxBubble" id="workTimeBox45" value="45" autocomplete="off">
              <label class="btn btn-outline-secondary btn-sm rounded-pill" for="workTimeBox45">45m</label>

              <input type="radio" class="btn-check" name="workTimeBoxBubble" id="workTimeBox60" value="60" autocomplete="off">
              <label class="btn btn-outline-secondary btn-sm rounded-pill" for="workTimeBox60">60m</label>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="saveWorkItemBtn">Save Work</button>
      </div>
    </div>
  </div>
</div>

<style>
  .drawer-layout {
    position: relative;
  }

  .drawer-panel.open {
    transform: translateX(0) !important;
  }

  .drawer-panel.open ~ .split-pane-container {
    margin-left: 220px;
  }

  .work-item-tree-header {
    display: grid;
    grid-template-columns: 1fr 40px 100px 70px 84px;
    align-items: center;
    gap: 8px;
  }

  .work-item {
    border: 1px solid #dee2e6;
    border-radius: 4px;
    margin-bottom: 8px;
  }

  .work-item-header {
    padding: 8px 10px;
    cursor: move;
    user-select: none;
  }

  .work-item-header.dragging-item {
    opacity: 0.5;
  }

  .work-item-header:hover {
    background: #f8f9fa;
  }

  .work-item.drag-over > .work-item-header {
    background: #e7f3ff;
    outline: 2px dashed #007bff;
    outline-offset: -2px;
  }

  .work-item-toggle {
    width: 1rem;
    display: inline-block;
    text-align: center;
    color: #666;
    transition: transform 0.15s ease;
  }

  .work-item.expanded > .work-item-header .work-item-toggle {
    transform: rotate(90deg);
  }

  .work-item-title-cell {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  .work-item-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .work-item-emoji {
    text-align: center;
    width: 40px;
    cursor: pointer;
  }

  .work-item-status-badge {
    text-align: center;
    min-width: 90px;
    cursor: pointer;
  }

  .work-item-timebox-badge {
    text-align: center;
    min-width: 60px;
    cursor: pointer;
  }

  .work-item-actions {
    display: flex;
    gap: 4px;
    justify-content: flex-end;
  }

  .work-item-children {
    display: none;
    padding-left: 10px;
  }

  .work-item.expanded > .work-item-children {
    display: block;
  }

  #workItemsList {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  #workItemsList.work-items-drop-target {
    outline: 2px dashed #007bff;
    outline-offset: -2px;
    border-radius: 4px;
  }
</style>

<script src="/js/dailies.js"></script>
