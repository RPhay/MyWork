<div class="row">
  <div class="col-md-12">
    <h4>Backup &amp; Restore</h4>
    <p class="text-muted">
      Export the full contents of this database to a file, or import a previously
      exported file into this database.
    </p>
  </div>
</div>

<div class="row g-4">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">Export</div>
      <div class="card-body">
        <p>Downloads a JSON file containing everything in this MyWork database - projects, categories, goals, work items, templates, to dos, and their associations.</p>
        <a class="btn btn-primary" href="/api/backup/export" download>
          <i class="bi bi-download"></i> Export Database
        </a>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card">
      <div class="card-header">Import</div>
      <div class="card-body">
        <p class="text-danger">
          <i class="bi bi-exclamation-triangle-fill"></i>
          Importing <strong>replaces everything currently in this database</strong> with the contents of the file. This cannot be undone.
        </p>

        <div class="mb-3">
          <input type="file" class="form-control" id="importFileInput" accept="application/json,.json">
        </div>

        <div id="importResult" class="small mb-2"></div>

        <button type="button" class="btn btn-danger" id="importBackupBtn">
          <i class="bi bi-upload"></i> Import Database
        </button>
      </div>
    </div>
  </div>
</div>

<script src="/js/backup.js"></script>
