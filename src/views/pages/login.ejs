<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM"
      crossorigin="anonymous"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
      rel="stylesheet"
      integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+"
      crossorigin="anonymous"
    />
    <style>
      body {
        background: #f8f9fa;
      }
      .login-card {
        max-width: 420px;
        margin: 12vh auto;
      }
      .login-why {
        font-size: 0.8125rem;
        color: #6c757d;
      }
      .login-diag {
        font-size: 0.75rem;
        color: #6c757d;
      }
      .login-diag summary {
        cursor: pointer;
        user-select: none;
      }
      .login-diag code {
        color: #212529;
        word-break: break-all;
      }
      .diag-error {
        background: #f8d7da;
        border: 1px solid #f5c2c7;
        border-radius: 0.375rem;
        padding: 0.5rem 0.625rem;
        margin: 0.625rem 0;
      }
      .diag-error code {
        color: #58151c;
      }
      .diag-label {
        font-weight: 600;
        color: #58151c;
        margin-bottom: 0.125rem;
      }
      .diag-meta {
        margin-top: 0.25rem;
        opacity: 0.75;
      }
      .diag-list {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.125rem 0.75rem;
        margin: 0.625rem 0;
      }
      .diag-list dt {
        font-weight: 600;
      }
      .diag-list dd {
        margin: 0;
        min-width: 0;
      }
      .diag-hint {
        opacity: 0.85;
      }
    </style>
  </head>
  <body>
    <div class="login-card">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <h1 class="h4 mb-1"><%= appName %></h1>
          <p class="text-muted mb-4">Sign in to continue.</p>

          <% if (error) { %>
          <div class="alert alert-danger py-2" role="alert">
            <%= error === 'profile-gone'
              ? 'The profile you were signed in as no longer exists, so you have been signed out. Signing in again will match you to a profile by your email address.'
              : error === 'no-session'
              ? 'Your session was not returned by the browser, so the sign-in could not be completed. This usually means cookies are blocked for this site, or the sign-in took longer than the session timeout.'
              : error === 'state-mismatch'
                ? 'That sign-in could not be verified. Please try again.'
                : error === 'no-code'
                  ? 'Microsoft did not return an authorization code.'
                  : error === 'sign-in-failed'
                    ? 'Sign-in failed. Check the tenant configuration and try again.'
                    : error %>
          </div>
          <% } %>

          <a href="/auth/start" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2">
            <i class="bi bi-microsoft"></i>
            Sign in with Microsoft
          </a>

          <!-- Why this page is here at all. Without it, "SSO is off" and "SSO
               is broken" look identical from the browser, which is the exact
               failure the three-state SSO_MODE exists to prevent. -->
          <hr class="my-4" />
          <p class="login-why mb-2"><%= reason %></p>

          <%# What Microsoft actually said, and what this machine is
              configured with. A sign-in failure is nearly always a mismatch
              between the two, and without this the only way to see it was
              the server's stdout. The client SECRET is never rendered - only
              whether one is set. %>
          <details class="login-diag" <%= lastError ? 'open' : '' %>>
            <summary>Diagnostics</summary>

            <% if (lastError && lastError.detail) { %>
            <div class="diag-error">
              <div class="diag-label">Microsoft returned</div>
              <code><%= lastError.detail %></code>
              <div class="diag-meta"><%= lastError.stage %> · <%= lastError.at %></div>
            </div>
            <% } %>

            <dl class="diag-list">
              <dt>SSO_MODE</dt><dd><code><%= diagnostics.mode %></code></dd>
              <dt>Tenant</dt>
              <dd><code><%= diagnostics.tenantId || 'not set' %></code></dd>
              <dt>Client ID</dt>
              <dd><code><%= diagnostics.clientId || 'not set' %></code></dd>
              <dt>Client secret</dt>
              <dd><code><%= diagnostics.hasSecret ? 'set' : 'NOT SET' %></code></dd>
              <dt>Redirect URI</dt>
              <dd><code><%= diagnostics.redirectUri || 'not set' %></code></dd>
            </dl>

            <p class="diag-hint mb-0">
              The redirect URI must match the Entra app registration exactly —
              scheme, port and path, registered under <em>Web</em>, not SPA.
              Values come from <code>.env.local</code>; restart the server
              after changing them.
            </p>
          </details>
        </div>
      </div>
    </div>
  </body>
</html>
