<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MyWork Dashboard</title>
  <!-- SVG so it stays sharp at every tab and bookmark size, and so the icon is
       one file rather than a pile of pngs. -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/favicon.svg">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"
    integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+" crossorigin="anonymous">
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.0/dist/quill.snow.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <!-- The shared confirm/prompt/alert dialog is built by main.js on whichever
       page calls it, so its stylesheet belongs on every page that can - it was
       only on settings.ejs, which is why a multi-line dialog here collapsed. -->
  <link rel="stylesheet" href="/css/modals.css">

  <style>
  /* Focus-bar/monitor/chip styling lives in main.css now, shared with every
     page that includes the navbar - see the "Focus bar" section there. */
  .trash-overlay {
    position: fixed;
    inset: 0;
    z-index: 2000;
    background: rgba(15, 18, 24, 0.42);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 10vh;
  }

  .trash-panel {
    width: min(40rem, 94vw);
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.28);
    overflow: hidden;
  }

  .trash-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border-bottom: 1px solid #e9ecef;
  }

  .trash-body { max-height: 26rem; overflow-y: auto; }

  .trash-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border-bottom: 1px solid #f1f3f5;
  }

  .trash-row:last-child { border-bottom: none; }
  .trash-icon { width: 20px; text-align: center; flex: none; }
  .trash-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .trash-title { overflow-wrap: anywhere; }
  .trash-meta { font-size: 0.75rem; color: #6c757d; }

  /* Search palette. Deliberately plain: it is read at speed and dismissed. */
  .cmdk-overlay {
    position: fixed;
    inset: 0;
    z-index: 2000;
    background: rgba(15, 18, 24, 0.42);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 12vh;
  }

  .cmdk {
    width: min(38rem, 92vw);
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.28);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .cmdk-input {
    border: 0;
    border-bottom: 1px solid #e9ecef;
    padding: 14px 16px;
    font-size: 1rem;
    outline: none;
    width: 100%;
  }

  .cmdk-list { max-height: 22rem; overflow-y: auto; }

  .cmdk-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 16px;
    cursor: pointer;
  }

  .cmdk-row.active { background: #eef4ff; }
  .cmdk-icon { width: 20px; text-align: center; flex: none; }
  .cmdk-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }

  .cmdk-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* Says WHY a record matched when the hit was in a field rather than a name. */
  .cmdk-why {
    font-size: 0.75rem;
    color: #6c757d;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cmdk-type {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #868e96;
    flex: none;
  }

  .cmdk-hint { padding: 16px; color: #868e96; font-size: 0.9rem; text-align: center; }

  .cmdk-foot {
    display: flex;
    gap: 14px;
    padding: 8px 16px;
    border-top: 1px solid #e9ecef;
    background: #f8f9fa;
    font-size: 0.72rem;
    color: #6c757d;
  }

  .cmdk-foot kbd {
    border: 1px solid #dee2e6;
    border-bottom-width: 2px;
    border-radius: 3px;
    padding: 0 4px;
    margin-right: 2px;
    background: #fff;
  }

  /* A record opened from search, so the eye lands on it. */
  .entity-row.search-hit {
    animation: search-hit-fade 2.4s ease-out;
  }

  @keyframes search-hit-fade {
    0%, 40% { background: #fff3cd; }
    100% { background: transparent; }
  }

  </style>
</head>
<body
  <%# NOT 'daily' as a fallback - Dailies is a rail and has no tab pane, so
      that value opened the app on a tab that does not exist, leaving the
      rail alone on screen. The server always sends a real slug now
      (appPreferencesService.resolveLandingTab); empty is better than a lie
      if it ever does not. %>
  data-active-tab="<%= activeTab || '' %>"
  data-startup-view="<%= typeof startupView !== 'undefined' && startupView ? startupView : '' %>"
  data-startup-kind="<%= typeof startupKind !== 'undefined' && startupKind ? startupKind : '' %>"
  data-current-year="<%= currentYear %>"
  data-csrf-token="<%= csrfToken %>"
  data-version="<%= version %>"
>
  <%- include('../components/dbHealthBanner.ejs') %>
  <%- include('../components/navbar.ejs') %>


  <div class="container-fluid mt-4">
    <%- include('../components/alerts.ejs') %>

    <!-- Tab Navigation (dynamically generated from entity types + special views) -->
    <ul class="nav nav-tabs mb-4" id="mainTabs" role="tablist" style="display: flex;">
      <%
        // Sort types: work_item (Dailies) always first; everything else,
        // including priority (Projects), is an editable type and renders
        // centered with the rest rather than pinned to a fixed position.
        // Exclude folder (internal type only, not a user-facing tab).
        // `is_visible` is the Settings > Entity Types enable/disable toggle, and
        // entityTypes already arrives ordered by order_index - the same value the
        // drag-to-reorder there writes - so tab order and Settings order are one
        // value seen two ways.
        const sortedTypes = entityTypes
          .filter(t => t.is_visible === undefined || t.is_visible)
          // 'daily' is NOT excluded here. It used to be, back when `daily` was a
          // separate read-only day-container type and Dailies itself was
          // `work_item`. Now that Dailies IS `daily`, excluding it removed the
          // Dailies tab from the bar entirely - the rail still rendered, so the
          // only symptom was a missing button.
          //
          // Excluded by type_category rather than a hardcoded slug list: the
          // slug list here never got 'ado_work_item' added when that type was
          // introduced, so Azure DevOps Work Items rendered as a real tab
          // despite SPECIAL_ENTITY_TYPES declaring it type_category 'external'
          // (systemEntityTypes.js) - exactly the non-editable, no-tab kind
          // 'outlook_calendar' already was. Any future external source type
          // is excluded automatically now, the way it should have been.
          .filter(t => t.type_category !== 'external' && t.slug !== 'folder')
          .sort((a, b) => {
            if (a.slug === 'daily') return -1;
            if (b.slug === 'daily') return 1;
            return 0;
          });
      %>
      <%
        // Render fixed-position tabs (Dailies only)
        // Rail types are shown beside whichever tab is open rather than as a
        // page of their own: Dailies (the day's work) and Templates (the
        // presets you drag from). Two panes show at a time and every pair is
        // legal except Templates + Priorities - see setupRails() in tabs.js.
        const RAIL_SLUGS = ['daily', 'template'];
        // Left-to-right order of the rail toggles in the tab bar. Priority
        // Board sits between Dailies and Templates. It is named here rather
        // than coming from sortedTypes because it is a view, not an entity
        // type - there is no row in entity_types to sort it by.
        const RAIL_TAB_ORDER = ['daily', 'priority-board', 'template'];
        const fixedTypes = sortedTypes.filter(t => RAIL_SLUGS.includes(t.slug));
        const editableTypes = sortedTypes.filter(t => !RAIL_SLUGS.includes(t.slug));
      %>

      <%# Dailies is not a page any more - it is a rail down the left of
          whichever tab you are on. Its button toggles that rail, so it carries
          data-rail-toggle instead of data-tab; tabs.js keys off that. %>
      <% RAIL_TAB_ORDER.forEach(railSlug => { %>
        <% if (railSlug === 'priority-board') { %>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="priority-board-tab" data-rail-toggle="priority-board" type="button" title="Priorities beside whatever you are working on. Drag rows in from a type tab or Dailies to place a reference to them.">
              <span class="tab-icon">📊</span> Priorities
            </button>
          </li>
        <% return; } %>
        <% const type = fixedTypes.find(t => t.slug === railSlug); %>
        <% if (!type) return; %>
        <li class="nav-item" role="presentation" data-rail-toggle="<%= type.slug %>" data-type-id="<%= type.id %>">
          <button class="nav-link type-tab type-<%= type.slug %>" id="<%= type.slug %>-tab" data-rail-toggle="<%= type.slug %>" type="button"
                  title="Show or hide <%= type.label %> beside the tab you are on. Drag rows from a type tab onto it to add them.">
            <% if (type.icon) { %>
              <span class="tab-icon"><%= type.icon %></span>
            <% } %>
            <%# The tab name is the type's own label - no per-slug override. A
                hardcoded 'Dailies' here meant Settings > Entity Types showed
                one name and the tab showed another, so renaming the type had
                no visible effect. %>
            <%= type.label %>
          </button>
        </li>
      <% }); %>

      <!-- Left spacer for centered editable types -->
      <li class="nav-item" style="flex: 1;"></li>

      <!-- Centered editable type tabs -->
      <% editableTypes.forEach(type => { %>
        <li class="nav-item" role="presentation" draggable="true" data-tab="<%= type.slug %>" data-type-id="<%= type.id %>">
          <button class="nav-link type-tab type-<%= type.slug %>" id="<%= type.slug %>-tab" data-tab="<%= type.slug %>" type="button" role="tab"
                  title="<%= type.label %>. Right-click a row for actions; drag rows onto Dailies to put them on a day.">
            <% if (type.icon) { %>
              <span class="tab-icon"><%= type.icon %></span>
            <% } %>
            <%= type.label %>
          </button>
        </li>
      <% }); %>

      <!-- Right spacer for centered editable types -->
      <li class="nav-item" style="flex: 1;"></li>

      <!-- Special View Tabs (right-aligned). Priorities is NOT here - it is
           a rail toggle rendered between Dailies and Templates above. -->
      <li class="nav-item" role="presentation" draggable="true">
        <%# data-fullwidth: this view wants the whole screen. Reporting is dense -
            tables, charts and a portfolio breakdown - and reading it beside a
            rail leaves neither pane usable. Opening it stands the rails down and
            restores them when you leave. %>
        <button class="nav-link" id="reporting-tab" data-tab="reporting" data-fullwidth="true" type="button" role="tab" title="Summaries of your work across a date range. Opens on its own - the Dailies and Templates panes step aside.">
          <span class="tab-icon">📈</span> Reporting
        </button>
      </li>
    </ul>

    <!-- The shell: Dailies down the left of whichever tab is showing, then the
         tab content itself. Dailies is no longer one of the tab panes - its
         button in the bar toggles this rail. -->
    <div class="app-shell" id="appShell">
      <%# Two panes are shown at a time, drawn from four participants in this
          fixed left-to-right order: Dailies, Templates, Priorities, the current
          type tab. Whichever two are on take the left and right slots -
            Dailies + type          -> Dailies   | type
            Templates + type        -> Templates | type
            Dailies + Templates     -> Dailies   | Templates   (the type is hidden)
            Dailies + Priorities    -> Dailies   | Priorities  (the type is hidden)
          Every pair is legal except Templates + Priorities. One click on a tab
          adds it beside what is showing; clicking a tab already showing beside
          another gives it the screen alone; clicking a tab showing ALONE brings
          its companion back - so one tab toggles a pair on and off. Both rails
          are always rendered so each initialises on page load; setupRails() in
          tabs.js decides what is shown. %>
      <aside class="app-rail" id="rail-daily" data-rail="daily">
        <%- include('../tabs/dailies.ejs') %>
      </aside>
      <div class="app-rail-divider" id="railDivider-daily"></div>
      <%# Templates is a typed page like any other now - same tree, same editor,
          same drag and drop. Its one difference is a type rule, not code: a
          template may contain any editable type (see systemEntityTypes.js), so
          rows dragged in from other tabs nest inside it. %>
      <aside class="app-rail" id="rail-template" data-rail="template">
        <%
          const templateType = sortedTypes.find(t => t.slug === 'template');
          if (templateType) {
        %>
          <%- include('../tabs/generic-entity-tab.ejs', {
                typeSlug: templateType.slug,
                typeName: templateType.label,
                typeNameSingular: templateType.label_singular || templateType.label
              }) %>
        <% } %>
      </aside>
      <div class="app-rail-divider" id="railDivider-template"></div>
      <aside class="app-rail" id="rail-priority-board" data-rail="priority-board">
        <%- include('../tabs/priority-board.ejs') %>
      </aside>
      <div class="app-rail-divider" id="railDivider-priority-board"></div>

    <!-- Tab Content (dynamically generated from entity types) -->
    <div class="tab-content" id="mainTabContent">
      <%
        // Map entity type slugs to custom templates (only Dailies, Templates, Priorities have custom implementations)
        // All other types use the generic entity template
        // Projects (priority) is NOT here: it runs on the generic entity tab
        // like every other typed page. Only Dailies (calendar/recurrence) and
        // Templates (instantiate-to-work-item) still have bespoke tabs.
        // Dailies and Templates are rails, rendered above - neither is a pane.
        // Every remaining type uses the generic tab.
        const customTemplateMap = {};

        // Special view tabs (not entity types, but views)
        const specialTabs = ['priority-board', 'reporting'];
      %>

      <% editableTypes.forEach(type => { %>
        <div id="tab-<%= type.slug %>" class="tab-content-pane">
          <%
            // Check if there's a custom template for this type
            const templateFile = customTemplateMap[type.slug];
            if (templateFile) {
          %>
            <%- include('../tabs/' + templateFile) %>
          <% } else { %>
            <!-- Generic entity tab for all other types -->
            <%- include('../tabs/generic-entity-tab.ejs', { typeSlug: type.slug, typeName: type.label, typeNameSingular: type.label_singular || type.label }) %>
          <% } %>
        </div>
      <% }); %>

      <!-- Special view tabs (not entity types) -->


      <!-- Reporting - Cross-type aggregation -->
      <div id="tab-reporting" class="tab-content-pane">
        <%- include('../tabs/reporting.ejs') %>
      </div>
    </div>
    </div><!-- /.app-shell -->
  </div>

  <%- include('../partials/footer.ejs') %>

  <!-- Context Database Configuration Modal -->
  <div class="modal fade" id="contextDatabaseConfigModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header border-bottom">
          <h5 class="modal-title">Configure Database</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p>This context doesn't have a database configured yet.</p>
          <p>You can either:</p>
          <ul>
            <li><strong>Use the System Database</strong> - quickly configure this context to use the same database as the system</li>
            <li><strong>Configure Manually</strong> - go to settings and set up a specific database for this context</li>
          </ul>
        </div>
        <div class="modal-footer border-top">
          <button type="button" class="btn btn-secondary" id="goToSettingsBtn">
            <i class="bi bi-gear"></i> Go to Settings
          </button>
          <button type="button" class="btn btn-primary" id="useSystemDatabaseBtn">
            <i class="bi bi-lightning-fill"></i> Use System Database
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- #confirmModal is built on demand by app._dialog in main.js, so confirm
       and prompt work identically on the dashboard and on Settings. -->

  <!-- Copy or reference: asked when a typed row is dropped onto a day. A
       reference points at the original record, so editing it edits the
       original; a copy is independent. Templates never ask - they are always
       copies. -->
  <div class="modal fade" id="copyOrReferenceModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header border-bottom">
          <h5 class="modal-title">Add <span id="copyOrReferenceName"></span></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p class="mb-2">How should this be added to the day?</p>
          <ul class="mb-0">
            <li><strong>Reference</strong> - points at the original. Editing it here changes the original record.</li>
            <li><strong>Copy</strong> - an independent duplicate, including anything nested inside it. Edits stay here.</li>
          </ul>
        </div>
        <div class="modal-footer border-top">
          <button type="button" class="btn btn-outline-secondary" id="copyOrReferenceCopyBtn">
            <i class="bi bi-files"></i> Copy
          </button>
          <button type="button" class="btn btn-primary" id="copyOrReferenceRefBtn">
            <i class="bi bi-link-45deg"></i> Reference
          </button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"
    integrity="sha384-BSxuMLxX+FCbTdYec3TbXlnMGEEM2QXTFdtDaveen71o+jswm2J36+xFqp8k4VHM" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/quill@2.0.0/dist/quill.js"></script>
  <script src="/js/dragDropUtils.js"></script>
  <script src="/js/splitPane.js"></script>
  <script src="/js/dataSourceAuth.js"></script>
  <script src="/js/genericEntity.js"></script>
  <script src="/js/generic-entity-init.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/focus-bar.js"></script>
  <script src="/js/command-palette.js"></script>
  <script src="/js/recently-deleted.js"></script>
  <script src="/js/tabs.js"></script>
  <script src="/js/forms.js"></script>
  <script src="/js/save-shortcut.js"></script>
  <!-- Dailies, split across files. dailies.js must stay LAST: it holds the
       DOMContentLoaded bootstrap and calls into all the others. Nothing else
       here has a load-order constraint: the last one was
       dailies-child-editor.js calling createChangeTracker() at top level, and
       that factory is gone - every editor uses GenericEntity's own change
       tracking, so there is one notion of "unsaved" rather than two. -->
  <script src="/js/dailies-calendar.js"></script>
  <script src="/js/dailies-items.js"></script>
  <script src="/js/dailies-menus.js"></script>
  <script src="/js/dailies-list-events.js"></script>
  <script src="/js/dailies-associations.js"></script>
  <script src="/js/dailies-child-editor.js"></script>
  <script src="/js/dailies-emoji.js"></script>
  <script src="/js/dailies-move-clone.js"></script>
  <script src="/js/dailies.js"></script>
</body>
</html>
