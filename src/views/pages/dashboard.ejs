<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MyWork Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"
    integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+" crossorigin="anonymous">
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.0/dist/quill.snow.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body
  data-active-tab="<%= activeTab || 'dailies' %>"
  data-current-year="<%= currentYear %>"
  data-csrf-token="<%= csrfToken %>"
  data-version="<%= version %>"
>
  <!-- Loaded first, before any tab partial's own trailing scripts (areas.js,
       editors/*.js), since those call createChangeTracker() at module-load time. -->
  <script src="/js/changeTracker.js"></script>
  <%- include('../components/dbHealthBanner.ejs') %>
  <%- include('../components/navbar.ejs') %>

  <div class="container-fluid mt-4">
    <%- include('../components/alerts.ejs') %>

    <!-- Tab Navigation (dynamically generated from entity types + special views) -->
    <ul class="nav nav-tabs mb-4" id="mainTabs" role="tablist">
      <% entityTypes.forEach(type => { %>
        <li class="nav-item" role="presentation" <% if (type.slug !== 'work_item') { %>draggable="true"<% } %>>
          <button class="nav-link" id="<%= type.slug %>-tab" data-tab="<%= type.slug %>" type="button" role="tab">
            <% if (type.icon) { %>
              <span><%= type.icon %></span>
            <% } %>
            <%= type.label %>
          </button>
        </li>
      <% }); %>

      <!-- Special View Tabs -->
      <li class="nav-item" role="presentation" draggable="true">
        <button class="nav-link" id="priority-board-tab" data-tab="priority-board" type="button" role="tab">
          <i class="bi bi-kanban"></i> Priorities
        </button>
      </li>
      <li class="nav-item" role="presentation" draggable="true">
        <button class="nav-link" id="reporting-tab" data-tab="reporting" type="button" role="tab">
          <i class="bi bi-bar-chart-line"></i> Reporting
        </button>
      </li>
    </ul>

    <!-- Tab Content (dynamically generated from entity types) -->
    <div class="tab-content" id="mainTabContent">
      <%
        // Map entity type slugs to template names and special handling
        const templateMap = {
          'work_item': 'dailies.ejs',
          'priority': 'my-priorities.ejs',
          'area': 'areas.ejs',
          'goal': 'yearly-goals.ejs',
          'to_do': 'todos.ejs',
          'task': 'tasks.ejs',
          'ticket': 'tickets.ejs',
          'idea': 'brainstorming.ejs',
          'template': 'templates.ejs'
        };

        // Special view tabs (not entity types, but views)
        const specialTabs = ['priority-board', 'reporting'];
      %>

      <% entityTypes.forEach(type => { %>
        <div id="tab-<%= type.slug %>" class="tab-content-pane">
          <%
            // Check if there's a type-specific template for backward compatibility
            const templateFile = templateMap[type.slug];
            if (templateFile) {
          %>
            <%- include('../tabs/' + templateFile) %>
          <% } else { %>
            <!-- Generic entity tab for custom types -->
            <%- include('../tabs/generic-entity-tab.ejs', { typeSlug: type.slug, typeName: type.label }) %>
          <% } %>
        </div>
      <% }); %>

      <!-- Special view tabs (not entity types) -->
      <!-- Priority Board - Kanban view of priorities -->
      <div id="tab-priority-board" class="tab-content-pane">
        <%- include('../tabs/priority-board.ejs') %>
      </div>

      <!-- Reporting - Cross-type aggregation -->
      <div id="tab-reporting" class="tab-content-pane">
        <%- include('../tabs/reporting.ejs') %>
      </div>
    </div>
  </div>

  <%- include('../partials/footer.ejs') %>

  <!-- Confirm Modal -->
  <div class="modal fade" id="confirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header border-bottom">
          <h5 class="modal-title" id="confirmModalTitle">Confirm Action</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" id="confirmModalMessage">
          Are you sure?
        </div>
        <div class="modal-footer border-top">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="confirmModalCancel">Cancel</button>
          <button type="button" class="btn btn-primary" id="confirmModalConfirm">Confirm</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"
    integrity="sha384-BSxuMLxX+FCbTdYec3TbXlnMGEEM2QXTFdtDaveen71o+jswm2J36+xFqp8k4VHM" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/quill@2.0.0/dist/quill.js"></script>
  <script src="/js/dragDropUtils.js"></script>
  <script src="/js/splitPane.js"></script>
  <script src="/js/dataSourceAuth.js"></script>
  <script src="/js/genericEntity.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/tabs.js"></script>
  <script src="/js/forms.js"></script>
  <script src="/js/dailies.js"></script>
</body>
</html>
