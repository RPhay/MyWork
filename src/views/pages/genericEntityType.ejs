<!-- Generic Entity Type Page - Used for all editable entity types -->
<div class="d-flex flex-column h-100" id="genericEntityContainer" data-type-slug="<%= typeSlug %>">
  <!-- Header -->
  <div class="border-bottom p-3 bg-light">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h2 class="mb-1"><%= typeName %></h2>
        <small class="text-muted"><%= typeDescription %></small>
      </div>
      <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-secondary" id="columnToggleBtn" title="Show/hide columns">
          <i class="bi bi-columns-gap"></i> Columns
        </button>
        <button class="btn btn-primary" id="createEntityBtn">
          <i class="bi bi-plus"></i> New <%= typeSingular %>
        </button>
      </div>
    </div>
  </div>

  <!-- Main Content Area -->
  <div class="d-flex flex-grow-1 overflow-hidden">
    <!-- Left Pane: Folder Tree (if hierarchy supported) -->
    <% if (supportsHierarchy) { %>
    <div class="border-end" style="width: 250px; overflow-y: auto; padding: 15px;">
      <div class="mb-3">
        <h6 class="mb-2">Folders</h6>
        <button class="btn btn-sm btn-outline-secondary w-100 mb-2" id="newFolderBtn">
          <i class="bi bi-folder-plus"></i> New Folder
        </button>
      </div>
      <div id="folderTree" class="tree-view">
        <!-- Root items and folders will be rendered here -->
      </div>
    </div>
    <% } %>

    <!-- Middle Pane: Data Grid -->
    <div class="flex-grow-1 d-flex flex-column overflow-hidden">
      <!-- Filter Bar -->
      <div class="border-bottom p-2 bg-white" style="min-height: 40px;">
        <div class="d-flex gap-2 align-items-center" id="filterBar">
          <input type="text" class="form-control form-control-sm" id="searchInput" placeholder="Search..." style="max-width: 200px;">
          <!-- Additional filter inputs will be added dynamically -->
        </div>
      </div>

      <!-- Data Grid -->
      <div class="flex-grow-1 overflow-auto">
        <table class="table table-sm table-hover mb-0" id="entityTable">
          <thead class="sticky-top bg-white">
            <tr id="tableHeader">
              <!-- Headers will be generated from field definitions -->
            </tr>
          </thead>
          <tbody id="entityTableBody">
            <tr><td colspan="100%" class="text-center text-muted p-4">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Right Pane: Detail Editor -->
    <div class="border-start" id="detailPane" style="width: 350px; overflow-y: auto; padding: 15px; display: none;">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0">Details</h6>
        <button class="btn btn-sm btn-outline-secondary" id="closeDetailBtn">
          <i class="bi bi-x"></i>
        </button>
      </div>
      <form id="entityForm">
        <!-- Fields will be rendered here -->
      </form>
      <div class="d-flex gap-2 mt-3">
        <button class="btn btn-sm btn-primary" id="saveEntityBtn">Save</button>
        <button class="btn btn-sm btn-outline-danger" id="deleteEntityBtn">Delete</button>
      </div>
    </div>
  </div>
</div>

<!-- Column Visibility Modal -->
<div class="modal fade" id="columnModal" tabindex="-1">
  <div class="modal-dialog modal-sm">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Visible Columns</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="columnCheckboxes" style="max-height: 400px; overflow-y: auto;">
        <!-- Checkboxes for column visibility will be added here -->
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<style>
  #genericEntityContainer {
    background: #fff;
  }

  .tree-view .tree-item {
    padding: 6px 0;
    cursor: pointer;
    font-size: 0.9rem;
  }

  .tree-view .tree-item:hover {
    background: #f0f0f0;
    padding-left: 4px;
  }

  .tree-view .tree-item.active {
    background: #e7f3ff;
    color: #0066cc;
  }

  .tree-view .tree-item-toggle {
    display: inline-block;
    width: 16px;
    cursor: pointer;
  }

  #entityTable th {
    user-select: none;
    cursor: pointer;
    font-weight: 600;
  }

  #entityTable th:hover {
    background: #f5f5f5;
  }

  #entityTable tbody tr {
    cursor: pointer;
  }

  #entityTable tbody tr:hover {
    background: #f9f9f9;
  }

  #entityForm .form-group {
    margin-bottom: 1rem;
  }

  .column-sort-indicator {
    font-size: 0.8rem;
    margin-left: 4px;
    opacity: 0.6;
  }
</style>

<script>
  // Initialize generic entity page - controller will be in genericEntity.js
  window.genericEntityTypeSlug = '<%= typeSlug %>';
  window.genericEntityTypeName = '<%= typeName %>';
  window.genericEntitySupportsHierarchy = <%= supportsHierarchy %>;
  window.genericEntityTypeFields = <%- JSON.stringify(typeFields) %>;
</script>
