# Application
NODE_ENV=development
APP_PORT=3000
APP_NAME=MyWork

# Database
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mywork
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT=30000

# Session
SESSION_SECRET=your-secret-key-change-in-production
SESSION_TIMEOUT=1800000

# CSRF
CSRF_ENABLED=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=2000

# Export
EXPORT_MAX_RECORDS=10000
EXPORT_TEMP_DIR=./tmp/exports
PDF_LOGO_PATH=./public/images/logo.png

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# Security
CORS_ENABLED=false
HELMET_ENABLED=true

# Key used to encrypt stored database connection credentials (Settings > Database
# Configuration) at rest. Must be a 64-character hex string (32 bytes). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONFIG_ENCRYPTION_KEY=
